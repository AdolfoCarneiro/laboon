class CoisaRuim(ComCanhao, Cena):
    """Meia-noite no estádio do Galo: a torcida de capuz faz o ritual e invoca o Coisa Ruim (o Maumau, de chifre
    e olho em brasa), que sobe do pentagrama em T-pose, ainda sem textura. Pedem uma taça; ele faz o feitiço e
    sai medalha de prata, frango assado, camisa do Cruzeiro, boleto da dívida... até o Clawd chegar com o balde
    de água benta."""
    combinavel = False
    peso = 0.8
    duracao = (55, 75)
    NOME = "COISA RUIM"
    REZA = ["Ó Coisa Ruim...", "Traz uma taça pra nós!", "Qualquer uma!", "Pelo amor de Deus, uma taça!"]
    SURGE = ["QUEM OUSA INVOCAR O COISA RUIM?", "O BARBA RUIVA CHEGOU!", "QUEM ME CHAMOU?"]
    PEDIDO = ["Queremos um título!", "Uma taça, por favor!", "Só uma tacinha!"]
    FEITICO = ["ABRACADABRA!", "Sai, taça!", "Taça, apareça!", "Pelos poderes da barba ruiva!"]
    OBJETOS = [("MEDALHA", "uma MEDALHA DE PRATA."), ("FRANGO", "um FRANGO ASSADO."),
               ("CAMISA_CRUZ", "uma camisa do CRUZEIRO."), ("BOLETO", "o BOLETO da dívida.")]
    CHORO = ["De novo?!", "Ah não...", "Era pra ser uma taça!", "Pede de novo!", "Isso aí é nosso mesmo."]
    DESCULPA = ["Peraí, essa não valeu.", "Calma, tô aquecendo.", "Deve ser o VAR.", "Deixa eu tentar de novo."]
    CLAWD_FALA = ["Volta pro inferno, Coisa Ruim!", "Água benta do Emirates!", "Up the Arsenal!"]
    FOGE = ["É O CLAWD!", "Corre!", "Sujou!"]

    def iniciar(self):
        w, h = self.w, self.h
        ph = self.ph = 2 * h
        self.k = max(0.6, min(w / 174, ph / 98))
        self.c = self.k
        self.sc = max(1, round(self.k))
        self.sg = max(1, round(self.k))
        self.campo = int(ph * 0.6)
        self.cx = w * 0.5
        self.pe = self.campo + (ph - self.campo) * 0.45   # o centro do pentagrama, onde ficam os pés
        self.rx, self.ry = min(w * 0.2, 46 * self.k), min(w * 0.2, 46 * self.k) * 0.24
        self.Rm = 7.0 * self.k
        self.cache = {}
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * ph)
        self.t = self.dt = 0.0
        self.parts = []
        self.falas = {}
        self.caixa = None
        self.onomato = []
        self.faixa = None
        self.festa_ate = -10.0
        self.placar = 0
        self.brasa = 0.0         # o quanto o pentagrama está aceso
        self.flash = -10.0
        self.mau = None          # dict(sobe, textura, cara, bracos, brilho, glitch)
        self.objetos = []        # (arte, cores, x)
        self.cult = []
        for i, (fx, fy) in enumerate(((-1.25, 0.1), (-0.8, -1.1), (0.8, -1.1), (1.25, 0.1))):
            self.cult.append(dict(x=self.cx + fx * self.rx, y=self.pe + fy * self.ry * 1.6, casa=self.cx + fx * self.rx,
                                  fase=i * 1.3, maos=0.0, lado=-1 if fx < 0 else 1))
        self.clawd = None        # dict(x, passo, balde)
        self.gen = self.roteiro()

    # --- cenário

    def montar_fundo(self):
        w, ph, campo = self.w, self.ph, self.campo
        px = [0] * (w * ph)
        topo_arq = int(campo - ph * 0.2)
        for y in range(campo):
            base = misturar(0x05060E, 0x1A1C34, y / campo)
            for x in range(w):
                px[y * w + x] = base
        lx, ly, lr = w * 0.82, ph * 0.13, max(3.0, ph * 0.07)
        for y in range(int(ly - lr * 2), int(ly + lr * 2) + 1):
            for x in range(int(lx - lr * 2), int(lx + lr * 2) + 1):
                if 0 <= x < w and 0 <= y < campo:
                    d = math.hypot(x - lx, y - ly)
                    i = y * w + x
                    if d <= lr:
                        px[i] = 0xC8C4B0 if math.sin(x * 0.9) + math.sin(y * 1.3) > 1.2 else 0xEEEAD8
                    elif d <= lr * 2:
                        px[i] = misturar(px[i], 0x3A3C50, 0.6 * (1 - (d - lr) / lr))
        self.estrelas = [(random.randrange(w), random.randrange(max(1, topo_arq - 2)), random.uniform(0, 6))
                         for _ in range(w * ph // 160)]
        # a arquibancada alvinegra, vazia, e as torres de refletor
        for x in range(w):
            curva = topo_arq + abs(x - w / 2) / (w / 2) * ph * 0.04
            for y in range(int(curva), campo):
                fila = (y - int(curva)) % 3
                px[y * w + x] = 0x0C0C10 if fila == 0 else (0x2A2A30 if (x // 3) % 2 else 0x5A5A60)
        self.refletores = []
        for tx in (int(w * 0.06), int(w * 0.94)):
            topo = int(topo_arq - ph * 0.16)
            for y in range(topo, campo):
                for xx in (tx, tx + 1):
                    px[y * w + xx] = 0x3A3A44
            self.refletores.append((tx, topo))
        for y in range(campo, ph):
            f = (y - campo) / max(1, ph - campo)
            for x in range(w):
                faixa = int((x - w / 2) / (w * 0.08) * (0.6 + f)) % 2
                px[y * w + x] = escala(0x1E5A2A if faixa else 0x18502A, 0.45 + 0.4 * f)
        return px

    # --- o Coisa Ruim

    def maumau_cr(self, u, v, cara, bracos, brilho, textura):
        c = maumau_em(u, v, cara, bracos, None, True, brilho)
        if c is None or v < textura:
            return c
        return 0xFF00FF if (int((u + 9) * 2.6) + int((v + 9) * 2.6)) % 2 else 0x101010  # sem textura

    def pos_mau(self):
        m = self.mau
        return self.cx, self.pe - 1.78 * self.Rm + (1 - m["sobe"]) * 4.3 * self.Rm

    def falar(self, txt, quem="mau"):
        self.falas[quem] = (txt, self.t)

    # --- roteiro

    def roteiro(self):
        yield from self.esperar(0.5)
        while True:
            yield from self.ritual()
            yield from self.invocar()
            for i in range(random.choice((2, 3, 3))):
                yield from self.feitico(i)
            yield from self.exorcismo()

    def ritual(self):
        self.objetos = []
        ini = self.t
        while self.t - ini < 5.5:
            p = self.t - ini
            self.brasa = clamp(p / 5.0) * 0.8
            for c in self.cult:
                c["maos"] = 0.5 + 0.5 * math.sin(self.t * 3 + c["fase"])
            if int(p / 1.6) != int((p - self.dt) / 1.6):
                c = random.choice(self.cult)
                self.falar(random.choice(self.REZA), id(c))
            yield

    def invocar(self):
        self.flash = self.t
        self.brasa = 1.0
        self.onomato.append(("KABRUM!", self.cx, self.ph * 0.18, self.t, 0xFF4030))
        self.mau = dict(sobe=0.0, textura=-3.0, cara="normal", bracos=(math.pi / 2, math.pi / 2), brilho=False,
                        glitch=True)
        m, ini = self.mau, self.t
        while self.t - ini < 2.6:
            m["sobe"] = suave((self.t - ini) / 2.6)
            for _ in range(2):
                self.parts.append([self.cx + random.uniform(-1, 1) * self.rx * 0.5, self.pe, random.uniform(-6, 6),
                                   random.uniform(-20, -8), random.choice((0x8A2020, 0x5A1414, 0x3A3A3A)), self.t,
                                   random.uniform(1.0, 2.0), "fumaca"])
            yield
        self.falar("CARREGANDO TEXTURAS...", "sistema")
        yield from self.esperar(1.2)
        ini = self.t
        while self.t - ini < 1.6:
            m["textura"] = -2.4 + 4.4 * suave((self.t - ini) / 1.6)
            yield
        m["textura"], m["glitch"], m["brilho"], m["cara"] = 3.0, False, True, "rindo"
        m["bracos"] = (2.7, 2.7)
        self.falar(random.choice(self.SURGE))
        yield from self.esperar(2.6)
        self.falar(random.choice(self.PEDIDO), id(random.choice(self.cult)))
        for c in self.cult:
            c["maos"] = 1.0
        yield from self.esperar(2.2)
        m["cara"], m["bracos"] = "normal", (0.3, 0.3)
        self.falar("Deixa comigo.")
        yield from self.esperar(1.6)

    def feitico(self, i):
        m = self.mau
        m["bracos"], m["cara"] = (2.8, 2.8), "rindo"
        self.falar(random.choice(self.FEITICO))
        ini = self.t
        while self.t - ini < 1.6:
            mx, my = self.pos_mau()
            for s in (-1, 1):
                hx = mx + s * (0.56 + 1.06 * math.sin(2.8)) * self.Rm
                hy = my + (-0.66 + 1.06 * math.cos(2.8)) * self.Rm
                self.parts.append([hx, hy, random.uniform(-10, 10), random.uniform(-14, 4),
                                   random.choice((0xFF4030, 0xFFB040, 0xFFF0A0)), self.t, random.uniform(0.3, 0.6),
                                   "faisca"])
            yield
        lado = (-1, 1, -1)[i]
        x = self.cx + lado * (0.45 + 0.12 * i) * self.rx + (8 if lado > 0 else -8) * self.k
        nome, frase = self.OBJETOS[(self.ciclo_obj + i) % len(self.OBJETOS)]
        self.onomato.append(("PUF!", x, self.pe - 10 * self.k, self.t, 0xFFFFFF))
        for _ in range(30):
            self.parts.append([x, self.pe - 3 * self.k, random.uniform(-16, 16), random.uniform(-14, 2), 0xC8C8D0,
                               self.t, random.uniform(0.8, 1.4), "fumaca"])
        arte, cores = {"MEDALHA": (MEDALHA, CORES_MEDALHA), "FRANGO": (FRANGO, CORES_FRANGO),
                       "CAMISA_CRUZ": (CAMISA_CRUZ, CORES_CRUZ), "BOLETO": (BOLETO, CORES_BOLETO)}[nome]
        self.objetos.append((arte, cores, x))
        m["bracos"], m["cara"] = (0.3, 0.3), "assustado"
        l1 = f"{self.NOME} usou INVOCAR TAÇA!"
        self.caixa = [l1, f"Saiu {frase}", self.t]
        yield from self.esperar(2.8)
        self.caixa = None
        for c in self.cult:
            c["maos"] = 0.0
        self.falar(random.choice(self.CHORO), id(random.choice(self.cult)))
        yield from self.esperar(1.6)
        m["cara"] = "bravo"
        self.falar(random.choice(self.DESCULPA))
        yield from self.esperar(2.0)

    def exorcismo(self):
        k, s = self.k, self.sc
        self.clawd = dict(x=-20.0 * s, passo=False, balde=0.0)
        cl = self.clawd
        alvo = self.cx - self.rx * 1.05 - 18 * s
        fugiu = False
        while cl["x"] < alvo:
            cl["x"] = min(alvo, cl["x"] + 16 * k * self.dt)
            cl["passo"] = int(self.t * 6) % 2 == 0
            if not fugiu and cl["x"] > -6 * s:
                self.falar(random.choice(self.FOGE), id(self.cult[0]))
                fugiu = True
            yield
        cl["passo"] = False
        self.falar(random.choice(self.CLAWD_FALA), "clawd")
        yield from self.esperar(1.2)
        ini = self.t
        while self.t - ini < 0.9:  # joga a água benta
            cl["balde"] = suave((self.t - ini) / 0.4)
            bx, by = cl["x"] + 19 * s, self.pe - 8 * s
            mx, my = self.pos_mau()
            T = 0.7
            for _ in range(4):
                vx = (mx - bx) / T + random.uniform(-8, 8)
                vy = (my - by - 0.5 * 90 * T * T) / T + random.uniform(-8, 8)
                self.parts.append([bx, by, vx, vy, random.choice((0x6AB8FF, 0xA8D8FF, 0xFFFFFF)), self.t, T, "agua"])
            yield
        m = self.mau
        m["cara"], m["brilho"], m["bracos"] = "assustado", False, (math.pi / 2, math.pi / 2)
        self.onomato.append(("TSSSSS!", self.cx, self.pe - 5 * self.Rm, self.t, 0xFFFFFF))
        self.falar("AAAAARGH!")
        self.placar += 1
        self.faixa = (f"ARSENAL {self.placar} X 0 COISA RUIM", self.t)
        self.festa_ate = self.t + 4.0
        ini = self.t
        while self.t - ini < 1.4:
            mx, my = self.pos_mau()
            self.parts.append([mx + random.uniform(-1, 1) * self.Rm, my + random.uniform(-2, 1) * self.Rm, 0.0,
                               random.uniform(-16, -8), 0xF0F0F0, self.t, 1.2, "fumaca"])
            m["textura"] = 1.8 - 4.2 * suave((self.t - ini) / 1.4)
            yield
        m["glitch"] = True
        ini = self.t
        while self.t - ini < 2.0:
            m["sobe"] = 1 - suave((self.t - ini) / 2.0)
            self.brasa = 1 - suave((self.t - ini) / 2.0)
            yield
        self.mau = None
        cl["balde"] = 0.0
        self.falar("Gooooner!", "clawd")
        yield from self.esperar(1.5)
        while cl["x"] < self.w + 2:  # vai embora e a torcida volta de fininho
            cl["x"] += 16 * k * self.dt
            cl["passo"] = int(self.t * 6) % 2 == 0
            yield
        self.clawd = None
        self.ciclo_obj += 1
        while any(abs(c["x"] - c["casa"]) > 1 for c in self.cult):
            yield
        yield from self.esperar(1.0)

    ciclo_obj = 0

    # --- atualização e desenho

    def atualizar(self, dt):
        cl = self.clawd
        for c in self.cult:
            if cl and cl["x"] > -6 * self.sc:  # foge pro lado de fora
                c["x"] += c["lado"] * self.w * 0.35 * dt
                c["maos"] = 1.0
            elif abs(c["x"] - c["casa"]) > 0.5:
                c["x"] += max(-self.w * 0.12 * dt, min(self.w * 0.12 * dt, c["casa"] - c["x"]))

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        self.atualizar(dt)
        w, h, ph, k = self.w, self.h, self.ph, self.k
        px = self.px
        px[:] = self.fundo
        for x, y, f in self.estrelas:
            if math.sin(t * 2 + f * 7) > -0.3:
                px[y * w + x] = 0x9A9AB8 if math.sin(t * 3 + f) < 0.8 else 0xFFFFFF
        for i, (tx, ty) in enumerate(self.refletores):  # um refletor pisca, assombrado
            aceso = i == 0 or (self.mau and math.sin(t * 23) > 0.2) or math.sin(t * 0.7) > 0.95
            for dx in range(-2, 4):
                for dy in range(-1, 2):
                    if 0 <= tx + dx < w:
                        px[(ty + dy) * w + tx + dx] = 0xFFF4C0 if aceso else 0x4A4A40
        self.desenhar_pentagrama(px)
        cultos = sorted(self.cult, key=lambda c: c["y"])
        for c in cultos:
            if c["y"] < self.pe:
                self.desenhar_cultista(px, c)
        self.desenhar_mau(px)
        for arte, cores, x in self.objetos:
            s = self.sg
            for (xx, yy), cc in arte_pixels(arte, int(x - len(arte[0]) * s / 2), int(self.pe + 2 * k - len(arte) * s), s,
                                            cores).items():
                if 0 <= xx < w and 0 <= yy < ph:
                    px[yy * w + xx] = cc
        for c in cultos:
            if c["y"] >= self.pe:
                self.desenhar_cultista(px, c)
        cl = self.clawd
        if cl:
            s = self.sc
            pulo = int(abs(math.sin(t * 7)) * 4 * s) if t < self.festa_ate else 0
            self.clawd_x, self.clawd_y = int(cl["x"]), int(self.pe + 2 * k - 10 * s - pulo)
            pintar_clawd(px, w, ph, self.clawd_x, self.clawd_y, s, t, cl["passo"])
            self.desenhar_balde(px, cl)
        self.desenhar_parts(px, dt)
        p = t - self.flash
        if p < 0.12 or 0.2 < p < 0.28:
            for i in range(len(px)):
                px[i] = misturar(px[i], 0xFFE8E8, 0.6)
        self.desenhar_letreiros(px)
        pixels_para_celulas(px, w, h, ch, co)
        for quem, (txt, t0) in list(self.falas.items()):
            if t - t0 > 3.0:
                del self.falas[quem]
                continue
            if quem == "mau":
                if not self.mau:
                    continue
                x, y = self.pos_mau()
                y -= 2.5 * self.Rm
            elif quem == "sistema":
                x, y = self.cx, self.campo - 0.30 * self.ph
            elif quem == "clawd":
                if not self.clawd:
                    continue
                x, y = self.clawd_x + 9 * self.sc, self.clawd_y
            else:
                c = next((c for c in self.cult if id(c) == quem), None)
                if c is None:
                    continue
                x, y = c["x"], c["y"] - 13 * k
            balao(ch, co, w, h, int(x), int(y) // 2 - 1, txt, int((t - t0) * 30))
        self.desenhar_caixa(ch, co)
        self.desenhar_plantao(ch, co)

    def desenhar_pentagrama(self, px):
        w, ph, t = self.w, self.ph, self.t
        b = self.brasa
        if b <= 0.01:
            return
        cor = misturar(0x3A1010, 0xFF3020, b * (0.8 + 0.2 * math.sin(t * 9)))
        pts = [(self.cx + math.cos(-math.pi / 2 + i * 2 * math.pi / 5) * self.rx * 0.92,
                self.pe + math.sin(-math.pi / 2 + i * 2 * math.pi / 5) * self.ry * 0.92) for i in range(5)]
        n = int(self.rx * 7)
        for i in range(n):
            a = i / n * 2 * math.pi
            x, y = int(self.cx + math.cos(a) * self.rx), int(self.pe + math.sin(a) * self.ry)
            if 0 <= x < w and 0 <= y < ph:
                px[y * w + x] = cor
        for i in range(5):
            (x0, y0), (x1, y1) = pts[i], pts[(i + 2) % 5]
            m = int(abs(x1 - x0) + abs(y1 - y0)) + 1
            for j in range(m + 1):
                x, y = int(x0 + (x1 - x0) * j / m), int(y0 + (y1 - y0) * j / m)
                if 0 <= x < w and 0 <= y < ph:
                    px[y * w + x] = cor
        for x, y in pts:  # velas nas pontas
            x, y = int(x), int(y)
            for dy in range(3):
                if 0 <= y - dy < ph:
                    px[(y - dy) * w + x] = 0xE8E0C8
            if 0 <= y - 3 < ph:
                px[(y - 3) * w + x] = 0xFFE070 if math.sin(t * 13 + x) > -0.5 else 0xFF8030
                if y - 4 >= 0 and math.sin(t * 7 + x) > 0:
                    px[(y - 4) * w + x] = 0xFF8030

    def desenhar_cultista(self, px, c):
        """Torcedor de capuz alvinegro, com os olhinhos brilhando lá dentro."""
        w, ph, k, t = self.w, self.ph, self.k, self.t
        H = 12 * k
        x0, y0 = c["x"], c["y"]
        for yy in range(int(y0 - H), int(y0) + 1):
            q = (yy - (y0 - H)) / H
            larg = 1.6 * k + q * 3.2 * k if q > 0.32 else 1.8 * k * math.sqrt(max(0.0, q / 0.32))
            balanco = math.sin(t * 2 + c["fase"]) * 0.6 * q
            for xx in range(int(x0 - larg + balanco), int(x0 + larg + balanco) + 1):
                if 0 <= xx < w and 0 <= yy < ph:
                    if q <= 0.32:
                        cor = 0x101012
                        if 0.16 < q < 0.26 and abs(abs(xx - x0) - 0.7 * k) < 0.6:
                            cor = 0xFFD040 if self.mau else 0xC03020
                    else:
                        cor = CAM_BRANCO if int((xx - x0 + 20) / max(1.0, 1.2 * k)) % 2 else CAM_PRETO
                        cor = escala(cor, 0.55 + 0.25 * q)
                    px[yy * w + xx] = cor
        for s in (-1, 1):  # braços pra cima ou pra baixo
            ang = 0.4 + 2.3 * c["maos"]
            for kk in range(int(4 * k)):
                xx = int(x0 + s * (2.2 * k + math.sin(ang) * kk))
                yy = int(y0 - H * 0.62 + math.cos(ang) * kk)
                if 0 <= xx < w and 0 <= yy < ph:
                    px[yy * w + xx] = 0x2A2A2E if kk < 3 * k else PELE_MAU

    def desenhar_mau(self, px):
        m = self.mau
        if not m:
            return
        w, ph, R = self.w, self.ph, self.Rm
        x, y = self.pos_mau()
        tex = round(m["textura"], 1)
        chave = ("cr", m["cara"], m["bracos"], m["brilho"], tex)
        antes = px[:] if m["sobe"] < 1 else None
        pintar_forma(px, w, ph, self.cache, chave,
                     lambda u, v: self.maumau_cr(u, v, m["cara"], m["bracos"], m["brilho"], tex), x, y, R)
        x0, x1 = max(0, int(x - 1.9 * R)), min(w, int(x + 1.9 * R) + 1)
        if antes:  # o que ainda está debaixo da terra não aparece
            for yy in range(int(self.pe) + 1, min(ph, int(y + 1.9 * R) + 1)):
                px[yy * w + x0:yy * w + x1] = antes[yy * w + x0:yy * w + x1]
        if m["glitch"] and random.random() < 0.6:  # faixas tortas, de jogo bugado
            for _ in range(2):
                yy = random.randint(int(y - 2.4 * R), int(y + 1.8 * R))
                d = random.choice((-3, -2, 2, 3))
                for linha in range(yy, min(ph, yy + random.randint(1, 3))):
                    if 0 <= linha:
                        seg = px[linha * w + x0:linha * w + x1]
                        px[linha * w + x0:linha * w + x1] = seg[-d:] + seg[:-d]

    def desenhar_balde(self, px, cl):
        w, ph, s = self.w, self.ph, self.sc
        b = cl["balde"]
        bx, by = cl["x"] + 16 * s, self.pe + 2 * self.k - 7 * s
        for yy in range(int(4 * s)):
            for xx in range(int(5 * s)):
                lx, ly = xx - 2.5 * s, yy - 2 * s
                rx = lx * math.cos(b) - ly * math.sin(b)
                ry = lx * math.sin(b) + ly * math.cos(b)
                X, Y = int(bx + rx), int(by + ry)
                if 0 <= X < w and 0 <= Y < ph:
                    px[Y * w + X] = 0x6AB8FF if yy == 0 and b < 0.3 else (0x9AA0A8 if xx % 3 else 0x7A8088)

    def manchetes(self):
        n = self.placar
        m = ["Torcida do Galo faz ritual no meio do campo; pentagrama fica pior que o gramado",
             "Coisa Ruim promete taça, entrega medalha de prata",
             "Padre se recusa a benzer o estádio: 'não tem reza que resolva'",
             "Boleto da dívida aparece no meio do campo; ninguém quer pagar",
             "Cruzeiro manda abraço", "Coisa Ruim é eleito o melhor reforço da temporada"]
        if n:
            m.insert(1, f"Coisa Ruim volta pro inferno pela {n}ª vez")
        return m


