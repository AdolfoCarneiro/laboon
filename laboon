            if 0 <= x < w and self.gT <= y <= self.gB:
                px[y * w + x] = c

        def linha(x0, y0, x1, y1):
            n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
            for k in range(n + 1):
                ponto(x0 + (x1 - x0) * k / n, y0 + (y1 - y0) * k / n)

        def arco(cx, cy, r, fora=None):
            n = int(r * 8) + 12
            for k in range(n):
                x, y = cx + r * math.cos(2 * math.pi * k / n), cy + r * math.sin(2 * math.pi * k / n)
                if fora is None or fora(x, y):
                    ponto(x, y)

        linha(L, T, R, T)
        linha(L, B, R, B)
        linha(L, T, L, B)
        linha(R, T, R, B)
        linha(MX, T, MX, B)
        arco(MX, MY, 9.15 * sy)
        marca = misturar(branco, 0x37913B, 0.45)
        ponto(MX - 1, MY, marca)
        ponto(MX + 1, MY, marca)
        for lado in (-1, 1):
            gx = L if lado < 0 else R
            den = -lado  # pra dentro do campo
            for prof, meia in ((16.5 * sx, 20.16 * sy), (5.5 * sx, 9.16 * sy)):
                x2 = gx + den * prof
                linha(gx, MY - meia, x2, MY - meia)
                linha(gx, MY + meia, x2, MY + meia)
                linha(x2, MY - meia, x2, MY + meia)
            pen = gx + den * 11 * sx
            ponto(pen, MY, marca)
            borda = gx + den * 16.5 * sx
            arco(pen, MY, 9.15 * sy, fora=lambda x, y, b=borda, d=den: (x - b) * d > 0.5)
            for cy in (T, B):
                arco(gx, cy, max(1.6, sy), fora=lambda x, y, g=gx, d=den, c=cy: (x - g) * d > 0.4 and T < y < B)
                ponto(gx, cy - (2 if cy == T else -2), 0xFFD84A)
            # gol: rede quadriculada atrás da linha, traves brancas
            fundo_gol = gx - den * (3 * e + 1)
            for y in range(MY - self.gm, MY + self.gm + 1):
                for x in range(min(gx, fundo_gol), max(gx, fundo_gol) + 1):
                    if x != gx:
                        ponto(x, y, 0xA8B4A8 if (x + y) % 2 else escala(px[y * w + x], 0.6))
            linha(gx, MY - self.gm, fundo_gol, MY - self.gm)
            linha(gx, MY + self.gm, fundo_gol, MY + self.gm)
            linha(fundo_gol, MY - self.gm, fundo_gol, MY + self.gm)
            for y in range(MY - self.gm, MY + self.gm + 1):
                ponto(gx, y, 0xFFFFFF)
        return px

    def campo(self, time, fx, fy):
        if time == 0:
            return self.L + fx * self.CW, self.T + fy * self.CH
        return self.R - fx * self.CW, self.B - fy * self.CH

    def dentro(self, x, y):
        return max(self.L + 1.0, min(self.R - 1.0, x)), max(self.T + 1.0, min(self.B - 1.0, y))

    def prog(self, j):
        return (j.x - self.L) / self.CW if j.time == 0 else (self.R - j.x) / self.CW

    def minuto(self):
        return self.min0 + self.t * 1.2

    def narrar(self, txt, cor=0xE0E0E0, fraca=False):
        """fraca: lance corriqueiro (passe, condução), que não atropela uma frase que acabou de entrar."""
        if fraca and self.t - self.narra_t < 1.2:
            return
        self.narra, self.narra_t, self.narra_cor = txt, self.t, cor

    # --- quem vai pra onde

    def alvo(self, j):
        if j.fixo:
            return j.fixo
        e = self.e
        if j.time == 2:  # o juiz acompanha o lance de longe
            return self.dentro(self.bx - 16 * e, self.by + (11 if self.by < self.MY else -11) * e)
        p = (self.bx - self.L) / self.CW if j.time == 0 else (self.R - self.bx) / self.CW
        k = clamp((p - 0.12) / 0.72 + (0.1 if self.posse == j.time else -0.08))
        xd, xa, fy = j.f
        fx = xd + (xa - xd) * k
        byn = (self.by - self.T) / self.CH
        if j.time == 1:
            byn = 1 - byn
        if j.papel == "GOL":
            fy = 0.5 + (byn - 0.5) * 0.1
        else:
            fy += (byn - 0.5) * 0.3
        if self.saida is not None:
            fx = min(fx, 0.45)
        return self.campo(j.time, fx, fy)

    def mover(self, dt):
        alvos = {j: self.alvo(j) for j in self.todos}
        d, e = self.dono, self.e
        if d and d.time != 2 and self.saida is None and self.fim is None:
            marcam = [j for j in self.times[1 - d.time] if j.papel != "GOL" and not j.fixo and self.t >= j.chao]
            marcam.sort(key=lambda j: (j.x - d.x) ** 2 + (j.y - d.y) ** 2)
            lado = 1 if d.time == 0 else -1
            if marcam:
                alvos[marcam[0]] = (d.x + lado * 4 * e, d.y + (e if marcam[0].y > d.y else -e))
            if len(marcam) > 1:
                ax, ay = alvos[marcam[1]]
                alvos[marcam[1]] = ((ax + d.x) / 2, (ay + d.y) / 2)
        for j in self.todos:
            if self.t < j.chao:
                j.dx = 0.0
                continue
            tx, ty = alvos[j]
            tx, ty = max(2.0, min(self.w - 3.0, tx)), max(self.gT + 4.0 * e, min(float(self.gB), ty))
            dx, dy = tx - j.x, ty - j.y
            dist = math.hypot(dx, dy)
            passo = self.v * j.veloz * dt
            if dist <= passo:
                j.x, j.y, j.dx = tx, ty, dist
            else:
                j.x += dx / dist * passo
                j.y += dy / dist * passo
                j.dx = passo

    def mover_bola(self, dt):
        if self.voo:
            x0, y0, z0, x1, y1, z1, t0, dur, alt = self.voo
            s = (self.t - t0) / dur
            if s >= 1:
                self.bx, self.by, self.bz, self.voo = x1, y1, z1, None
            else:
                self.bx, self.by = x0 + (x1 - x0) * s, y0 + (y1 - y0) * s
                self.bz = z0 + (z1 - z0) * s + alt * math.sin(s * math.pi)
        elif self.dono:
            d = self.dono
            lado = 1 if d.time == 0 else -1
            if self.maos:
                tx, ty, self.bz = d.x + lado * self.e, d.y - 2 * self.e, 0.0
            else:
                tx, ty, self.bz = d.x + lado * 2 * self.e, d.y, 0.0
            k = min(1.0, dt * 18)
            self.bx += (tx - self.bx) * k
            self.by += (ty - self.by) * k

    # --- lances (geradores: cada yield é um quadro)

    def voar(self, x1, y1, dur, alt=0.0, z1=0.0):
        self.dono, self.maos = None, False
        self.voo = (self.bx, self.by, self.bz, x1, y1, z1, self.t, max(0.05, dur), alt)
        while self.voo:
            yield

    def chutar(self, x1, y1, alt=0.0, z1=0.0):
        d = math.hypot(x1 - self.bx, y1 - self.by)
        yield from self.voar(x1, y1, 0.06 + d / self.v_chute, alt, z1)

    def passar(self, de, para, alto=False, txt=None, cor=0xE0E0E0):
        lado = 1 if para.time == 0 else -1
        tx, ty = self.dentro(para.x + lado * random.uniform(1, 5) * self.e, para.y + random.uniform(-2, 2) * self.e)
        d = math.hypot(tx - self.bx, ty - self.by)
        para.fixo, para.veloz = (tx, ty), 1.5
        self.posse = para.time
        if txt:
            self.narrar(txt, cor, fraca=True)
        yield from self.voar(tx, ty, 0.15 + d / self.v_passe, d * 0.22 if alto else 0.0)
        para.fixo, para.veloz = None, 1.0
        self.dono = para

    def conduzir(self, j, dist, dy=0.0, dur=1.6, drible=False, falar=True):
        lado = 1 if j.time == 0 else -1
        tx, ty = self.dentro(j.x + lado * dist, j.y + dy)
        j.fixo, j.veloz = (tx, ty), 1.1
        if falar and j.time == 0:
            self.narrar(random.choice(self.CONDUZ).format(a=j.nome), fraca=True)
        ini = self.t
        while self.t - ini < dur and math.hypot(j.x - tx, j.y - ty) > 0.6:
            yield
        j.fixo, j.veloz = None, 1.0
        if drible:
            perto = [r for r in self.times[1 - j.time] if r.papel != "GOL" and self.t >= r.chao]
            if perto:
                r = min(perto, key=lambda r: math.hypot(r.x - j.x, r.y - j.y))
                if math.hypot(r.x - j.x, r.y - j.y) < 9 * self.e:
                    r.chao = self.t + 1.4
                    if j.time == 0:
                        self.narrar(random.choice(self.DRIBLE).format(a=j.nome))

    def escolher(self, j, minimo):
        cands = []
        for p in self.times[j.time]:
            if p is j or p.papel == "GOL" or self.t < p.chao:
                continue
            d = math.hypot(p.x - j.x, p.y - j.y)
            av = self.prog(p) - self.prog(j)
            if 10 * self.e <= d <= self.CW * 0.5 and av >= minimo:
                cands.append((av + random.uniform(0, 0.25), p))
        if not cands:
            cands = [(random.random(), p) for p in self.times[j.time] if p is not j and p.papel != "GOL"]
        return max(cands, key=lambda c: c[0])[1]

    def esperar_chegar(self, j, limite):
        ini = self.t
        while j.fixo and self.t - ini < limite and math.hypot(j.x - j.fixo[0], j.y - j.fixo[1]) > 0.8:
            yield

    def roteiro(self):
        yield from self.saida_de_bola(0)
        posse = 0
        while True:
            if self.minuto() >= 90 + self.acrescimo:
                yield from self.apito_final()
            if posse == 0:
                posse = yield from self.ataque_arsenal()
            else:
                posse = yield from self.ataque_rival()

    def saida_de_bola(self, time):
        self.voo, self.dono, self.maos, self.visivel = None, None, False, True
        self.bx, self.by, self.bz = float(self.MX), float(self.MY), 0.0
        self.saida = self.posse = time
        lado = 1 if time == 0 else -1
        meus = self.times[time]
        cob = min((j for j in meus if j.papel == "ATA"), key=lambda j: abs(j.f[2] - 0.5))
        cob.fixo = (self.MX - lado * 2 * self.e, float(self.MY))
        for j in self.todos:
            j.veloz = 2.4
        ini = self.t
        while self.t - ini < 2.6 and any(math.hypot(j.x - a[0], j.y - a[1]) > 2 * self.e
                                       for j in self.todos[:-1] for a in (self.alvo(j),)):
            yield
        for j in self.todos:
            j.veloz = 1.0
        yield from self.esperar(0.3)
        if time == 0:
            self.narrar(random.choice(self.SAIDA))
        else:
            self.narrar(f"Saída para {self.rival['o']}.", 0x9A9A9A)
        self.dono, cob.fixo, self.saida = cob, None, None
        meia = random.choice([j for j in meus if j.papel in ("VOL", "MEI")])
        yield from self.passar(cob, meia)

    def ataque_arsenal(self):
        e = self.e
        for k in range(random.randint(2, 4)):
            j = self.dono
            if random.random() < 0.5:
                yield from self.conduzir(j, random.uniform(5, 14) * e, random.uniform(-4, 4) * e,
                                         drible=random.random() < 0.3)
            alvo = self.escolher(j, -0.04 + k * 0.04)
            yield from self.passar(j, alvo, random.random() < 0.15, random.choice(self.PASSE).format(a=j.nome, b=alvo.nome))
        j = self.dono
        if self.prog(j) < 0.62:
            frente = [p for p in self.times[0] if p.papel in ("ATA", "MEI") and p is not j]
            alvo = max(frente, key=lambda p: self.prog(p) + random.uniform(0, 0.2))
            yield from self.passar(j, alvo, random.random() < 0.3, random.choice(self.ENFIA).format(a=j.nome, b=alvo.nome))
            j = alvo
        borda = self.R - self.CW * random.uniform(0.12, 0.22)
        if j.x < borda - 2:
            yield from self.conduzir(j, borda - j.x, (self.MY - j.y) * 0.5, dur=2.2, drible=random.random() < 0.5)
        return (yield from self.finalizar(j))

    def finalizar(self, j):
        e = self.e
        gk = self.times[1][0]
        canto = random.choice((-1, 1))
        res = random.choices(("gol", "defesa", "trave", "escanteio", "fora"), (0.34, 0.22, 0.14, 0.18, 0.12))[0]
        if self.marcados == 0 and self.t > 24:
            res = "gol"  # a cena não acaba sem gol do Arsenal
        self.narrar(random.choice(self.CHUTE).format(a=j.nome))
        alt = random.choice((0.0, 0.0, 2.0 * e))
        if res == "gol":
            gy = self.MY + canto * (self.gm - 1.5 * e)
            gk.fixo, gk.veloz = (gk.x, self.MY - canto * self.gm), 2.2
            yield from self.chutar(self.R + 2 * e, gy, alt)
            gk.chao = self.t + 1.5
            self.rede = (1, gy, self.t)
            return (yield from self.comemorar(j))
        if res == "defesa":
            gy = self.MY + canto * random.uniform(0, self.gm - 1.5 * e)
            gk.fixo, gk.veloz = (self.R - 1.5 * e, gy), 4.0
            yield from self.chutar(self.R - 2 * e, gy, alt)
            gk.fixo = None
            self.dono, self.maos, self.posse = gk, True, 1
            self.narrar(random.choice(("Defendeu o goleiro d{}.", "Que defesa do goleiro d{}!")).format(self.rival["o"]),
                        0x9A9A9A)
            yield from self.esperar(1.2)
            self.maos = False
            lat = random.choice([p for p in self.times[1] if p.papel in ("LD", "LE", "ZAG")])
            yield from self.passar(gk, lat)
            return 1
        if res == "trave":
            gk.fixo, gk.veloz = (gk.x, self.MY - canto * self.gm * 0.5), 2.0
            yield from self.chutar(self.R, self.MY + canto * self.gm, alt)
            self.trave = self.t
            self.narrar(random.choice(("NA TRAVE!", "Carimbou o travessão!", "NO POSTE!")), 0xFFD84A)
            gk.fixo = None
            rx, ry = self.R - self.CW * random.uniform(0.07, 0.15), self.MY + random.uniform(-0.18, 0.18) * self.CH
            cands = [p for p in self.times[0] if p.papel in ("ATA", "MEI") and p is not j] or [j]
            atac = min(cands, key=lambda p: math.hypot(p.x - rx, p.y - ry))
            zag = min((p for p in self.times[1] if p.papel == "ZAG"), key=lambda p: math.hypot(p.x - rx, p.y - ry))
            atac.fixo, atac.veloz = (rx, ry), 1.9
            zag.fixo, zag.veloz = (rx + 3 * e, ry + e), 1.3
            yield from self.voar(rx, ry, 0.55, 3 * e)
            atac.fixo = zag.fixo = None
            atac.veloz = zag.veloz = 1.0
            if random.random() < 0.5:
                self.dono = atac
                self.narrar(f"No rebote, {atac.nome}...", 0xFFFFFF)
                yield from self.esperar(0.15)
                gy = self.MY + random.uniform(-1, 1) * (self.gm - 1.5 * e)
                gk.fixo, gk.veloz = (gk.x, 2 * self.MY - gy), 2.0
                yield from self.chutar(self.R + 2 * e, gy)
                gk.chao = self.t + 1.4
                self.rede = (1, gy, self.t)
                return (yield from self.comemorar(atac))
            self.dono, self.posse = zag, 1
            self.narrar("O zagueiro afasta o perigo.", 0x9A9A9A)
            alvo = random.choice([p for p in self.times[1] if p.papel in ("MEI", "ATA")])
            yield from self.passar(zag, alvo, True)
            return 1
        if res == "fora":
            yield from self.chutar(self.R + 2 * e, self.MY + canto * (self.gm + random.uniform(2, 7) * e), alt)
            self.visivel = False
            self.narrar(random.choice(("Pra fora! Tirou tinta da trave.", "Passou raspando!", "Uuuh! Por pouco!")),
                        0xFFD84A)
            yield from self.esperar(1.2)
            return (yield from self.tiro_de_meta(1))
        gy = self.MY + canto * (self.gm - 1.5 * e)
        gk.fixo, gk.veloz = (self.R - 1.5 * e, gy), 4.0
        yield from self.chutar(self.R - 2 * e, gy, alt)
        gk.chao = self.t + 1.0
        self.narrar("Espalmou pra escanteio!", 0x9A9A9A)
        yield from self.voar(self.R + 3 * e, gy + canto * 3 * e, 0.4, 3 * e)
        gk.fixo = None
        return (yield from self.escanteio(canto))

    def escanteio(self, canto):
        e = self.e
        ars, riv = self.times
        fy = self.T if canto < 0 else self.B
        nomes = ("Henry", "Pires") if self.invenciveis else ("Rice", "Saka", "Ødegaard")
        bat = random.choice([p for p in ars if p.nome in nomes])
        cab = next(p for p in ars if p.nome in ("Campbell", "Gabriel"))
        area = [p for p in ars if p.papel in ("ZAG", "ATA", "VOL") and p is not bat and p is not cab]
        marc = [p for p in riv if p.papel != "GOL"]
        random.shuffle(marc)
        for k, p in enumerate([cab] + area):
            if p is cab:
                p.fixo = (self.R - self.CW * 0.075, self.MY + random.uniform(-0.1, 0.1) * self.CH)
            else:
                p.fixo = (self.R - self.CW * random.uniform(0.04, 0.16), self.MY + random.uniform(-0.22, 0.22) * self.CH)
            p.veloz = 1.6
            if k < len(marc):
                marc[k].fixo, marc[k].veloz = (p.fixo[0] + 2 * e, p.fixo[1] + random.choice((-1, 1)) * e), 1.6
        bat.fixo, bat.veloz = (self.R - 2.0 * e, float(fy)), 2.6
        self.bx, self.by, self.bz, self.visivel, self.posse = self.R - 0.5, float(fy), 0.0, True, 0
        self.narrar(f"Escanteio. {bat.nome} vai para a bola.")
        yield from self.esperar_chegar(bat, 1.8)
        yield from self.esperar_chegar(cab, 0.6)
        self.dono = bat
        yield from self.esperar(0.5)
        self.narrar("Bola parada do Arsenal: perigo!")
        yield from self.voar(cab.x + e, cab.y, 0.95, 9 * e, 4 * e)
        gk = riv[0]
        if random.random() < 0.3:
            gk.fixo, gk.veloz = (cab.x + 2 * e, cab.y), 3.0
            yield from self.esperar_chegar(gk, 0.6)
            self.narrar("O goleiro saiu do gol e ficou com ela.", 0x9A9A9A)
            for p in self.todos:
                p.fixo, p.veloz = None, 1.0
            self.dono, self.maos, self.posse = gk, True, 1
            yield from self.esperar(1.0)
            self.maos = False
            yield from self.passar(gk, random.choice([p for p in riv if p.papel in ("LD", "LE", "VOL")]))
            return 1
        self.narrar(f"{cab.nome} SUBIU MAIS QUE TODO MUNDO!", 0xFFFFFF)
        gy = self.MY + random.uniform(-1, 1) * (self.gm - 1.5 * e)
        gk.fixo, gk.veloz = (gk.x, 2 * self.MY - gy), 1.5
        yield from self.voar(self.R + 2 * e, gy, 0.08 + (self.R - cab.x) / self.v_chute, 0.0, e)
        self.rede = (1, gy, self.t)
        for p in self.todos:
            p.fixo, p.veloz = None, 1.0
        return (yield from self.comemorar(cab, "Mais um gol de bola parada!", "GOOOL! {a} DE CABEÇA!"))

    def comemorar(self, autor, extra=None, frase=None):
        e = self.e
        self.gols[0] += 1
        self.marcados += 1
        self.festa = self.t
        self.posse = 0
        self.narrar((frase or random.choice(self.GOL)).format(a=autor.nome), ARS_VERMELHO)
        cy = self.T + 3 * e if autor.y < self.MY else self.B - 3 * e
        cx = self.R - 3 * e
        autor.fixo, autor.veloz = (cx, cy), 1.4
        for j in self.times[0]:
            if j is not autor and j.papel != "GOL":
                dy = random.uniform(2, 12) * e
                j.fixo, j.veloz = (cx - random.uniform(4, 24) * e, cy + (dy if cy < self.MY else -dy)), 1.3
        for j in self.times[1]:
            j.fixo = (j.x, j.y)
            if j.papel != "GOL" and random.random() < 0.25:
                j.chao = self.t + random.uniform(2, 4)
        for _ in range(110):
            self.confete.append([random.uniform(0, self.w), random.uniform(self.gT - 12, self.gT), random.uniform(-4, 4),
                                 random.uniform(10, 26), random.choice((ARS_VERMELHO, 0xFFFFFF, 0xFFFFFF, ARS_OURO)),
                                 random.uniform(0, 6.3), self.t])
        yield from self.esperar(2.2)
        if extra is None:
            extra = random.choice(self.EXTRAS[self.rival["sigla"]]["gol"] +
                                  (["Isso é o futebol de Wenger!", "Invencíveis!"] if self.invenciveis else []))
        self.narrar(extra, 0xFFFFFF)
        yield from self.esperar(1.6)
        for j in self.todos:
            j.fixo, j.veloz = None, 1.0
        yield from self.saida_de_bola(1)
        return 1

    def ataque_rival(self):
        e = self.e
        cinza = 0x9A9A9A
        o = self.rival["o"]
        if random.random() < 0.6:
            self.narrar(random.choice(self.RIVAL).format(o=o, O=o[0].upper() + o[1:]), cinza)
        for k in range(random.randint(2, 4)):
            j = self.dono
            if j.papel != "GOL" and random.random() < 0.45:
                yield from self.conduzir(j, random.uniform(5, 12) * e, random.uniform(-4, 4) * e, falar=False)
            txt = random.choice(self.RIVAL_PASSE).format(o=o, O=o[0].upper() + o[1:]) if random.random() < 0.5 else None
            yield from self.passar(j, self.escolher(j, -0.02 + 0.04 * k), txt=txt, cor=cinza)
        j = self.dono
        res = random.choices(("desarme", "isolou", "defesa", "var"), (0.36, 0.26, 0.22, 0.0 if self.var_usado else 0.16))[0]
        if res == "desarme":
            return (yield from self.desarme(j))
        borda = self.L + self.CW * random.uniform(0.2, 0.32)
        if j.x > borda + 2:
            yield from self.conduzir(j, j.x - borda, (self.MY - j.y) * 0.4, dur=2.0, falar=False)
        quem = j.nome[0].upper() + j.nome[1:] + " d" + o
        gk = self.times[0][0]
        if res == "isolou":
            self.narrar(f"{quem} arrisca de longe...", cinza)
            yield from self.esperar(0.2)
            yield from self.voar(self.L - 4 * e, self.MY + random.uniform(-0.4, 0.4) * self.CH, 0.9, 0.0, self.CH * 0.8)
            self.visivel = False
            self.narrar(random.choice(self.ISOLOU + self.EXTRAS[self.rival["sigla"]]["isolou"] * 2), 0xFFD84A)
            yield from self.esperar(1.4)
            return (yield from self.tiro_de_meta())
        canto = random.choice((-1, 1))
        self.narrar(f"{quem} bateu...", cinza)
        if res == "defesa":
            gy = self.MY + canto * random.uniform(0, self.gm - 1.5 * e)
            gk.fixo, gk.veloz = (self.L + 1.5 * e, gy), 4.0
            yield from self.chutar(self.L + 2 * e, gy, random.choice((0.0, 2.0 * e)))
            gk.fixo = None
            self.dono, self.maos, self.posse = gk, True, 0
            self.narrar(random.choice(self.DEFESA).format(a=gk.nome))
            yield from self.esperar(1.2)
            self.maos = False
            lat = random.choice([p for p in self.times[0] if p.papel in ("LD", "LE")])
            yield from self.passar(gk, lat)
            return 0
        # "gol" do rival... que o VAR anula
        self.var_usado = True
        gy = self.MY + canto * (self.gm - 1.5 * e)
        gk.fixo, gk.veloz = (gk.x, self.MY - canto * self.gm), 2.0
        yield from self.chutar(self.L - 2 * e, gy)
        gk.chao = self.t + 1.6
        self.rede = (-1, gy, self.t)
        self.narrar(f"Gol d{o}?! Calma...", self.rival["cor"])
        j.fixo, j.veloz = self.dentro(j.x + 10 * e, j.y + random.uniform(-6, 6) * e), 1.4
        yield from self.esperar(1.4)
        ultimo = min(p.x for p in self.times[0] if p.papel != "GOL")
        self.var = [ultimo, ultimo - random.uniform(0.8, 2.2) * e, self.t, None]
        self.narrar("O VAR chama. Checando impedimento...", 0x8AB4FF)
        yield from self.esperar(2.8)
        self.var[3] = self.t
        self.narrar(random.choice(self.ANULADO), 0xFFFFFF)
        yield from self.esperar(2.2)
        self.var = None
        gk.fixo = j.fixo = None
        j.veloz = 1.0
        zag = random.choice([p for p in self.times[0] if p.papel == "ZAG"])
        self.bx, self.by = self.dentro(ultimo, self.MY + random.uniform(-0.25, 0.25) * self.CH)
        self.bz = 0.0
        zag.fixo, zag.veloz = (self.bx - 1.5 * e, self.by), 1.6
        yield from self.esperar_chegar(zag, 2.5)
        zag.fixo, zag.veloz = None, 1.0
        self.dono, self.posse = zag, 0
        self.narrar("Tiro livre para o Arsenal.")
        yield from self.esperar(0.5)
        return 0

    def desarme(self, j):
        d = min((p for p in self.times[0] if p.papel != "GOL" and self.t >= p.chao),
                key=lambda p: math.hypot(p.x - j.x, p.y - j.y))
        d.veloz = 1.9
        j.fixo = self.dentro(j.x - 8 * self.e, j.y)
        ini = self.t
        while self.t - ini < 2.5 and math.hypot(d.x - j.x, d.y - j.y) > 2 * self.e:
            d.fixo = (j.x, j.y)
            yield
        d.fixo, d.veloz, j.fixo = None, 1.0, None
        j.chao = self.t + 1.6
        if self.rival["sigla"] == "TOT" and random.random() < 0.3:
            self.narrar(f"{j.nome[0].upper() + j.nome[1:]} do Tottenham caiu sozinho. Típico.")
        else:
            self.narrar(random.choice(self.DESARME).format(a=d.nome))
        self.dono, self.posse = d, 0
        yield from self.esperar(0.3)
        return 0

    def tiro_de_meta(self, time=0):
        gk = self.times[time][0]
        x, y = self.campo(time, 0.045, 0.5 + random.choice((-1, 1)) * 0.08)
        gk.fixo, gk.veloz = (x, y), 1.5
        yield from self.esperar_chegar(gk, 2.0)
        gk.fixo, gk.veloz = None, 1.0
        self.bx, self.by, self.bz, self.visivel = x + (2 if time == 0 else -2) * self.e, y, 0.0, True
        self.dono, self.posse = gk, time
        if time == 0:
            self.narrar(f"Tiro de meta. {gk.nome} lança.")
        else:
            self.narrar(f"Tiro de meta para {self.rival['o']}.", 0x9A9A9A)
        yield from self.esperar(0.7)
        yield from self.passar(gk, random.choice([p for p in self.times[time] if p.papel in ("ATA", "MEI")]), True)
        return time

    def apito_final(self):
        self.fim = self.t
        self.dono = self.voo = None
        frases = ["Apita o árbitro! Fim de jogo!"] + self.EXTRAS[self.rival["sigla"]]["final"]
        if self.invenciveis:
            frases.append("Invencíveis! 49 jogos sem perder.")
        frases.append(f"Arsenal {self.gols[0]} x {self.gols[1]} {self.rival['nome']}.")
        for j in self.times[0]:
            j.fixo = (self.MX + random.uniform(-0.18, 0.18) * self.CW, self.MY + random.uniform(-0.22, 0.22) * self.CH)
            j.veloz = 1.2
        for j in self.times[1]:
            j.fixo = (j.x, j.y)
            if j.papel != "GOL" and random.random() < 0.5:
                j.chao = 1e9
        k = 0
        while True:
            self.narrar(frases[k % len(frases)], ARS_VERMELHO if k == 0 else 0xFFFFFF)
            k += 1
            ini = self.t
            while self.t - ini < 3.5:
                if random.random() < self.dt * 8:
                    self.confete.append([random.uniform(0, self.w), float(self.gT), random.uniform(-3, 3),
                                         random.uniform(4, 12), random.choice((ARS_VERMELHO, 0xFFFFFF, ARS_OURO)),
                                         random.uniform(0, 6.3), self.t])
                yield

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        self.mover(dt)
        self.mover_bola(dt)
        w, h, e, ph = self.w, self.h, self.e, self.ph
        px = self.px
        px[:] = self.fundo_px
        self.desenhar_rede(px)
        bola = None
        if self.visivel:
            bx, by = int(self.bx), int(self.by)
            if self.bz > 0.6 and self.gT <= by <= self.gB:
                for yy in range(by, by + e):
                    for xx in range(bx, bx + e):
                        if 0 <= xx < w and yy <= self.gB:
                            px[yy * w + xx] = escala(px[yy * w + xx], 0.45)
            bola = (bx, int(self.by - self.bz))
        festa = self.t - self.festa < 4.2 or self.fim is not None
        for j in sorted(self.todos, key=lambda j: j.y):
            self.desenhar_jogador(px, j, festa)
        if bola:
            if self.bz <= 0.6:
                for xx in range(bola[0], bola[0] + e):
                    if 0 <= xx < w and bola[1] + 1 <= self.gB:
                        px[(bola[1] + 1) * w + xx] = escala(px[(bola[1] + 1) * w + xx], 0.4)
            for yy in range(bola[1] - e + 1, bola[1] + 1):
                for xx in range(bola[0], bola[0] + e):
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = 0xFFFFFF
        self.desenhar_confete(px, dt)
        self.desenhar_letreiros(px)
        pixels_para_celulas(px, w, h, ch, co)
        self.desenhar_hud(ch, co)

    def desenhar_rede(self, px):
        if not self.rede or self.t - self.rede[2] > 0.7:
            return
        lado, gy, t0 = self.rede
        w, e = self.w, self.e
        fundo_gol = (self.R + 3 * e + 1) if lado > 0 else (self.L - 3 * e - 1)
        k = 1 + int(2 * e * (1 - (self.t - t0) / 0.7))
        for y in range(int(gy) - 3 * e, int(gy) + 3 * e + 1):
            if self.MY - self.gm < y < self.MY + self.gm:
                for d in range(1, k + 1):
                    x = fundo_gol + lado * d
                    if 0 <= x < w:
                        px[y * w + x] = 0xC8D4C8 if (x + y) % 2 else 0x7A867A

    def desenhar_jogador(self, px, j, festa):
        w, ph, e = self.w, self.ph, self.e
        cores = j.cores
        x0, y0 = int(j.x), int(j.y)
        if self.t < j.chao:
            partes = JOGADOR_CAIDO
        else:
            if festa and j.time == 0 and j.papel != "GOL" and j.dx < 0.05:
                y0 -= int(abs(math.sin(self.t * 9 + j.fase * 6)) * 2.5 * e)
            anda = 1 if j.dx > 0.02 and int(self.t * 9 + j.fase * 2) % 2 else 0
            partes = JOGADOR_PE + JOGADOR_PERNAS[anda]
        for dx, dy, k in partes:
            c = cores[k]
            for yy in range(y0 + dy * e, y0 + dy * e + e):
                if 0 <= yy < ph:
                    b = yy * w
                    for xx in range(x0 + dx * e, x0 + dx * e + e):
                        if 0 <= xx < w:
                            px[b + xx] = c

    def desenhar_confete(self, px, dt):
        w = self.w
        vivos = []
        for c in self.confete:
            c[0] += (c[2] + math.sin(self.t * 4 + c[5]) * 6) * dt
            c[1] += c[3] * dt
            if c[1] < self.gB and self.t - c[6] < 4.5:
                vivos.append(c)
                x, y = int(c[0]), int(c[1])
                if 0 <= x < w and self.gT <= y:
                    px[y * w + x] = c[4]
        self.confete = vivos

    def desenhar_letreiros(self, px):
        w, ph = self.w, self.ph
        t = self.t
        if self.t - self.trave < 0.4:
            gx = self.R
            for y in range(self.MY - self.gm, self.MY + self.gm + 1):
                px[y * w + gx] = 0xFFF2A0
        if self.var:
            ultimo, atac, t0, anulado = self.var
            for y in range(self.T, self.B + 1):
                for x, c in ((int(ultimo), 0x3C8CFF), (int(atac), 0xFF3B3B)):
                    if 0 <= x < w:
                        px[y * w + x] = misturar(px[y * w + x], c, 0.85)
            cx, cy = self.MX, self.T + self.CH * 0.22
            gw, gh = 26 * self.e, 9 * self.e
            for y in range(int(cy - gh / 2), int(cy + gh / 2) + 1):
                for x in range(int(cx - gw / 2), int(cx + gw / 2) + 1):
                    if 0 <= x < w and 0 <= y < ph:
                        px[y * w + x] = misturar(px[y * w + x], 0x0A1020, 0.8)
            letreiro(px, w, ph, "VAR", cx, cy, self.e, 0xFFFFFF if int(t * 3) % 2 else 0x8AB4FF)
            if anulado is not None:
                txt = "GOL ANULADO"
                letreiro(px, w, ph, txt, self.MX, self.MY, esc_letreiro(txt, self.CW * 0.85, 3),
                         0xFFFFFF, ARS_VERMELHO)
        if self.t - self.festa < 3.0:
            txt = "GOOOOL!"
            pisca = int((self.t - self.festa) * 5) % 2
            letreiro(px, w, ph, txt, self.MX, self.MY, esc_letreiro(txt, self.CW * 0.7, 4),
                     0xFFFFFF if pisca else ARS_VERMELHO, ARS_VERMELHO if pisca else 0xFFFFFF)
        if self.fim is not None and self.t - self.fim < 3.5:
            txt = "FIM DE JOGO"
            letreiro(px, w, ph, txt, self.MX, self.MY, esc_letreiro(txt, self.CW * 0.85, 3), 0xFFFFFF, ARS_VERMELHO)

    def desenhar_hud(self, ch, co):
        w, h, t = self.w, self.h, self.t
        r = self.rival
        m = self.minuto()
        if self.fim is not None:
            relogio = "FIM"
        elif m >= 90:
            relogio = f"90+{min(self.acrescimo, int(m - 90) + 1)}'"
        else:
            relogio = f"{int(m):02d}:{int(m % 1 * 60):02d}"
        x = chip(ch, co, w, h, 2, 1, " ARS ", 0xFFFFFF, ARS_VERMELHO)
        x = chip(ch, co, w, h, x, 1, f" {self.gols[0]}-{self.gols[1]} ", 0xFFFFFF, 0x1C1C1C)
        x = chip(ch, co, w, h, x, 1, f" {r['sigla']} ", r["chip"][0], r["chip"][1])
        chip(ch, co, w, h, x + 1, 1, f" {relogio} ", 0xD8D8D8, 0x2E2E2E)
        lugar = "Arsenal 2003/04 · Invencíveis" if self.invenciveis else r["lugar"]
        escrever(ch, co, w, h, w - len(lugar) - 2, 1, lugar, 0x8A8A8A)
        gol = self.t - self.festa < 4.2
        for y, sentido in ((2, 1), (h - 3, -1)):
            if gol:
                txt = " GOOOOL ★ ARSENAL ★"
                off = int(t * 20) * sentido
                fg = 0xFFFFFF if int(t * 6) % 2 else 0xFFD84A
                bg = ARS_VERMELHO
            else:
                txt = self.led
                off = int(t * 9) * sentido
                fg, bg = 0xFF3A3A, 0x1A0303
            for x in range(w):
                s = txt[(x + off) % len(txt)]
                escrever(ch, co, w, h, x, y, NBSP if s == " " else s, fundo(ARS_OURO if s == "★" and not gol else fg, bg))
        if self.narra:
            n = min(len(self.narra), int((t - self.narra_t) * 45) + 1)
            cor_n = self.narra_cor
            if cor_n == ARS_VERMELHO and int(t * 4) % 2:
                cor_n = 0xFFFFFF
            escrever(ch, co, w, h, 2, h - 2, "▸", ARS_VERMELHO)
            escrever(ch, co, w, h, 4, h - 2, self.narra[:n], cor_n)
        d = self.dono
        if d and d.time == 0 and d.papel != "GOL" and self.fim is None and self.t - self.festa > 4.2:
            y = (int(d.y) - 6 * self.e) // 2
            x = int(d.x) - len(d.nome) // 2
            if y * 2 >= self.gT:
                for k, s in enumerate(d.nome):
                    xx = x + k
                    if 0 <= xx < w:
                        escrever(ch, co, w, h, xx, y, s, fundo(0xFFFFFF, self.fundo_px[2 * y * w + xx]))


PELES = [0xF1C9A5, 0xE0AC69, 0xC68642, 0x8D5524, 0x5C3A21, 0xFFDBAC]


CANHAO_ANG = -0.043  # o cano levemente pra cima, como no escudo


def canhao_em(x, y, ang=CANHAO_ANG, giro=0.0):
    """Cor do canhão (de lado, apontando pra direita) no ponto (x, y) de um espaço 40x14; None = fora.
    ang inclina o cano em torno do munhão (negativo = pra cima); giro gira os raios da roda."""
    carreta = 3 <= x <= 21 and 6.0 <= y <= 11.2 - 3.0 * (x - 3) / 18
    dx, dy = x - 13.5, y - 9.6
    d = math.hypot(dx, dy)
    if d <= 4.2:  # a roda fica na frente de tudo
        if d >= 3.1 or d <= 1.0:
            return 0xFFFFFF
        a = (math.atan2(dy, dx) - giro) % (math.pi / 2)
        if min(a, math.pi / 2 - a) * d < 0.5:
            return 0xFFFFFF
        return 0x8A6420 if carreta else None
    c, sn = math.cos(ang), math.sin(ang)
    lx, ly = x - 13.5, y - 5.0
    u, v = lx * c + ly * sn, -lx * sn + ly * c  # ao longo do cano / atravessado
    if -8.5 <= u <= 22.0:
        f = (u + 8.5) / 30.5
        r = 2.1 - 0.5 * f + (0.45 if f >= 0.95 else 0.35 if f <= 0.05 else 0.25 if 0.33 <= f <= 0.37 else 0.0)
        if abs(v) <= r:
            return 0xF0D27A if v < -r * 0.3 else 0xD9B45A
    if math.hypot(u + 10.0, v) <= 1.3:
        return 0xD9B45A  # o botão de trás
    return 0x9C7428 if carreta else None


class Torcida(Cena):
    """A torcida do Arsenal no Emirates: pula, faz ola, ergue cachecóis, acende sinalizadores e monta mosaicos."""
    combinavel = False
    peso = 0.8
    duracao = (35, 50)
    CANTOS = ["♪ One-nil to the Arsenal ♪", "♪ North London is red ♪", "♪ We love you Arsenal, we do ♪",
              "♪ Ooh to be, ooh to be a Gooner ♪", "♪ Come on you Gunners! ♪", "♪ Good old Arsenal ♪",
              "♪ Arsenal! Arsenal! Arsenal! ♪", "♪ Boring, boring Arsenal ♪"]
    FALAS = ["COYG!", "Vamos, Arsenal!", "North London is red!", "Ooh to be a Gooner ♪", "Tottenham? Quem?",
             "Esse mosaico fui eu que desenhei.", "Hoje tem gol do Saka!", "Já viu o City por aí? Nem eu."]
    MOSAICOS = [dict(linhas=[("COYG", 1)], canto="♪ Come on you Gunners! ♪"),
                dict(linhas=[("ARSENAL", 1)], canto="♪ Arsenal! Arsenal! Arsenal! ♪"),
                dict(linhas=[("1886", 1)], canto="♪ Desde 1886 ♪"),
                dict(linhas=[("49", 2), ("INVICTOS", 1)], canto="♪ We're by far the greatest team ♪"),
                dict(linhas=[("NORTH LONDON", 1), ("IS RED", 1)], canto="♪ North London is red ♪"),
                dict(canhao=True, canto="♪ Up the Arsenal! ♪")]
    CAMISAS = [(ARS_VERMELHO, 0.7), (0xF2F2F2, 0.13), (0xE8C547, 0.05), (0x1B2A4A, 0.04), (0x161616, 0.05),
               (0x6A6A6A, 0.03)]

    def iniciar(self):
        w, h = self.w, self.h
        self.ph = 2 * h
        self.base = 2 * (h - 3)
        self.cols = w // 2
        self.lins = max(1, (self.base - 8) // 4)
        self.y0 = self.base - 4 * self.lins
        n = self.cols * self.lins
        cores, pesos = zip(*self.CAMISAS)
        self.camisa, self.calca, self.pele = [], [], []
        self.fase = [random.random() for _ in range(n)]
        self.lado = [random.randrange(2) for _ in range(n)]
        self.alto = [random.random() < 0.3 for _ in range(n)]
        self.part = [random.random() > 0.025 for _ in range(n)]
        self.var = [0.9 if random.random() < 0.15 else 1.0 for _ in range(n)]  # poucos tons: o terminal agradece
        self.atraso = [random.random() for _ in range(n)]
        self.sombra = [round((0.45 + 0.55 * (r + 1) / self.lins) * 8) / 8 for r in range(self.lins)]
        base = []
        for i in range(n):
            s = self.sombra[i // self.cols]
            # torcida organizada: muita gente do lado veste igual (e o terminal agradece as cores repetidas)
            c = base[-1] if i % self.cols and random.random() < 0.5 else random.choices(cores, pesos)[0]
            base.append(c)
            s *= 0.85 if random.random() < 0.15 else 1.0
            self.camisa.append(escala(c, s))
            self.calca.append(escala(c, s * 0.78))
            self.pele.append(escala(random.choice(PELES[:4]), s))
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * self.ph)
        self.esc = 2 if h >= 40 and w >= 120 else 1
        self.cx = max(0, w - 18 * self.esc - random.randint(3, 8))
        self.modo, self.modo_t = "pulando", 0.0
        self.mosaico = None      # [cores por torcedor, começa a virar, começa a desvirar, cores da beirada de baixo]
        self.flares, self.fumaca, self.bandeiras, self.confete = [], [], [], []
        self.vento = random.uniform(-5, 5)
        self.canto, self.canto_t = random.choice(self.CANTOS), 0.0
        self.fala, self.fala_t, self.prox_fala = "", -10.0, random.uniform(3, 7)
        self.t = 0.0
        self.gen = self.roteiro()

    def montar_fundo(self):
        w = self.w
        px = [0] * (w * self.ph)
        for y in range(self.y0):
            c = 0x0A0A10 if y < self.y0 - 2 else 0x1A1A22
            px[y * w:(y + 1) * w] = [c] * w
        for x in range(4, w, 14):  # refletores na beira do telhado
            for dy in range(-3, 4):
                for dx in range(-5, 6):
                    y = 3 + dy
                    if 0 <= x + dx < w and 0 <= y < self.y0:
                        k = round(clamp(1 - math.hypot(dx * 0.6, dy) / 3.5) ** 2 * 4) / 4
                        px[y * w + x + dx] = misturar(px[y * w + x + dx], 0xFFF6D8, k)
            for dx in (0, 1):
                if x + dx < w:
                    px[3 * w + x + dx] = 0xFFFFF4
        for r in range(self.lins):
            s = self.sombra[r]
            vao, degrau = escala(0x121216, s), escala(0x34343C, s)
            yb = self.y0 + 4 * r
            for y in range(yb, yb + 3):
                px[y * w:(y + 1) * w] = [vao] * w
            px[(yb + 3) * w:(yb + 4) * w] = [degrau] * w
        return px

    # --- o que a torcida faz

    def roteiro(self):
        mosaicos = random.sample(self.MOSAICOS, len(self.MOSAICOS))
        yield from self.fase_("pulando", random.uniform(3.5, 5))
        modos = ["ola", "festa", "cachecois", "pulando"]
        random.shuffle(modos)
        k = 0
        while True:
            yield from self.fazer_mosaico(mosaicos[k % len(mosaicos)])
            k += 1
            for m in modos[:2]:
                yield from self.fase_(m, random.uniform(6, 8))
            modos = modos[2:] + modos[:2]

    def fase_(self, modo, dur):
        self.modo, self.modo_t = modo, self.t
        self.cantar(random.choice(self.CANTOS) if modo != "festa" else "♪ GOOOOOOOOL! ♪")
        if modo == "festa":
            for _ in range(160):
                self.confete.append([random.uniform(0, self.w), random.uniform(-25, 0), random.uniform(-3, 3),
                                     random.uniform(9, 20), random.choice((ARS_VERMELHO, 0xFFFFFF, 0xFFFFFF, ARS_OURO)),
                                     random.uniform(0, 6.3), self.t])
        if modo in ("festa", "cachecois") or random.random() < 0.4:
            self.acender(random.randint(2, 4))
        self.bandeiras = []
        if modo != "ola" and random.random() < 0.75:
            for _ in range(random.randint(1, 2)):
                self.bandeiras.append(self.nova_bandeira())
        yield from self.esperar(dur)

    def fazer_mosaico(self, design):
        self.modo, self.modo_t = "mosaico", self.t
        self.bandeiras = []
        grade = self.montar_mosaico(design)
        self.mosaico = [grade, self.t + 0.4, self.t + 7.6, [escala(c, 0.8) for c in grade]]
        self.cantar(design["canto"])
        yield from self.esperar(9.4)
        self.mosaico = None

    def cantar(self, txt):
        self.canto, self.canto_t = txt, self.t

    def acender(self, n):
        self.flares = []
        for _ in range(n):
            r = random.randrange(self.lins // 3, self.lins)
            c = random.randrange(2, max(3, self.cols - 2))
            self.flares.append([2 * c + 1, self.y0 + 4 * r, self.t, random.uniform(5, 8)])

    def nova_bandeira(self):
        fw, fh = random.choice(((22, 12), (26, 13), (20, 11)))
        tipo = random.choice(("meio", "AFC", "49", "listras"))
        arte = []
        g = texto_grade(tipo) if tipo in ("AFC", "49") else None
        for y in range(fh):
            linha = []
            for x in range(fw):
                if tipo == "meio":
                    c = ARS_VERMELHO if x < fw // 2 else 0xFFFFFF
                elif tipo == "listras":
                    c = ARS_VERMELHO if (y * 3 // fh) != 1 else 0xFFFFFF
                else:
                    gx, gy = x - (fw - len(g[0])) // 2, y - (fh - 5) // 2
                    letra = 0 <= gy < 5 and 0 <= gx < len(g[0]) and g[gy][gx]
                    fundo_, frente = (ARS_VERMELHO, 0xFFFFFF) if tipo == "AFC" else (0xFFFFFF, ARS_VERMELHO)
                    c = frente if letra else fundo_
                linha.append(c)
            arte.append(linha)
        x = random.uniform(4, max(5, self.w - fw - 8))
        y = self.y0 + random.uniform(0.15, 0.5) * 4 * self.lins
        return [x, y, arte, random.uniform(0, 6.3)]

    def montar_mosaico(self, design):
        cols, lins = self.cols, self.lins
        g = [[ARS_VERMELHO] * cols for _ in range(lins)]
        if lins >= 10:
            g[0] = [0xFFFFFF] * cols
            g[-1] = [0xFFFFFF] * cols
            topo, util = 1, lins - 2
        else:
            topo, util = 0, lins
        if design.get("canhao"):
            # cada cartão tem 2 pixels de largura e 4 de altura: na vertical cabe metade das unidades
            k = min((cols - 6) / 40, 2 * (util - 1) / 14)
            ox, oy = (cols - 40 * k) / 2, topo + (util - 7 * k) / 2
            for r in range(topo, topo + util):
                for c in range(cols):
                    cor_ = canhao_em((c + 0.5 - ox) / k, (r + 0.5 - oy) / (k / 2))
                    if cor_:
                        g[r][c] = cor_
        else:
            linhas = design["linhas"]
            un = max(1, int(min(min((cols - 4) / (rel * (6 * len(txt) - 1)) for txt, rel in linhas),
                                (util - 1) / (sum(5 * rel for _, rel in linhas) + len(linhas) - 1))))
            alt = sum(5 * rel * un for _, rel in linhas) + (len(linhas) - 1) * un
            y = topo + (util - alt) // 2
            letras = set()
            for txt, rel in linhas:
                gr = texto_grade(txt, rel * un)
                x0 = (cols - len(gr[0])) // 2
                for yy, linha in enumerate(gr):
                    for xx, v in enumerate(linha):
                        if v and 0 <= y + yy < lins and 0 <= x0 + xx < cols:
                            letras.add((y + yy, x0 + xx))
                y += 5 * rel * un + un
            if un >= 2:
                for r, c in letras:
                    for dr in (-1, 0, 1):
                        for dc in (-1, 0, 1):
                            if topo <= r + dr < topo + util and 0 <= c + dc < cols:
                                g[r + dr][c + dc] = ARS_OURO
            for r, c in letras:
                g[r][c] = 0xFFFFFF
        out = []
        for r in range(lins):
            s = round((0.75 + 0.25 * (r + 1) / lins) * 10) / 10
            for c in range(cols):
                i = r * cols + c
                cor_ = g[r][c] if self.part[i] else self.camisa[i]
                out.append(escala(cor_, s * self.var[i]) if self.part[i] else cor_)
        return out

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t = t
        next(self.gen)
        w, h, px = self.w, self.h, self.px
        px[:] = self.fundo
        self.desenhar_torcida(px)
        if self.mosaico is None:
            for b in self.bandeiras:
                self.desenhar_bandeira(px, b)
            self.desenhar_flares(px, dt)
        self.desenhar_confete(px, dt)
        topo_clawd = self.desenhar_clawd(px)
        pixels_para_celulas(px, w, h, ch, co)
        festa = self.modo == "festa"
        txt = " GOOOOL DO ARSENAL ★" if festa else " ARSENAL ★ COYG ★ VICTORIA CONCORDIA CRESCIT ★ EMIRATES STADIUM ★"
        off = int(t * (18 if festa else 8))
        fg = (0xFFFFFF if int(t * 6) % 2 else 0xFFD84A) if festa else 0xFF3A3A
        bg = ARS_VERMELHO if festa else 0x1A0303
        for x in range(w):
            s = txt[(x + off) % len(txt)]
            escrever(ch, co, w, h, x, h - 3, NBSP if s == " " else s,
                     fundo(ARS_OURO if s == "★" and not festa else fg, bg))
        n = min(len(self.canto), int((t - self.canto_t) * 30) + 1)
        x = (w - len(self.canto)) // 2
        brilho = 0.75 + 0.25 * math.sin(t * 4)
        for k, s in enumerate(self.canto[:n]):
            escrever(ch, co, w, h, x + k, h - 2, s, escala(ARS_VERMELHO if s == "♪" else 0xFFFFFF, brilho))
        if t >= self.prox_fala:
            self.fala, self.fala_t = random.choice(self.FALAS), t
            self.prox_fala = t + random.uniform(7, 11)
        if self.fala and t - self.fala_t < 3.2:
            balao(ch, co, w, h, self.cx + 9 * self.esc, topo_clawd // 2 - 1, self.fala, int((t - self.fala_t) * 30))

    def desenhar_torcida(self, px):
        w, t, cols = self.w, self.t, self.cols
        modo = self.modo
        cam, calca, pele, fase, lado = self.camisa, self.calca, self.pele, self.fase, self.lado
        mos = self.mosaico
        idade = t - self.modo_t
        ola = ((idade * 0.55) % 1.0) * (w + 40) - 20
        sin = math.sin
        for r in range(self.lins):
            yb = self.y0 + 4 * r
            base_r = r * cols
            for c in range(cols):
                i = base_r + c
                x = 2 * c
                if mos and self.part[i]:
                    atraso = (c / cols) * 0.9 + (r / self.lins) * 0.25 + self.atraso[i] * 0.2
                    tin, tout = mos[1] + atraso, mos[2] + atraso
                    if tin <= t < tout + 0.12:
                        if t < tin + 0.12 or t >= tout:  # cartão virando: só a beirada aparece
                            k = yb * w + x + lado[i]
                            px[k] = px[k + w] = px[k + 2 * w] = 0xD8D8D8
                        else:
                            cor_ = mos[0][i]
                            k = yb * w + x
                            px[k] = px[k + 1] = px[k + w] = px[k + w + 1] = px[k + 2 * w] = px[k + 2 * w + 1] = cor_
                            px[k + 3 * w] = px[k + 3 * w + 1] = mos[3][i]
                        continue
                f = fase[i]
                bracos = False
                if modo == "pulando":
                    dy = 1 if sin(t * 7 + f * 6.3) > 0.55 else 0
                    bracos = dy and f > 0.5
                elif modo == "festa":
                    dy = 1 + (sin(t * 13 + f * 40) > 0.2)
                    bracos = True
                elif modo == "ola":
                    d = abs(x - ola)
                    dy = 2 if d < 3 else 1 if d < 8 else 0
                    bracos = d < 8
                elif modo == "cachecois":
                    dy = 0
                    bracos = True
                else:
                    dy = 1 if sin(t * 3 + f * 6.3) > 0.9 else 0
                y = yb - dy - self.alto[i]
                k = y * w + x
                px[k + lado[i]] = pele[i]
                if bracos:
                    px[k + 1 - lado[i]] = pele[i]
                px[k + w] = px[k + w + 1] = cam[i]
                px[k + 2 * w] = px[k + 2 * w + 1] = calca[i]
                if modo == "cachecois" and yb > self.y0:
                    listra = ((x + int(sin(t * 2.2 + r * 0.8) * 2.5)) // 3 + r) % 2
                    px[k - w] = px[k - w + 1] = escala(ARS_VERMELHO if listra else 0xFFFFFF, self.sombra[r])

    def desenhar_bandeira(self, px, b):
        w, ph, t = self.w, self.ph, self.t
        x0, y0, arte, fase = b
        fh, fw = len(arte), len(arte[0])
        xi, yi = int(x0), int(y0)
        for y in range(yi - 3, yi + fh + 8):  # mastro
            if 0 <= y < ph and 0 <= xi - 1 < w:
                px[y * w + xi - 1] = 0x9A9A9A
        for x in range(fw):
            onda = math.sin(t * 4.5 - x * 0.45 + fase)
            dy = int(round(onda * 1.6 * (x + 1) / fw))
            luz = 0.8 + 0.2 * math.cos(t * 4.5 - x * 0.45 + fase)
            for y in range(fh):
                X, Y = xi + x, yi + y + dy
                if 0 <= X < w and 0 <= Y < ph:
                    px[Y * w + X] = escala(arte[y][x], luz)

    def desenhar_flares(self, px, dt):
        w, ph, t = self.w, self.ph, self.t
        vivos = []
        for f in self.flares:
            x, y, t0, dur = f
            if t - t0 > dur:
                continue
            vivos.append(f)
            pisca = 0.75 + 0.25 * math.sin(t * 37 + x)
            for dy in range(-5, 6):
                for dx in range(-7, 8):
                    X, Y = x + dx, y + dy
                    if 0 <= X < w and 0 <= Y < ph:
                        k = 1 - math.hypot(dx * 0.7, dy) / 5.2
                        if k > 0:
                            px[Y * w + X] = misturar(px[Y * w + X], 0xFF3020, k * 0.85 * pisca)
            for X, Y in ((x, y), (x + 1, y), (x, y + 1)):
                if 0 <= X < w and 0 <= Y < ph:
                    px[Y * w + X] = misturar(0xFFF4E0, 0xFF8060, 1 - pisca)
            if random.random() < dt * 6:
                self.fumaca.append([x + random.uniform(-1, 1), float(y), random.uniform(-2, 2) + self.vento,
                                    -random.uniform(6, 11), t, random.uniform(2.5, 3.5)])
        self.flares = vivos
        vivas = []
        for s in self.fumaca:
            idade = (t - s[4]) / s[5]
            if idade >= 1:
                continue
            vivas.append(s)
            s[0] += s[2] * dt
            s[1] += s[3] * dt
            r = 1.2 + idade * 3.6
            cor_ = misturar(0xE04858, 0x8A7A80, idade)
            a = 0.5 * (1 - idade)
            na = 1 - a
            cr, cg, cb = ((cor_ >> 16) & 255) * a, ((cor_ >> 8) & 255) * a, (cor_ & 255) * a
            for Y in range(max(0, int(s[1] - r)), min(ph, int(s[1] + r) + 1)):
                dy2 = (Y - s[1]) ** 2
                for X in range(max(0, int(s[0] - r)), min(w, int(s[0] + r) + 1)):
                    if (X - s[0]) ** 2 + dy2 <= r * r:
                        q = px[Y * w + X]
                        px[Y * w + X] = (int(((q >> 16) & 255) * na + cr) << 16) | (int(((q >> 8) & 255) * na + cg) << 8) \
                            | int((q & 255) * na + cb)
        self.fumaca = vivas

    def desenhar_confete(self, px, dt):
        w, ph, t = self.w, self.ph, self.t
        vivos = []
        for c in self.confete:
            c[0] += (c[2] + math.sin(t * 4 + c[5]) * 5) * dt
            c[1] += c[3] * dt
            if c[1] < self.base and t - c[6] < 8:
                vivos.append(c)
                x, y = int(c[0]), int(c[1])
                if 0 <= x < w and 0 <= y < ph:
                    px[y * w + x] = c[4]
        self.confete = vivos

    def desenhar_clawd(self, px):
        """Clawd na primeira fila, de cachecol do Arsenal. Devolve a linha (em pixels) do topo da cabeça."""
        w, ph, t, s = self.w, self.ph, self.t, self.esc
        if self.modo == "festa":
            pulo = int(abs(math.sin(t * 7)) * 4 * s)
        elif self.modo in ("pulando", "cachecois", "ola"):
            pulo = int(abs(math.sin(t * 3.5)) * 1.6 * s)
        else:
            pulo = 0
        y0 = self.base - 10 * s - pulo
        arte = arte_clawd(fechados=(t % 4.4) < 0.14)
        olhos = arte[1]
        a, b = olhos.index("#"), olhos.rindex("#")
        arte[1] = olhos[:a] + olhos[a:b].replace(".", "o") + olhos[b:]
        pix = arte_pixels(arte, self.cx, y0, s, dict(CORES_CLAWD, o=0x0A0A0A), ey=2 * s)
        yc = y0 + 4 * s
        for xx in range(self.cx + s, self.cx + 17 * s):
            pix[(xx, yc)] = ARS_VERMELHO if ((xx - self.cx) // (2 * s)) % 2 == 0 else 0xFFFFFF
        for k in range(1, 5 * s):
            pix[(self.cx + 13 * s + (1 if k > 2 * s else 0), yc + k)] = ARS_VERMELHO if (k // s) % 2 else 0xFFFFFF
        for (x, y), c in pix.items():
            if 0 <= x < w and 0 <= y < ph:
                px[y * w + x] = c
        return y0


# o galo (do Tottenham, claro), olhando pra esquerda: N = azul-marinho, n = sombra, L = brilho, Y = bico e pés
GALO = ["..L.L.L.............",
        "..LLLLL.............",
        "..NNNNN.......LLL...",
        ".NNWNNN......LNNNL..",
        "YNNKNNN.....LN...NL.",
        "YYYNNNN....LN.LL..N.",
        ".YLNNNN...LN.LNNL.N.",
        "..LLNNN...N.LN..N...",
        "...NNNNN.NN.N...N...",
        "..NNNNNNNNNNN.......",
        ".NNNNNNNNNNNN.......",
        ".NNLnnnnnNNNN.......",
        ".NNNnnnnnnNNN.......",
        "..NNNnnnnnNN........",
        "...NNNNNNNNN........",
        ".....NNNNN..........",
        "......Y..Y..........",
        "......Y..Y..........",
        ".....YY.YY.........."]
GALO_CANTA = GALO[:4] + ["YYNKNNN.....LN...NL.", "...NNNN....LN.LL..N.", "YYLNNNN...LN.LNNL.N."] + GALO[7:]
CORES_GALO = {"N": 0x22336E, "n": 0x141E44, "L": 0x4A62A8, "W": 0xFFFFFF, "K": 0x000000, "Y": 0xF2B33D}
BOLINHA = ([".WW.", "WKWW", "WWKW", ".WW."], [".WW.", "WWKW", "WKWW", ".WW."])  # bola de futebol girando


class Canhao(Cena):
    """O canhão do Arsenal contra o galo do Tottenham (e, de vez em quando, o dirigível do City)."""
    combinavel = False
    peso = 0.8
    duracao = (35, 50)
    PROVOCA = ["Cocoricó!", "Esse ano vai!", "Ano que vem é nosso!", "Ganhamos a Europa League, tá?",
               "Ninguém me derruba!", "Pode vir, Arsenal!", "Hoje não, hoje sim..."]
    APANHOU = ["CÓÓÓ!", "Foi pênalti!", "Ai, ai...", "Vou chamar o VAR!", "Isso não vale!"]
    ERROU = ["Errou! Cocoricó!", "Passou longe!", "Mira torta, hein?"]

    def iniciar(self):
        w, h = self.w, self.h
        ph = self.ph = 2 * h
        self.chao = ph - 8
        self.k = max(0.8, min(3.0, w * 0.42 / 40, ph * 0.36 / 14))
        self.sg = 2 if ph >= 120 and w >= 240 else 1
        self.ox = max(2.0, w * 0.04)
        self.oy = self.chao - 13.8 * self.k
        self.ang, self.giro, self.recuo = CANHAO_ANG, 0.0, 0.0
        self.cache = None
        self.g = ph * 1.0
        self.rb = 5 * self.sg + 1
        self.gw, self.gh = len(GALO[0]) * self.sg, len(GALO) * self.sg
        self.bola_x = w * 0.78  # bola em que o galo se equilibra
        self.galo = [self.bola_x, float(self.chao - 2 * self.rb), 0.0, 0.0, "bola", 0.0]  # x, y dos pés, vx, vy, estado, desde
        self.tiro = None        # [x, y, vx, vy, alvo]
        self.solta = None       # bola quicando depois de bater no galo
        self.disparo = -10.0
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * ph)
        self.parts = []         # [x, y, vx, vy, cor, t0, vida, tipo]
        self.placar = [random.choice((0, 0, 1, 2)), 0]
        self.dirigivel = None
        self.prox_dirigivel = random.uniform(5, 10)  # o City sempre aparece pra apanhar
        self.fala, self.fala_t = "", -10.0
        self.status = ""
        self.bum = None
        self.t = 0.0
        self.gen = self.roteiro()

    def montar_fundo(self):
        w, ph, chao = self.w, self.ph, self.chao
        px = [0] * (w * ph)
        self.ceu = []
        for y in range(chao):
            f = y / max(1, chao - 1)
            c = misturar(0x0A0820, 0x3A1640, f / 0.55) if f < 0.55 else misturar(0x3A1640, 0xE0703A, (f - 0.55) / 0.45)
            self.ceu.append(c)
            px[y * w:(y + 1) * w] = [c] * w
        for _ in range(w * chao // 90):
            y, x = int(random.random() ** 2 * chao * 0.5), random.randrange(w)
            px[y * w + x] = misturar(px[y * w + x], 0xFFFFFF, random.uniform(0.4, 0.9))
        # o Emirates no horizonte: silhueta com a coroa de luzes acesa
        cx, larg, alt = w * 0.6, w * 0.62, max(7.0, ph * 0.1)
        for x in range(max(0, int(cx - larg / 2)), min(w, int(cx + larg / 2) + 1)):
            dx = (x - cx) / (larg / 2)
            top = int(chao - alt * math.sqrt(max(0.0, 1 - dx ** 6)))
            for y in range(max(0, top - 8), top):
                px[y * w + x] = misturar(px[y * w + x], 0xFFE8C0, (1 - (top - y) / 8) ** 2 * 0.55)
            for y in range(max(0, top), chao):
                px[y * w + x] = 0x3A2A40 if y <= top + 1 else 0x2C1C34 if x % 5 == 0 else 0x22142A
            if x % 3 == 0 and top >= 0:
                px[top * w + x] = 0xFFF4D8
        letreiro(px, w, ph, "ARSENAL", cx, chao - alt * 0.45, 1, ARS_VERMELHO)
        for y in range(chao, ph):
            f = (y - chao) / max(1, ph - chao - 1)
            for x in range(w):
                px[y * w + x] = escala(0x2E6B2A if (x // 12) % 2 else 0x347A30, 0.6 + 0.4 * f)
        return px

    # --- mira e disparo

    def boca(self, ang=None):
        ang = self.ang if ang is None else ang
        x0 = self.ox + self.recuo
        return x0 + 13.5 * self.k + 22.5 * self.k * math.cos(ang), self.oy + 5.0 * self.k + 22.5 * self.k * math.sin(ang)

    def mirar(self, tx, ty, T):
        """Ângulo do cano e velocidade de saída pra bola chegar em (tx, ty) em T segundos."""
        ang = self.ang
        for _ in range(3):
            bx, by = self.boca(ang)
            vx, vy = (tx - bx) / T, (ty - by - 0.5 * self.g * T * T) / T
            ang = max(-1.1, min(0.05, math.atan2(vy, vx)))
        return ang, vx, vy

    def falar(self, txt):
        self.fala, self.fala_t = txt, self.t

    def roteiro(self):
        yield from self.esperar(random.uniform(1.0, 2.0))
        while True:
            d = self.dirigivel
            if d and d["estado"] == "voando" and self.w * 0.45 < d["x"] < self.w * 0.8:
                T = 0.8
                tx = d["x"] + d["vx"] * (T + 1.6)
                yield from self.disparar(tx, d["y"], T, "dirigivel")
                yield from self.esperar(1.0)
                continue
            if self.galo[4] != "bola":
                yield
                continue
            if random.random() < 0.6:
                self.falar(random.choice(self.PROVOCA))
            yield from self.esperar(random.uniform(1.2, 2.4))
            if self.galo[4] != "bola":
                continue
            acerta = random.random() < 0.72
            tx, ty = self.galo[0], self.galo[1] - self.gh * 0.5
            if not acerta:
                ty -= self.gh * 0.8 + random.uniform(4, 10)
            yield from self.disparar(tx, ty, random.uniform(0.7, 0.9), "galo" if acerta else "nada")
            yield from self.esperar(random.uniform(0.6, 1.2))

    def disparar(self, tx, ty, T, alvo):
        self.status = "mirando…"
        ang, vx, vy = self.mirar(tx, ty, T)
        a0, ini = self.ang, self.t
        while self.t - ini < 0.9:
            self.ang = a0 + (ang - a0) * suave((self.t - ini) / 0.9)
            yield
        self.ang = ang
        self.status = "acendendo o pavio…"
        ini = self.t
        while self.t - ini < 0.7:
            c, sn = math.cos(self.ang), math.sin(self.ang)
            x0, y0 = self.ox + self.recuo + 13.5 * self.k, self.oy + 5.0 * self.k
            fx, fy = x0 - 7.0 * self.k * c + 2.3 * self.k * sn, y0 - 7.0 * self.k * sn - 2.3 * self.k * c
            for _ in range(2):
                self.parts.append([fx, fy, random.uniform(-14, 14), random.uniform(-22, -4),
                                   random.choice((0xFFF2A0, 0xFFB040, 0xFF6020)), self.t, random.uniform(0.2, 0.45), "faisca"])
            yield
        bx, by = self.boca()
        self.tiro = [bx, by, vx, vy, alvo]
        self.disparo = self.t
        self.status = "FOGO!"
        self.bum = (bx, by, self.t)
        for _ in range(26):
            a = self.ang + random.uniform(-0.6, 0.6)
            sp = random.uniform(8, 34)
            self.parts.append([bx, by, math.cos(a) * sp, math.sin(a) * sp - 4, 0x9A9298, self.t, random.uniform(1.0, 2.0),
                               "fumaca"])
        while self.tiro:
            yield
        self.status = ""

    # --- atualização

    def atualizar(self, dt):
        t, w = self.t, self.w
        if t - self.disparo < 0.9:
            p = t - self.disparo
            self.recuo = -5 * self.k * (p / 0.06 if p < 0.06 else 1 - suave((p - 0.06) / 0.8))
        else:
            self.recuo = 0.0
        self.giro = self.recuo / (4.2 * self.k)
        if self.tiro:
            b = self.tiro
            b[3] += self.g * dt
            b[0] += b[2] * dt
            b[1] += b[3] * dt
            self.parts.append([b[0], b[1], 0.0, 0.0, 0xFFFFFF, t, 0.25, "rastro"])
            gx, gy = self.galo[0], self.galo[1]
            d = self.dirigivel
            if b[4] == "galo" and abs(b[0] - gx) < self.gw * 0.45 and gy - self.gh <= b[1] <= gy:
                self.acertou_galo(b)
            elif b[4] == "dirigivel" and d and d["estado"] == "voando" and \
                    ((b[0] - d["x"]) / (d["L"] / 2 + 2)) ** 2 + ((b[1] - d["y"]) / (d["H"] / 2 + 2)) ** 2 <= 1:
                self.acertou_dirigivel(b)
            elif b[1] >= self.chao - 2 and b[3] > 0:
                if b[4] == "nada" and self.galo[4] == "bola":
                    self.falar(random.choice(self.ERROU))
                self.solta = [b[0], float(self.chao - 2), b[2] * 0.6, -b[3] * 0.4, t]
                self.tiro = None
            elif b[0] > w + 6 or b[0] < -6 or b[1] < -self.ph:
                self.tiro = None
        if self.solta:
            s = self.solta
            s[3] += self.g * dt
            s[0] += s[2] * dt
            s[1] += s[3] * dt
            if s[1] >= self.chao - 2 and s[3] > 0:
                s[1], s[3], s[2] = self.chao - 2.0, -s[3] * 0.45, s[2] * 0.8
            if t - s[4] > 2.5 or s[0] > w + 4 or s[0] < -4:
                self.solta = None
        self.atualizar_galo(dt)
        self.atualizar_dirigivel(dt)

    def acertou_galo(self, b):
        t = self.t
        self.placar[0] += 1
        gx, gy = self.galo[0], self.galo[1] - self.gh * 0.55
        for _ in range(34):
            a = random.uniform(0, 2 * math.pi)
            sp = random.uniform(10, 45)
            self.parts.append([gx, gy, math.cos(a) * sp, math.sin(a) * sp - 15,
                               random.choice((0x22336E, 0x4A62A8, 0x141E44, 0xFFFFFF)), t, random.uniform(2.5, 4), "pena"])
        self.galo[2], self.galo[3] = min(26.0, b[2] * 0.2 + 12), -self.g * 0.4
        self.galo[4], self.galo[5] = "voando", t
        self.solta = [b[0], b[1], -b[2] * 0.25, -abs(b[3]) * 0.3 - 20, t]
        self.tiro = None
        self.falar(random.choice(self.APANHOU))

    def acertou_dirigivel(self, b):
        d = self.dirigivel
        d["estado"], d["t"] = "murchando", self.t
        d["vx"], d["vy"] = random.uniform(-80, 80), random.uniform(-60, -20)
        self.placar[1] += 1
        self.tiro = None
        for _ in range(20):
            a = random.uniform(0, 2 * math.pi)
            self.parts.append([b[0], b[1], math.cos(a) * 25, math.sin(a) * 25, 0x6CABDD, self.t, 0.8, "faisca"])
        if self.galo[4] == "bola":
            self.falar(random.choice(("Até o City apanha!", "Ih, era o dirigível do City.", "Coitado do City.")))

    def atualizar_galo(self, dt):
        g, t = self.galo, self.t
        est = g[4]
        topo_bola = float(self.chao - 2 * self.rb)
        if est == "bola":
            g[0] = self.bola_x + math.sin(t * 1.7) * 1.5
            g[1] = topo_bola
        elif est == "voando":
            g[3] += self.g * dt
            g[0] = min(self.w - self.gw * 0.6, g[0] + g[2] * dt)
            g[1] += g[3] * dt
            if g[1] >= self.chao and g[3] > 0:
                g[1], g[4], g[5] = float(self.chao), "caido", t
        elif est == "caido":
            if t - g[5] > 2.6:
                g[4], g[5] = "voltando", t
        elif est == "voltando":
            alvo = self.bola_x + self.gw * 0.6
            g[0] += max(-20 * dt, min(20 * dt, alvo - g[0]))
            if abs(g[0] - alvo) < 0.5:
                g[4], g[5], g[2] = "subindo", t, g[0]
        elif est == "subindo":
            p = min(1.0, (t - g[5]) / 0.45)
            g[0] = g[2] + (self.bola_x - g[2]) * p
            g[1] = self.chao + (topo_bola - self.chao) * p - math.sin(p * math.pi) * self.gh * 0.5
            if p >= 1:
                g[4], g[5] = "bola", t
                if random.random() < 0.5:
                    self.falar(random.choice(("Não doeu.", "Cocoricó!", "Tô de volta!")))

    def atualizar_dirigivel(self, dt):
        t, w = self.t, self.w
        if self.dirigivel is None and t >= self.prox_dirigivel:
            L, H = 40 * self.sg, 13 * self.sg
            self.dirigivel = {"x": w + L / 2 + 2, "y": self.ph * random.uniform(0.14, 0.26), "vx": -random.uniform(8, 11),
                              "vy": 0.0, "L": L, "H": H, "estado": "voando", "t": t, "esc": 1.0}
            self.prox_dirigivel = t + random.uniform(18, 28)
        d = self.dirigivel
        if not d:
            return
        if d["estado"] == "voando":
            d["x"] += d["vx"] * dt
            d["y"] += math.sin(t * 0.8) * 1.5 * dt
            if d["x"] < -d["L"]:
                self.dirigivel = None
        else:
            p = t - d["t"]
            d["esc"] = max(0.3, 1 - p * 0.35)
            if random.random() < dt * 4:
                a = random.uniform(0, 2 * math.pi)
                d["vx"], d["vy"] = math.cos(a) * 90, math.sin(a) * 60 - 15
            d["x"] += d["vx"] * dt
            d["y"] += d["vy"] * dt
            if random.random() < dt * 20:
                self.parts.append([d["x"], d["y"], -d["vx"] * 0.2, -d["vy"] * 0.2, 0xC8D8E8, t, 0.6, "fumaca"])
            if p > 3.2 or d["x"] < -60 or d["x"] > w + 60 or d["y"] < -60:
                self.dirigivel = None

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t = t
        next(self.gen)
        self.atualizar(dt)
        w, h, ph = self.w, self.h, self.ph
        px = self.px
        px[:] = self.fundo
        self.desenhar_dirigivel(px)
        self.desenhar_municao(px)
        self.desenhar_bola_do_galo(px)
        self.desenhar_galo(px)
        self.desenhar_canhao(px)
        self.desenhar_parts(px, dt)
        for b in (self.tiro, self.solta):
            if b:
                quadro = BOLINHA[int(t * 12) % 2]
                for (x, y), c in arte_pixels(quadro, int(b[0]) - 2, int(b[1]) - 2, 1, {"W": 0xFFFFFF, "K": 0x202020}).items():
                    if 0 <= x < w and 0 <= y < ph:
                        px[y * w + x] = c
        if self.bum and t - self.bum[2] < 0.7:
            bx, by, t0 = self.bum
            r = 7 * self.k * (1 - (t - t0) / 0.15) if t - t0 < 0.15 else 0
            for y in range(int(by - r), int(by + r) + 1):
                for x in range(int(bx - r), int(bx + r) + 1):
                    if 0 <= x < w and 0 <= y < ph and (x - bx) ** 2 + (y - by) ** 2 <= r * r:
                        px[y * w + x] = misturar(0xFFF8D0, 0xFFA030, math.hypot(x - bx, y - by) / max(1, r))
            letreiro(px, w, ph, "BUM!", bx + 6, by - 9 - (t - t0) * 6, 2 if ph >= 70 else 1, 0xFFE040, ARS_VERMELHO)
        pixels_para_celulas(px, w, h, ch, co)
        x = chip(ch, co, w, h, 2, 1, " CANHÃO ", 0xFFFFFF, ARS_VERMELHO)
        x = chip(ch, co, w, h, x, 1, f" {self.placar[0]} x 0 ", 0xFFFFFF, 0x1C1C1C)
        x = chip(ch, co, w, h, x, 1, " GALO ", 0xFFFFFF, 0x22336E)
        if self.placar[1]:
            txt = f"  dirigíveis do City: {self.placar[1]}"
            for k, s in enumerate(txt):
                if x + k < w:
                    escrever(ch, co, w, h, x + k, 1, NBSP if s == " " else s, fundo(0x6CABDD, self.ceu[2]))
        if self.status:
            x0 = w - len(self.status) - 2
            for k, s in enumerate(self.status):
                cor_ = 0xFFD84A if self.status == "FOGO!" else 0xB0A8C0
                escrever(ch, co, w, h, x0 + k, 1, NBSP if s == " " else s, fundo(cor_, self.ceu[2]))
        if self.fala and t - self.fala_t < 3.0:
            g = self.galo
            balao(ch, co, w, h, int(g[0]), int(g[1] - self.gh) // 2 - 1, self.fala, int((t - self.fala_t) * 30))

    def desenhar_canhao(self, px):
        w, ph, k = self.w, self.ph, self.k
        x0 = self.ox + round(self.recuo)
        chave = (round(self.ang / 0.025), round(self.giro, 1), x0)
        if self.cache is None or self.cache[0] != chave:
            pix = []
            for y in range(max(0, int(self.oy - 18 * k)), min(ph, self.chao + 1)):
                for x in range(max(0, int(x0 - 2 * k)), min(w, int(x0 + 42 * k) + 1)):
                    c = canhao_em((x + 0.5 - x0) / k, (y + 0.5 - self.oy) / k, self.ang, self.giro)
                    if c:
                        pix.append((y * w + x, c))
            self.cache = (chave, pix)
        for i, c in self.cache[1]:
            px[i] = c

    def desenhar_municao(self, px):
        w, ph, k = self.w, self.ph, self.k
        cores = {"W": 0xF0F0F0, "K": 0x202020}
        for fila, n in ((0, 3), (1, 2), (2, 1)):
            for i in range(n):
                x = int(self.ox + 25 * k + i * 5 + fila * 2.5)
                y = self.chao - 4 - fila * 4
                for (xx, yy), c in arte_pixels(BOLINHA[(i + fila) % 2], x, y, 1, cores).items():
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = c

    def desenhar_bola_do_galo(self, px):
        w, ph, r = self.w, self.ph, self.rb
        cx, cy = self.bola_x + math.sin(self.t * 1.7) * 0.8, self.chao - r
        giro = math.sin(self.t * 1.7) * 0.4
        gomos = [(0.0, 0.0)] + [(math.cos(a + giro) * r * 0.62, math.sin(a + giro) * r * 0.62)
                                for a in [k * 2 * math.pi / 5 - math.pi / 2 for k in range(5)]]
        for y in range(int(cy - r) - 1, int(cy + r) + 2):
            for x in range(int(cx - r) - 1, int(cx + r) + 2):
                dx, dy = x + 0.5 - cx, y + 0.5 - cy
                if 0 <= x < w and 0 <= y < ph and dx * dx + dy * dy <= r * r:
                    if any((dx - gx) ** 2 + (dy - gy) ** 2 <= (r * 0.2) ** 2 for gx, gy in gomos):
                        c = 0x1A1A1A
                    else:
                        c = escala(0xF4F4F4, 0.72 + 0.28 * clamp(0.5 - (dx + dy) / (2 * r)))
                    px[y * w + x] = c

    def desenhar_galo(self, px):
        w, ph, t, sg = self.w, self.ph, self.t, self.sg
        x, y, vx, vy, est, desde = self.galo
        cantando = est == "bola" and self.fala in ("Cocoricó!", "Errou! Cocoricó!") and t - self.fala_t < 1.0
        arte = list(GALO_CANTA if cantando and int(t * 6) % 2 else GALO)
        if est == "caido" or (est == "voando" and t - desde > 0.12):
            arte = arte[::-1]
        if est == "voltando":
            y -= int(t * 8) % 2
        for (xx, yy), c in arte_pixels(arte, int(x - self.gw / 2), int(y - self.gh), sg, CORES_GALO).items():
            if 0 <= xx < w and 0 <= yy < ph:
                px[yy * w + xx] = c
        if est == "caido":
            cx, cy = x, y - self.gh - 2
            for k in range(3):
                a = t * 4 + k * 2.1
                sx, sy = int(cx + math.cos(a) * self.gw * 0.45), int(cy + math.sin(a) * 2.5)
                for dx, dy, c in ((0, 0, 0xFFFFFF), (-1, 0, 0xFFD84A), (1, 0, 0xFFD84A), (0, -1, 0xFFD84A), (0, 1, 0xFFD84A)):
                    if 0 <= sx + dx < w and 0 <= sy + dy < ph:
                        px[(sy + dy) * w + sx + dx] = c

    def desenhar_dirigivel(self, px):
        d = self.dirigivel
        if not d:
            return
        w, ph = self.w, self.ph
        a, b = d["L"] / 2 * d["esc"], d["H"] / 2 * d["esc"]
        cx, cy = d["x"], d["y"]
        for y in range(int(cy - b) - 1, int(cy + b) + 2):
            for x in range(int(cx - a) - 1, int(cx + a + a * 0.3) + 2):
                if not (0 <= x < w and 0 <= y < ph):
                    continue
                nx, ny = (x + 0.5 - cx) / a, (y + 0.5 - cy) / b
                if nx * nx + ny * ny <= 1:
                    px[y * w + x] = escala(0x6CABDD, 0.7 + 0.45 * clamp(0.5 - ny * 0.8))
                elif nx > 0.7 and abs(ny) < (nx - 0.7) * 1.6 and nx < 1.25 and abs(ny) > 0.25:
                    px[y * w + x] = 0x1C2C5B  # lemes
        gy = int(cy + b)
        for x in range(int(cx - a * 0.2), int(cx + a * 0.2) + 1):
            for y in (gy, gy + 1):
                if 0 <= x < w and 0 <= y < ph:
                    px[y * w + x] = 0x1C2C5B
        if d["estado"] == "voando":
            letreiro(px, w, ph, "CITY", cx, cy, 1, 0x1C2C5B)
        elif int(self.t * 8) % 2:
            letreiro(px, w, ph, "PFFFRRRT!", cx, max(4, cy - b - 6), 1, 0xFFFFFF)

    def desenhar_parts(self, px, dt):
        w, ph, t = self.w, self.ph, self.t
        vivas = []
        for p in self.parts:
            idade = (t - p[5]) / p[6]
            if idade >= 1:
                continue
            vivas.append(p)
            tipo = p[7]
            if tipo == "pena":
                p[2] *= 1 - 2.5 * dt
                p[3] += (7 - p[3]) * 2.5 * dt
                p[0] += (p[2] + math.sin(t * 5 + p[5] * 13) * 6) * dt
            elif tipo == "fumaca":
                p[2] *= 1 - 1.5 * dt
                p[3] = p[3] * (1 - 1.5 * dt) - 6 * dt
                p[0] += p[2] * dt
            else:
                p[3] += 40 * dt if tipo == "faisca" else 0
                p[0] += p[2] * dt
            p[1] += p[3] * dt
            x, y = int(p[0]), int(p[1])
            if tipo == "fumaca":
                r = 1 + idade * 4 * self.k
                a = 0.55 * (1 - idade)
                for yy in range(max(0, int(p[1] - r)), min(ph, int(p[1] + r) + 1)):
                    for xx in range(max(0, int(p[0] - r)), min(w, int(p[0] + r) + 1)):
                        if (xx - p[0]) ** 2 + (yy - p[1]) ** 2 <= r * r:
                            px[yy * w + xx] = misturar(px[yy * w + xx], p[4], a)
            elif 0 <= x < w and 0 <= y < min(ph, self.chao + (6 if tipo == "pena" else 0)):
                px[y * w + x] = p[4] if tipo != "rastro" else misturar(px[y * w + x], 0xFFFFFF, 0.5 * (1 - idade))
        self.parts = vivas


# jogador de lado (olhando pra direita), 6x11: k = cabelo, s = pele, m = manga, c = camisa, w = calção, p = meião, b = chuteira
CORPO_LADO = [".kkk..", ".kkss.", "..ss..", ".mccm.", "mmccmm", "s.cc.s", "..cc..", "..ww.."]
PERNAS_LADO = {"parado": ["..ss..", "..ss..", "..pp..", ".bbb.."],
               "corre1": [".s..s.", ".s..s.", "p...p.", "b....b"],
               "corre2": ["..ss..", "..s.s.", ".p.p..", ".bb.b."],
               "chuta": ["..ss..", "..s.ss", "..p..p", ".bb..b"],
               "pulo": ["..ss..", ".ss...", "pp....", "b....."]}
BRACOS_CIMA = [".kkk..", ".kkss.", "s.ss.s", "smccms", ".mccm.", "..cc..", "..cc..", "..ww.."]
DEITADO = ["......", "......", "......", "......", "......", "......", "......", "......",
           "kk....", "kssmcc", "..mcccwwsspb"]


class Escanteio(Cena):
    """Gol de escanteio do Gabriel Magalhães, com câmera de lado (estilo Futebol Brasileiro 96 / ISS) e replay."""
    combinavel = False
    peso = 0.8
    duracao = (35, 50)
    DUR = 16.0   # cada lance: armação, cobrança, gol, festa e replay
    EXTRAS = ["Bola parada é com ele!", "O zagueiro artilheiro!", "Subiu mais que todo mundo!",
              "Ninguém segura o Gabriel na bola aérea.", "De novo! Escanteio do Arsenal é meio gol."]

    def iniciar(self):
        w, h = self.w, self.h
        ph = self.ph = 2 * h
        self.e = 2 if ph >= 150 and w >= 280 else 1
        # câmera de lado com perspectiva leve: Z = profundidade (0 = lateral perto da câmera), X = 0 na linha de fundo.
        # Y0(Z) = C·p(Z) é a linha da tela "absoluta"; a câmera anda em Z (panorâmica) somando um deslocamento.
        self.D = 90.0
        self.C = 0.72 * ph / (self.D / (13.84 + self.D) - self.D / (54.16 + self.D))
        self.Sx = w / 34.8 / (self.D / (34 + self.D))
        self.Sy = self.Sx * 0.9
        self.Xc = -9.7
        self.cam = 0.0
        self.rival = RIVAIS["TOT"] if random.random() < 0.6 else RIVAIS["MCI"]
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * ph)
        self.gols = [random.choice((0, 1, 1, 2)), 0]
        self.min0 = random.uniform(55, 75)
        self.n = -1
        self.t = 0.0
        self.confete = []
        self.novo_lance(0.0)

    def tela(self, X, Y, Z):
        p = self.D / (Z + self.D)
        return self.w / 2 + (X - self.Xc) * self.Sx * p, self.C * p - self.cam - Y * self.Sy * p

    def mirar_camera(self, tau):
        """Panorâmica: começa na bandeirinha, acompanha a bola até a área e volta pra festa perto da câmera."""
        if tau < 2.2:
            zc = 12.0
        elif tau < 4.6:
            zc = 12.0 + 24.0 * suave((tau - 2.2) / 1.6)
        else:
            zc = 36.0 - 15.0 * suave((tau - 4.8) / 2.4)
        self.cam = int(self.C * self.D / (zc + self.D) - self.ph / 2)

    def montar_fundo(self):
        """Gramado e linhas numa faixa alta (do Z = -6 ao 66); cada quadro recorta a parte que a câmera vê."""
        w = self.w
        D, C, Sx = self.D, self.C, self.Sx
        self.y_min = int(C * D / (66 + D)) - self.ph
        y_max = int(C * D / (-6 + D)) + self.ph
        px = []
        for ya in range(self.y_min, y_max):
            p = (ya + 0.5) / C
            Z = D / p - D
            for x in range(w):
                X = self.Xc + (x + 0.5 - w / 2) / (Sx * p)
                listra = int((X + 200) // 4) % 2
                c = escala(0x37913B if listra else 0x2F7D33, 0.78 + 0.22 * (1 - Z / 68))
                tx = 0.55 / (Sx * p)
                tz = 0.6 * D / (p * p * C)
                linha = (abs(Z) < tz or abs(Z - 68) < tz or
                         (abs(X) < tx and 0 <= Z <= 68) or
                         (abs(X + 16.5) < tx and 13.84 <= Z <= 54.16) or
                         (abs(X + 5.5) < tx and 24.84 <= Z <= 43.16) or
                         (min(abs(Z - 13.84), abs(Z - 54.16)) < tz and -16.5 <= X <= 0) or
                         (min(abs(Z - 24.84), abs(Z - 43.16)) < tz and -5.5 <= X <= 0) or
                         (X < -16.5 and abs(math.hypot(X + 11, (Z - 34)) - 9.15) < max(tx, tz)) or
                         (abs(X + 11) < tx * 1.5 and abs(Z - 34) < tz * 1.5))
                px.append(0xDCE8DC if linha else c)
        return px

    # --- o lance: tudo é função do tempo, então o replay é só rodar de novo mais devagar

    def novo_lance(self, t0):
        self.n += 1
        self.t0 = t0
        self.marcou = False
        self.Zh = 34 + random.choice((-1, 1)) * random.uniform(0.6, 2.0)   # onde o Gabriel cabeceia
        self.Zt = 34 + random.choice((-1, 1)) * random.uniform(2.2, 3.0)   # canto em que a bola entra
        self.Yt = random.uniform(0.5, 1.9)
        self.Zg0 = self.Zh + random.choice((-1, 1)) * random.uniform(4, 7)
        self.dv = 1 if self.Zt > 34 else -1  # pra onde o goleiro devia ter pulado (pula atrasado)
        r = self.rival
        ars = {"m": 0xFFFFFF, "c": ARS_VERMELHO, "w": 0xFFFFFF, "p": 0xFFFFFF, "b": 0x1A1A1A}
        riv = {"m": r["camisa"], "c": r["camisa"], "w": r["calcao"], "p": r["meiao"], "b": 0x1A1A1A}
        self.jog = []
        for X, Z, dX, dZ in ((-10.0, 25.5, 4.0, 3.0), (-7.5, 42.0, 2.5, -2.0), (-14.0, 33.0, 5.0, 1.0),
                             (-2.0, 35.5, 0.0, 0.0)):
            cores = dict(ars, k=random.choice(CABELOS), s=random.choice(PELES))
            self.jog.append(dict(cores=cores, X=X, Z=Z, dX=dX, dZ=dZ, olha=1, marca=None))
        for a in list(self.jog):
            cores = dict(riv, k=random.choice(CABELOS), s=random.choice(PELES))
            self.jog.append(dict(cores=cores, X=a["X"] + 0.9, Z=a["Z"] + random.uniform(-0.8, 0.8), dX=a["dX"] * 0.6,
                                 dZ=a["dZ"] * 0.6, olha=-1, marca=None))
        cores = dict(riv, k=random.choice(CABELOS), s=random.choice(PELES))
        self.jog.append(dict(cores=cores, X=-1.0, Z=31.5, dX=0, dZ=0, olha=-1, marca=None))
        self.gabriel = dict(ars, k=0x1C140E, s=0xC68642)
        self.cobrador = dict(ars, k=0x8A6A3A, s=0xF1C9A5)
        self.marcador = dict(riv, k=random.choice(CABELOS), s=random.choice(PELES))
        gk = r["goleiro"]
        self.goleiro = {"m": gk, "c": gk, "w": 0x1A1A1A, "p": gk, "b": 0x1A1A1A, "k": random.choice(CABELOS),
                        "s": random.choice(PELES)}

    def estado(self, tau):
        """Onde está todo mundo (e a bola) no instante tau do lance."""
        L = []
        mov = suave((tau - 2.3) / 1.8)
        abraco = suave((tau - 5.0) / 2.2)  # o time do Arsenal corre pra abraçar o Gabriel
        for k, j in enumerate(self.jog):
            ginga = math.sin(tau * 3 + j["X"]) * 0.25 * (1 - mov)
            X, Z = j["X"] + j["dX"] * mov + ginga, j["Z"] + j["dZ"] * mov
            pose = "corre" if 0 < mov < 1 else "parado"
            olha = j["olha"]
            if j["olha"] > 0 and abraco > 0:
                ax, az = -8.9 + (k % 2 * 2 - 1) * (1.2 + k * 0.4), 16.0 + 1.5 + k * 0.8
                X, Z = X + (ax - X) * abraco, Z + (az - Z) * abraco
                pose = "festa" if abraco >= 1 else "corre"
                olha = -1
            L.append((X, 0.0, Z, j["cores"], pose, olha))
        # o cobrador
        if tau < 1.4:
            cx, cz, pose = 1.4, -0.9, "parado"
        elif tau < 2.0:
            f = (tau - 1.4) / 0.6
            cx, cz, pose = 1.4 - 1.1 * f, -0.9 + 1.0 * f, "corre"
        else:
            cx, cz, pose = 0.3, 0.1, "chuta" if tau < 2.4 else "parado"
        L.append((cx, 0.0, cz, self.cobrador, pose, -1))
        # Gabriel: corrida, pulo e cabeçada
        if tau < 2.6:
            gx, gz, gy, pose = -12.0 + math.sin(tau * 2) * 0.3, self.Zg0, 0.0, "parado"
        elif tau < 3.95:
            f = suave((tau - 2.6) / 1.35)
            gx, gz, gy, pose = -12.0 + 5.6 * f, self.Zg0 + (self.Zh - self.Zg0) * f, 0.0, "corre"
        elif tau < 4.6:
            f = (tau - 3.95) / 0.65
            gx, gz, gy, pose = -6.4 + 0.5 * f, self.Zh, math.sin(f * math.pi) * 0.95, "pulo"
        elif tau < 8.5:
            f = suave((tau - 4.6) / 2.6)
            gx, gz, gy, pose = -5.9 - 3 * f, self.Zh + (16 - self.Zh) * f, 0.0, "festa" if f >= 1 else "corre"
        else:
            gx, gz, gy, pose = -8.9, 16.0, 0.0, "festa"
        L.append((gx, gy, gz, self.gabriel, pose, 1 if tau < 4.6 else -1))
        # o marcador dele chega atrasado e pula baixo
        if tau < 3.95:
            mx, mz = gx + 1.0, gz + 0.9
            my, mpose = 0.0, "corre" if tau > 2.7 else "parado"
        elif tau < 4.7:
            f = (tau - 4.05) / 0.65
            mx, mz, my, mpose = -5.5, self.Zh + 0.9, max(0.0, math.sin(clamp(f) * math.pi) * 0.45), "pulo"
        else:
            mx, mz, my, mpose = -5.5, self.Zh + 0.9, 0.0, "parado"
        L.append((mx, my, mz, self.marcador, mpose, -1))
        # goleiro: sai atrasado pro canto
        if tau < 4.3:
            kx, kz, ky, kpose = -0.6, 34 + math.sin(tau * 2) * 0.4, 0.0, "parado"
        else:
            f = clamp((tau - 4.3) / 0.35)
            kx, kz, ky, kpose = -0.6, 34 + self.dv * 2.0 * f, math.sin(f * math.pi) * 0.5, "deitado" if f >= 1 else "pulo"
        L.append((kx, ky, kz, self.goleiro, kpose, -1))
        # a bola
        if tau < 2.0:
            b = (0.2, 0.0, 0.3)
        elif tau < 4.2:
            f = (tau - 2.0) / 2.2
            b = (0.2 + (-5.6 - 0.2) * f, 0.1 + 2.6 * f + 6.5 * math.sin(f * math.pi), 0.3 + (self.Zh - 0.3) * f)
        elif tau < 4.5:
            f = (tau - 4.2) / 0.3
            b = (-5.6 + 5.9 * f, 2.7 + (self.Yt - 2.7) * f, self.Zh + (self.Zt - self.Zh) * f)
        else:
            f = clamp((tau - 4.5) / 0.35)
            b = (0.3 + 1.4 * f, self.Yt * (1 - f), self.Zt)
        return L, b

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t = t
        tau = t - self.t0
        if tau >= self.DUR:
            self.novo_lance(t)
            tau = 0.0
        replay = tau >= 8.6
        tr = 2.4 + (tau - 8.6) * 0.38 if replay else tau
        if not self.marcou and tau >= 4.55:
            self.marcou = True
            self.gols[0] += 1
            for _ in range(120):
                self.confete.append([random.uniform(0, self.w), random.uniform(-20, 0), random.uniform(-3, 3),
                                     random.uniform(10, 22), random.choice((ARS_VERMELHO, 0xFFFFFF, ARS_OURO)),
                                     random.uniform(0, 6.3), t])
        w, h, ph = self.w, self.h, self.ph
        px = self.px
        self.mirar_camera(tr)
        ini = max(0, min(len(self.fundo) - w * ph, (self.cam - self.y_min) * w))
        px[:] = self.fundo[ini:ini + w * ph]
        L, bola = self.estado(tr)
        self.desenhar_gol(px, tr, bola)
        bx, by = self.tela(bola[0], 0, bola[2])
        for xx in range(int(bx) - 1, int(bx) + 2):
            if 0 <= xx < w and 0 <= int(by) < ph:
                px[int(by) * w + xx] = escala(px[int(by) * w + xx], 0.45)
        itens = [(Z, "j", (X, Y, Z, cores, pose, olha)) for X, Y, Z, cores, pose, olha in L]
        itens.append((bola[2] - 0.01, "b", bola))
        for _, tipo, it in sorted(itens, key=lambda k: -k[0]):
            if tipo == "j":
                self.desenhar_jogador(px, *it, tr)
            else:
                x, y = self.tela(*it)
                quadro = BOLINHA[int(tr * 10) % 2]
                for (xx, yy), c in arte_pixels(quadro, int(x) - 2 * self.e, int(y) - 4 * self.e, self.e,
                                               {"W": 0xFFFFFF, "K": 0x202020}).items():
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = c
        self.desenhar_confete(px, dt)
        if 4.6 <= tau < 7.6:
            pisca = int((tau - 4.6) * 5) % 2
            letreiro(px, w, ph, "GOOOOL!", w / 2, ph * 0.45, esc_letreiro("GOOOOL!", w * 0.6, 4),
                     0xFFFFFF if pisca else ARS_VERMELHO, ARS_VERMELHO if pisca else 0xFFFFFF)
        if replay and int(tau * 2) % 2:
            letreiro(px, w, ph, "REPLAY", 4 + 18 * self.e, ph * 0.3, self.e, 0xFFE040, 0x202020)
        px[:2 * w] = [0] * (2 * w)
        px[(ph - 2) * w:] = [0] * (2 * w)
        pixels_para_celulas(px, w, h, ch, co)
        r = self.rival
        x = chip(ch, co, w, h, 2, 0, " ARS ", 0xFFFFFF, ARS_VERMELHO)
        x = chip(ch, co, w, h, x, 0, f" {self.gols[0]}-{self.gols[1]} ", 0xFFFFFF, 0x1C1C1C)
        x = chip(ch, co, w, h, x, 0, f" {r['sigla']} ", r["chip"][0], r["chip"][1])
        m = self.min0 + (self.n * self.DUR + min(tau, 8.6)) * 0.4
        chip(ch, co, w, h, x + 1, 0, f" {int(m):02d}:{int(m % 1 * 60):02d} ", 0xD8D8D8, 0x2E2E2E)
        if tau < 4.6 and not replay:
            gx, gy, gz = next((X, Y, Z) for X, Y, Z, c, _, _ in L if c is self.gabriel)
            sx, sy = self.tela(gx, gy, gz)
            row = int(sy - 13 * self.e) // 2
            nome = "GABRIEL ▼"
            for k, s in enumerate(nome):
                xx = int(sx) - 4 + k
                if 0 <= xx < w and 0 <= row < h:
                    escrever(ch, co, w, h, xx, row, NBSP if s == " " else s,
                             fundo(0xFFE040 if s == "▼" else 0xFFFFFF, px[2 * row * w + xx]))
        if replay:
            txt, cor_ = "Olha o replay: subiu sozinho, testou firme. Indefensável!", 0xFFE040
        elif tau < 1.2:
            txt, cor_ = f"Escanteio para o Arsenal. Rice vai cobrar.", 0xE0E0E0
        elif tau < 4.2:
            txt, cor_ = "Rice levantou na área... olha o Gabriel!", 0xE0E0E0
        elif tau < 5.6:
            txt, cor_ = "GABRIEL MAGALHÃES! DE CABEÇAAA!", ARS_VERMELHO if int(t * 4) % 2 else 0xFFFFFF
        elif tau < 7.0:
            txt, cor_ = "GOOOOOOOOL DO ARSENAL!", ARS_VERMELHO if int(t * 4) % 2 else 0xFFFFFF
        else:
            txt, cor_ = self.EXTRAS[self.n % len(self.EXTRAS)], 0xFFFFFF
        escrever(ch, co, w, h, 2, h - 1, "▸ " + txt, cor_)

    def desenhar_jogador(self, px, X, Y, Z, cores, pose, olha, tau):
        w, ph, e = self.w, self.ph, self.e
        sx, sy = self.tela(X, 0, Z)
        sy -= Y * self.Sy * self.D / (Z + self.D)
        if pose == "deitado":
            arte = DEITADO
        elif pose == "festa":
            arte = BRACOS_CIMA + PERNAS_LADO["parado" if int(tau * 6) % 2 else "corre2"]
            sy -= int(abs(math.sin(tau * 9)) * 2 * e)
        else:
            pernas = pose if pose in PERNAS_LADO else ("corre1" if int(tau * 8 + X) % 2 else "corre2")
            arte = CORPO_LADO + PERNAS_LADO[pernas]
        largura = max(len(l) for l in arte)
        if olha < 0:
            arte = [l.ljust(largura, ".")[::-1] for l in arte]
        x0, y0 = int(sx) - 3 * e, int(sy) - len(arte) * e
        for (x, y), c in arte_pixels(arte, x0, y0, e, cores).items():
            if 0 <= x < w and 0 <= y < ph:
                px[y * w + x] = c

    def desenhar_gol(self, px, tau, bola):
        """Traves, travessão e rede (a rede estufa quando a bola entra)."""
        w, ph = self.w, self.ph
        estufa = 0.0
        if 4.45 <= tau < 5.6:
            estufa = 0.55 * (1 - (tau - 4.45) / 1.15)

        def ponto(X, Y, Z, c):
            x, y = self.tela(X, Y, Z)
            x, y = int(x), int(y)
            if 0 <= x < w and 0 <= y < ph:
                px[y * w + x] = c

        rede = 0xB8C4B8
        z0, z1 = 34 - 3.66, 34 + 3.66
        passo = 0.18
        for i in range(int(2.0 / passo) + 1):          # teto e laterais
            X = i * passo
            for j in range(int(2.44 / passo) + 1):
                Y = j * passo
                for Z in (z0, z1):
                    if (i + j) % 2 == 0:
                        ponto(X, Y * (1 - X * 0.2), Z, rede)
            for k in range(int(7.32 / passo) + 1):
                if (i + k) % 2 == 0:
                    ponto(X, 2.44 - X * 0.2, z0 + k * passo, rede)
        for k in range(int(7.32 / passo) + 1):          # fundo da rede
            Z = z0 + k * passo
            for j in range(int(2.0 / passo) + 1):
                Y = j * passo
                if (j + k) % 2 == 0:
                    d = math.hypot(Z - self.Zt, Y - self.Yt * 0.6)
                    ponto(2.0 + estufa * max(0.0, 1 - d / 2.2), Y, Z, rede)
        for Z in (z0, z1):                               # traves
            for j in range(0, 25):
                ponto(0, 2.44 * j / 24, Z, 0xFFFFFF)
        for k in range(0, 41):                           # travessão
            ponto(0, 2.44, z0 + 7.32 * k / 40, 0xFFFFFF)

    def desenhar_confete(self, px, dt):
        w, ph, t = self.w, self.ph, self.t
        vivos = []
        for c in self.confete:
            c[0] += (c[2] + math.sin(t * 4 + c[5]) * 5) * dt
            c[1] += c[3] * dt
            if c[1] < ph and t - c[6] < 5:
                vivos.append(c)
                x, y = int(c[0]), int(c[1])
                if 0 <= x < w and 0 <= y < ph:
                    px[y * w + x] = c[4]
        self.confete = vivos


# ------------------------------------------------ o Gago do United (balão de parada em Old Trafford, debaixo de chuva)

MU_VERMELHO = 0xDA291C
PELE_GAGO, CABELO_GAGO, BARBA_GAGO = 0xE0A882, 0x2A1C12, 0x21160E


def gago_em(u, v, cara="acordado", bracos=0.0, curativos=()):
    """Cor do Gago (em forma de Snorlax) no ponto (u, v) medido em raios do corpo
    (centro do corpo em (0, 0), v pra baixo); None = fora.
    cara: acordado, rindo, assustado ou murcho; bracos vai de 0 (caídos) a 1 (pra cima)."""
    if v > 1.2 or v < -1.64 or abs(u) > 1.22:
        return None
    # os pés de Snorlax, com a sola virada pra frente
    for s in (-1, 1):
        fx, fy = (u - 0.52 * s) / 0.3, (v - 0.98) / 0.2
        if fx * fx + fy * fy <= 1:
            return 0x8E6040 if fx * fx * 2.2 + fy * fy * 2.6 <= 1 else 0xEAD9B0
    # bracinhos fechados de tatuagem, saindo da manga
    for s in (-1, 1):
        ax, ay = (u - 0.98 * s) / 0.21, (v - 0.08 + 0.5 * bracos) / 0.36
        if ax * ax + ay * ay <= 1:
            if ay < -0.35:
                return escala(MU_VERMELHO, 0.85)
            if (int((u + 2) * 23) * 5 + int((v + 2) * 19) * 3) % 9 < 2:
                return 0x34384A
            return escala(PELE_GAGO, 0.92)
    # as orelhinhas pontudas do Snorlax no meio dos cachos
    for s in (-1, 1):
        if -1.62 <= v <= -1.2 and abs(u * s - 0.36) <= (v + 1.62) * 0.42:
            return CABELO_GAGO
    hx, hy = u / 0.56, (v + 0.98) / 0.5
    if hx * hx + hy * hy <= 1:
        if hy < -0.5 + 0.1 * math.sin(hx * 13):
            return CABELO_GAGO
        if abs(hx) > 0.8 and hy > -0.3:
            return BARBA_GAGO  # costeletas
        if -0.36 <= hy <= -0.22 and 0.16 <= abs(hx) <= 0.58:
            return CABELO_GAGO  # sobrancelhas
        ex, ey = abs(hx) - 0.36, hy + 0.06
        if cara == "murcho":
            if abs(ex) <= 0.15 and abs(ey) <= 0.15 and (abs(ex - ey) < 0.07 or abs(ex + ey) < 0.07):
                return 0x2A1A12
        elif cara == "assustado":
            d = ex * ex + ey * ey
            if d <= 0.022:
                return 0x1A1210 if d <= 0.007 else 0xFFFFFF
        elif ex * ex / 0.018 + ey * ey / 0.03 <= 1:
            return 0x1A1210
        if hx * hx / 0.017 + (hy - 0.14) ** 2 / 0.0144 <= 1:
            return escala(PELE_GAGO, 0.8)  # nariz
        mx, my = hx / 0.32, (hy - 0.5) / 0.17
        if cara in ("acordado", "rindo"):
            if mx * mx + my * my <= 1 and my >= (-0.6 if cara == "rindo" else -0.1):
                return 0xFFFFFF if my < 0.3 else 0x7A2020
        elif cara in ("assustado", "murcho"):
            if hx * hx / 0.026 + (hy - 0.52) ** 2 / 0.032 <= 1:
                return 0x3A1010
        if hy > 0.26 or (hy > 0.2 and abs(hx) < 0.36):
            return BARBA_GAGO
        return escala(PELE_GAGO, 0.88 + 0.14 * clamp(0.5 - hx * 0.4 - hy * 0.4))
    if hx * hx + hy * hy > 1 and v < -1.08:
        cx, cy = u / 0.6, (v + 1.2) / 0.32
        if cx * cx + cy * cy <= (1 + 0.14 * math.sin(math.atan2(cy, cx) * 11)) ** 2:
            return CABELO_GAGO  # volume dos cachos
    if u * u / 0.21 + (v + 0.6) ** 2 / 0.04 <= 1:
        return BARBA_GAGO  # a barba cai por cima da gola
    by = (v - 0.1) / 0.92
    if u * u + by * by <= 1:
        for cu, cv in curativos:
            du, dv = u - cu, v - cv
            a, b = (du + dv) * 0.707, (du - dv) * 0.707
            if (abs(a) < 0.17 and abs(b) < 0.055) or (abs(b) < 0.17 and abs(a) < 0.055):
                return 0xD9B48A if abs(a) < 0.055 and abs(b) < 0.055 else 0xEEC9A0
        if u * u / 0.25 + (v + 0.72) ** 2 / 0.09 <= 1:
            return 0x141414  # gola
        if v > 0.74:
            return escala(0xF2F2F2, 0.8 + 0.2 * clamp(0.5 - u * 0.5))  # calção
        if (u + 0.45) ** 2 / 0.03 + (v + 0.3) ** 2 / 0.012 <= 1:
            return misturar(MU_VERMELHO, 0xFFFFFF, 0.55)  # o brilho de balão
        return escala(MU_VERMELHO, 0.68 + 0.4 * clamp(0.6 - u * 0.45 - by * 0.55))
    return None


def pintar_clawd(px, w, ph, x0, y0, s, t, passo=False, olhar=1):
    """O Clawd de cachecol do Arsenal, com o canto de cima à esquerda em (x0, y0) no buffer de pixels."""
    pix = arte_pixels(arte_clawd(olhar=olhar, fechados=(t % 3.7) < 0.14, passo=passo), x0, y0, s, CORES_CLAWD, ey=2 * s)
    yc = y0 + 4 * s - 1
    for xx in range(x0 + 3 * s, x0 + 15 * s):
        pix[(xx, yc)] = ARS_VERMELHO if ((xx - x0) // (2 * s)) % 2 == 0 else 0xFFFFFF
    for kk in range(1, 4 * s):
        pix[(x0 + 4 * s - (1 if kk > 2 * s else 0), yc + kk)] = ARS_VERMELHO if (kk // s) % 2 else 0xFFFFFF
    for (x, y), c in pix.items():
        if 0 <= x < w and 0 <= y < ph:
            px[y * w + x] = c


class ComCanhao:
    """O Clawd de cachecol com o canhão do Arsenal, mais o que vem junto: bala, fumaça, faíscas, BUM!, placar,
    caixa de texto de Pokémon e plantão. A cena define c (escala do canhão), sc (do Clawd), chao, g (gravidade),
    can, can_alvo, bala, disparo, parts, onomato, faixa, caixa, festa_ate, passo, placar e manchetes()."""
    cor_respingo = 0xA8B4C0

    def pivo(self):
        k = self.can
        return k["x"] + k["recuo"] + 0.5 * self.c, self.chao - 6.2 * self.c

    def boca(self, ang=None):
        ang = self.can["ang"] if ang is None else ang
        x, y = self.pivo()
        return x + 17 * self.c * math.cos(ang), y + 17 * self.c * math.sin(ang)

    def mirar(self, tx, ty, T):
        ang = self.can["ang"]
        for _ in range(3):
            bx, by = self.boca(ang)
            vx, vy = (tx - bx) / T, (ty - by - 0.5 * self.g * T * T) / T
            ang = max(-1.3, min(0.0, math.atan2(vy, vx)))
        return ang, vx, vy

    def trazer_canhao(self):
        k = self.can
        while k["x"] < self.can_alvo:
            dx = min(self.can_alvo - k["x"], 12 * self.c * self.dt)
            k["x"] += dx
            k["giro"] += dx / (4.6 * self.c)
            self.passo = int(self.t * 6) % 2 == 0
            yield
        self.passo = False

    def atirar(self, alvo, tipo, T=None):
        """Gira o cano pra alvo(t_impacto) -> (x, y), o Clawd acende o pavio e dispara (não espera a bala cair)."""
        k = self.can
        T = T or random.uniform(0.85, 1.05)
        ang, _, _ = self.mirar(*alvo(self.t + 1.8 + T), T)
        a0, ini = k["ang"], self.t
        while self.t - ini < 1.0:
            k["ang"] = a0 + (ang - a0) * suave((self.t - ini) / 1.0)
            yield
        ini = self.t
        while self.t - ini < 0.8:  # o Clawd acende o pavio
            px_, py_ = self.pivo()
            c, s = math.cos(k["ang"]), math.sin(k["ang"])
            fx, fy = px_ - 5 * self.c * c + 2.2 * self.c * s, py_ - 5 * self.c * s - 2.2 * self.c * c
            for _ in range(2):
                self.parts.append([fx, fy, random.uniform(-14, 14), random.uniform(-22, -4),
                                   random.choice((0xFFF2A0, 0xFFB040, 0xFF6020)), self.t, random.uniform(0.2, 0.45),
                                   "faisca"])
            yield
        k["ang"], vx, vy = self.mirar(*alvo(self.t + T), T)
        bx, by = self.boca()
        self.bala = dict(x=bx, y=by, vx=vx, vy=vy, tipo=tipo)
        self.disparo = self.t
        self.onomato.append(("BUM!", bx + 4 * self.c, by - 6 * self.c, self.t, 0xFFE040))
        for _ in range(26):
            a = k["ang"] + random.uniform(-0.6, 0.6)
            sp = random.uniform(8, 34)
            self.parts.append([bx, by, math.cos(a) * sp, math.sin(a) * sp - 4, 0x9A9298, self.t,
                               random.uniform(1.0, 2.0), "fumaca"])

    def recuar(self):
        """O tranco do canhão logo depois do tiro (a roda gira pra trás e volta)."""
        k = self.can
        p = self.t - self.disparo
        recuo = -3 * self.c * (p / 0.06 if p < 0.06 else 1 - suave((p - 0.06) / 0.8)) if p < 0.9 else 0.0
        k["giro"] += (recuo - k["recuo"]) / (4.6 * self.c)
        k["recuo"] = recuo

    def atualizar_bala(self, dt):
        b = self.bala
        if not b:
            return
        t = self.t
        b["vy"] += self.g * dt
        b["x"] += b["vx"] * dt
        b["y"] += b["vy"] * dt
        if random.random() < 0.6:
            self.parts.append([b["x"], b["y"], 0.0, 0.0, 0x8A8E96, t, 0.5, "fumaca"])
        self.colidir(b)
        if self.bala is None:
            return
        chao = self.solo(b["x"])
        if b["y"] >= chao - 1.5 and b["vy"] > 0:
            for _ in range(10):
                self.parts.append([b["x"], chao - 1.0, random.uniform(-20, 20), random.uniform(-30, -10),
                                   self.cor_respingo, t, 0.5, "respingo"])
            self.bala = None
        elif b["x"] > self.w + 6 or b["x"] < -6 or b["y"] < -self.ph:
            self.bala = None

    def solo(self, x):
        """Altura onde a bala para (chão ou água) naquele x."""
        return self.chao

    def colidir(self, b):
        pass

    def segmento(self, px, x0, y0, x1, y1, r, cor):
        w, ph = self.w, self.ph
        dx, dy = x1 - x0, y1 - y0
        L2 = dx * dx + dy * dy or 1.0
        for y in range(max(0, int(min(y0, y1) - r)), min(ph, int(max(y0, y1) + r) + 1)):
            for x in range(max(0, int(min(x0, x1) - r)), min(w, int(max(x0, x1) + r) + 1)):
                q = clamp(((x + 0.5 - x0) * dx + (y + 0.5 - y0) * dy) / L2)
                if (x + 0.5 - x0 - q * dx) ** 2 + (y + 0.5 - y0 - q * dy) ** 2 <= r * r:
                    px[y * w + x] = cor

    def desenhar_canhao(self, px):
        """Canhão de bronze numa carreta vermelha do Arsenal, com bandeirinha na ponta."""
        w, ph, c, k = self.w, self.ph, self.c, self.can
        x = k["x"] + k["recuo"]
        if x < -25 * c:
            return
        pvx, pvy = self.pivo()
        cx, cy = x - 12 * c, self.chao - 1.2 * c
        self.segmento(px, pvx, pvy + 1.5 * c, cx, cy, 1.6 * c, 0x9A1A14)
        self.segmento(px, pvx, pvy + 1.5 * c, cx, cy, 0.5 * c, 0xC8281C)
        mx = pvx - 4 * c
        topo = self.chao - 15 * c
        self.segmento(px, mx, self.chao - 3 * c, mx, topo, 0.4, 0xD8D8D8)
        for yy in range(int(topo), int(topo + 3.5 * c) + 1):
            alto = (yy - topo) / (3.5 * c)
            larg = 6 * c * (1 - abs(alto - 0.5) * 0.8)
            for xx in range(int(mx - larg), int(mx)):
                onda = math.sin(self.t * 7 + xx * 0.6) * 0.6
                if 0 <= xx < w and 0 <= yy + int(onda) < ph:
                    px[(yy + int(onda)) * w + xx] = 0xFFFFFF if alto < 0.18 or alto > 0.82 else ARS_VERMELHO
        ca, sa = math.cos(k["ang"]), math.sin(k["ang"])
        for y in range(max(0, int(pvy - 19 * c)), min(ph, int(pvy + 8 * c))):
            for xx in range(max(0, int(pvx - 9 * c)), min(w, int(pvx + 19 * c))):
                lx, ly = xx + 0.5 - pvx, y + 0.5 - pvy
                a, b = (lx * ca + ly * sa) / c, (-lx * sa + ly * ca) / c
                if -5 <= a <= 17:
                    r = 2.3 - 0.7 * (a + 5) / 22 + (0.5 if a > 15.6 else 0.4 if -1 < a < 0.2 or a < -4.2 else 0)
                    if abs(b) <= r:
                        px[y * w + xx] = 0xF4D98A if b < -0.35 * r else 0xC9A24A if b < 0.4 * r else 0x8E6E2C
                        continue
                if math.hypot(a + 6, b) <= 1.3:
                    px[y * w + xx] = 0xC9A24A
        wx, wy, rr = x, self.chao - 4.6 * c, 4.6 * c
        for y in range(max(0, int(wy - rr)), min(ph, int(wy + rr) + 1)):
            for xx in range(max(0, int(wx - rr)), min(w, int(wx + rr) + 1)):
                dx, dy = xx + 0.5 - wx, y + 0.5 - wy
                d = math.hypot(dx, dy)
                if d > rr:
                    continue
                if d > rr - 0.6 * c:
                    px[y * w + xx] = 0x26262A
                elif d > rr - 1.4 * c:
                    px[y * w + xx] = 0x5A3A1E
                elif d < 1.1 * c:
                    px[y * w + xx] = 0xC9A24A
                else:
                    a = (math.atan2(dy, dx) - k["giro"]) % (math.pi / 4)
                    if min(a, math.pi / 4 - a) * d < 0.55 * c:
                        px[y * w + xx] = 0x7A4A22

    def desenhar_clawd(self, px):
        """O Clawd de cachecol, empurrando e operando o canhão."""
        s, t = self.sc, self.t
        pulo = int(abs(math.sin(t * 7)) * 4 * s) if t < self.festa_ate else 0
        self.clawd_x = int(self.can["x"] + self.can["recuo"] - 13 * self.c - 18 * s)
        self.clawd_y = self.chao - 10 * s - pulo
        pintar_clawd(px, self.w, self.ph, self.clawd_x, self.clawd_y, s, t, self.passo)

    def desenhar_bala(self, px):
        w, ph, b = self.w, self.ph, self.bala
        if not b:
            return
        r = max(1.2, 1.4 * self.c)
        for y in range(int(b["y"] - r), int(b["y"] + r) + 1):
            for x in range(int(b["x"] - r), int(b["x"] + r) + 1):
                if 0 <= x < w and 0 <= y < ph and (x + 0.5 - b["x"]) ** 2 + (y + 0.5 - b["y"]) ** 2 <= r * r:
                    px[y * w + x] = 0x6A6E76 if x < b["x"] - r * 0.3 and y < b["y"] - r * 0.3 else 0x1C1C20

    def desenhar_parts(self, px, dt):
        w, ph, t = self.w, self.ph, self.t
        vivas = []
        for p in self.parts:
            idade = (t - p[5]) / p[6]
            if idade >= 1:
                continue
            vivas.append(p)
            tipo = p[7]
            if tipo == "fumaca":
                p[2] *= 1 - 1.5 * dt
                p[3] = p[3] * (1 - 1.5 * dt) - 6 * dt
            elif tipo == "bolha":  # sobe sem gravidade
                p[2] = math.sin((t - p[5]) * 9 + p[0]) * 4
            elif tipo == "pena":  # cai devagar, balançando
                p[2] = math.sin((t - p[5]) * 5 + p[1]) * 9
                p[3] += (12 - p[3]) * min(1.0, dt * 3)
            else:
                p[3] += (40 if tipo == "faisca" else 90) * dt
            p[0] += p[2] * dt
            p[1] += p[3] * dt
            if tipo == "fumaca":
                r = 1 + idade * 3 * self.c
                a = 0.55 * (1 - idade)
                for yy in range(max(0, int(p[1] - r)), min(ph, int(p[1] + r) + 1)):
                    for xx in range(max(0, int(p[0] - r)), min(w, int(p[0] + r) + 1)):
                        if (xx - p[0]) ** 2 + (yy - p[1]) ** 2 <= r * r:
                            px[yy * w + xx] = misturar(px[yy * w + xx], p[4], a)
            elif 0 <= int(p[0]) < w and 0 <= int(p[1]) < ph:
                px[int(p[1]) * w + int(p[0])] = p[4]
        self.parts = vivas

    def desenhar_letreiros(self, px):
        w, ph, t = self.w, self.ph, self.t
        esc = 2 if ph >= 80 else 1
        vivos = []
        for o in self.onomato:
            txt, x, y, t0, cor = o
            if t - t0 < 0.9:
                vivos.append(o)
                e = 1 if txt.startswith(("PFF", "PUF", "TSS", "NHAC", "TOC", "TUM", "POF")) else esc
                letreiro(px, w, ph, txt, max(3 * len(txt) * e, min(w - 3 * len(txt) * e, x)),
                         max(4 * e, y - (t - t0) * 6), e, cor, 0x1C1C1C if cor == 0xFFFFFF else ARS_VERMELHO)
        self.onomato = vivos
        if self.faixa:
            txt, t0 = self.faixa
            p = t - t0
            if p > 4.0:
                self.faixa = None
            elif p > 0.6 or int(p * 10) % 2:
                e = esc_letreiro(txt, w * 0.9, 3)
                letreiro(px, w, ph, txt, w / 2, 4 + 3 * e, e, ARS_VERMELHO, 0xFFFFFF)

    def desenhar_caixa(self, ch, co):
        """Caixa de texto de Pokémon (GBA): o GAGO lembrou do Ferguson!"""
        if not self.caixa:
            return
        w, h = self.w, self.h
        l1, l2, t0 = self.caixa
        larg = min(w - 4, max(len(l1), len(l2)) + 6)
        x0, y0 = (w - larg) // 2, h - 6
        n = int((self.t - t0) * 30)
        borda, papel, tinta = 0x5878A8, 0xF8F8F8, 0x383838
        chip(ch, co, w, h, x0, y0, "╭" + "─" * (larg - 2) + "╮", borda, papel)
        for k, l in enumerate((l1[:n], l2[:max(0, n - len(l1))])):
            chip(ch, co, w, h, x0, y0 + 1 + k, "│ " + l.ljust(larg - 4) + " │", tinta, papel)
            escrever(ch, co, w, h, x0, y0 + 1 + k, "│", fundo(borda, papel))
            escrever(ch, co, w, h, x0 + larg - 1, y0 + 1 + k, "│", fundo(borda, papel))
        chip(ch, co, w, h, x0, y0 + 3, "╰" + "─" * (larg - 2) + "╯", borda, papel)
        if n > len(l1) + len(l2) and int(self.t * 3) % 2:
            escrever(ch, co, w, h, x0 + larg - 3, y0 + 2, "▼", fundo(0xE04040, papel))

    def desenhar_plantao(self, ch, co):
        """Letreiro de notícias passando lá embaixo."""
        w, h, t = self.w, self.h, self.t
        manchetes = self.manchetes()
        txt = "   ●   ".join(manchetes) + "   ●   "
        x = chip(ch, co, w, h, 0, h - 1, " PLANTÃO ", 0xFFFFFF, ARS_VERMELHO)
        off = int(t * 9) % len(txt)
        faixa = (txt[off:] + txt)[:max(0, w - x)]
        chip(ch, co, w, h, x, h - 1, " " + faixa[:-1], 0xE8E8E8, 0x16181C)


class Gago(ComCanhao, Cena):
    """O Gago, amigo torcedor do United, em forma de Snorlax, vira balão de parada amarrado em Old Trafford,
    debaixo da chuva de Manchester. Provoca, provoca... até o Clawd chegar empurrando o canhão do Arsenal."""
    combinavel = False
    peso = 0.8
    duracao = (50, 70)
    NOME = "GAGO"  # o apelido dele, que aparece na caixa de texto de Pokémon
    PROVOCA = ["Glory glory Man United!", "20 títulos ingleses, e vocês?", "Cadê a Champions de vocês?",
               "Sir Alex, volta!", "Esse ano é nosso, confia.", "Teatro dos Sonhos, meu filho!", "Treble de 99!",
               "Vocês amarelam em abril!", "Siiiiu!"]
    QUICOU = ["Volta pro Emirates!", "Vocês são só isso?"]
    ERROU = ["Errou! Igual o Arsenal em abril.", "Passou longe!", "Mira torta, hein?"]
    ESTOUROU = ["NÃÃÃO!", "Safado!", "Chama o VAR!", "Isso é inveja!"]
    CLAWD_FALA = ["Up the Arsenal!", "Fica paradinho aí...", "North London is red!", "Esse é pra você.",
                  "Segura essa, Red Devil."]
    CLAWD_FESTA = ["Gooooner!", "Manchester é vermelha? Só se for de vergonha.", "Up the Arsenal!"]
    VOLTA = [("ouviu Glory Glory Man United!", "encheu de novo!"), ("lembrou do Ferguson!", "estufou o peito!"),
             ("viu o replay de 99!", "inflou de orgulho!"), ("ouviu o Teatro dos Sonhos cantar!", "voltou pro lugar!")]

    def iniciar(self):
        w, h = self.w, self.h
        ph = self.ph = 2 * h
        self.chao = ph - 6
        self.R = max(7.0, min(ph * 0.17, w * 0.11))
        self.c = max(0.6, self.R / 10)
        self.g = ph * 1.0
        self.topo = int(self.chao - ph * 0.24)
        self.ancora = (w * 0.68, float(self.topo))
        self.corda = ph * 0.1
        self.cache = {}
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * ph)
        self.t = 0.0
        x, y, a = self.pos_flutuando(0.0)
        self.gago = dict(x=x, y=y, ang=a, s=1.0, larga=1.0, achata=1.0, estado="flutuando", desde=0.0,
                          cara="acordado", bracos=0.0, braco_alvo=0.0, curativos=[], amarrado=True, h=0.0,
                          buraco=(0.0, 0.0), tremor=-10.0, de=(x, y, 1.0, 1.0, 1.0))
        self.sc = max(1, round(self.c * 0.9))  # escala do Clawd
        self.can_alvo = max(w * 0.22, 13 * self.c + 18 * self.sc + 4)
        self.can = dict(x=-30 * self.c, ang=-0.25, giro=0.0, recuo=0.0)
        self.passo = False
        self.bala = None
        self.disparo = -10.0
        self.parts = []          # [x, y, vx, vy, cor, t0, vida, tipo]
        self.chuva = [[random.uniform(0, w * 1.3), random.uniform(0, ph), random.uniform(0.8, 1.25)]
                      for _ in range(max(40, w * ph // 55))]
        self.gotas = []          # a goteira do telhado caindo no balde
        self.prox_gota = 0.0
        self.baldes = random.randint(3, 9)
        self.relampago = None
        self.falas = {}          # quem -> (texto, t0)
        self.caixa = None        # [linha1, linha2, t0]
        self.onomato = []        # (texto, x, y, t0, cor)
        self.faixa = None        # (texto, t0)
        self.festa_ate = -10.0
        self.placar = 0
        self.gen = self.roteiro()

    # --- cenário

    def montar_fundo(self):
        w, ph, chao, topo = self.w, self.ph, self.chao, self.topo
        P = 2 * w  # as nuvens se repetem a cada 2 telas, pra rolar sem emenda
        self.ceu = []
        for y in range(chao):
            f = y / max(1, chao - 1)
            base = misturar(0x262B33, 0x6E7680, f)
            linha = []
            for x in range(3 * w):
                a = 2 * math.pi * x / P
                n = 0.22 * math.sin(a * 3 + y * 0.09) + 0.16 * math.sin(a * 7 - y * 0.17 + 1.3) + \
                    0.12 * math.sin(a * 13 + y * 0.31)
                linha.append(misturar(base, 0x3A4048 if n < 0 else 0x9AA2AC, abs(n) * 0.9 * (1 - f * 0.6)))
            self.ceu.append(linha)
        fixo = {}
        # Manchester ao fundo: casinhas de tijolo geminadas e as chaminés das fábricas
        x = 0
        while x < w:
            larg, alt = random.randint(6, 14), random.uniform(0.05, 0.11) * ph
            for xx in range(x, min(w, x + larg)):
                telhado = alt + (larg / 2 - abs(xx - x - larg / 2)) * 0.5
                for yy in range(int(chao - telhado), chao):
                    janela = (yy - int(chao - telhado)) % 5 == 2 and (xx - x) % 4 == 1 and random.random() < 0.3
                    fixo[(xx, yy)] = 0xE0B060 if janela else 0x3A3F47
            if random.random() < 0.3:
                cx, ch_alt = x + larg // 2, random.uniform(0.18, 0.3) * ph
                for yy in range(int(chao - ch_alt), chao):
                    for xx in (cx, cx + 1):
                        if 0 <= xx < w:
                            fixo[(xx, yy)] = 0x30343B
            x += larg + random.randint(0, 3)
        # Old Trafford: fachada de tijolo, a faixa do telhado com o nome e os mastros da cobertura
        x0 = int(w * 0.36)
        fh = max(7, int(ph * 0.07))
        self.faixa_y = topo + fh
        for xx in range(x0, w):
            for yy in range(topo, chao):
                if yy < topo + fh:
                    c = 0xC4C8CC if yy > topo else 0x5A5E64
                elif (xx - x0) % 9 == 0:
                    c = 0x5E1A15
                elif (yy - topo - fh) % 7 in (3, 4) and (xx - x0) % 9 not in (0, 1, 8) and yy < chao - 5:
                    c = 0x3A4450
                else:
                    c = 0x7A231C
                fixo[(xx, yy)] = c
        larg_est = w - x0
        for txt in ("MANCHESTER UNITED", "MAN UNITED", "UNITED"):
            if 6 * len(txt) - 1 <= larg_est - 6:
                break
        nome = [0] * (w * ph)
        letreiro(nome, w, ph, txt, x0 + larg_est / 2, topo + fh / 2 + 0.5, 1, MU_VERMELHO)
        for m in range(x0 + 4, w, max(18, int(w * 0.13))):
            topo_m = int(topo - ph * 0.09)
            for yy in range(topo_m, topo):
                fixo[(m, yy)] = 0xD0D4D8
            for alvo in (m - 8, m + 8):
                for k in range(9):
                    xx, yy = int(m + (alvo - m) * k / 8), int(topo_m + (topo - topo_m) * k / 8)
                    if x0 <= xx < w:
                        fixo[(xx, yy)] = 0xA8ACB2
        # o balde da goteira na calçada
        self.balde_x = int(x0 + larg_est * 0.22)
        for xx in range(self.balde_x - 2, self.balde_x + 3):
            for yy in range(chao - 3, chao):
                fixo[(xx, yy)] = 0x2A6AC8 if yy > chao - 3 else 0x4A8AE0
        # chão molhado, com poças refletindo o céu
        for yy in range(chao, ph):
            for xx in range(w):
                poca = math.sin(xx * 0.11 + yy * 1.7) + math.sin(xx * 0.037 - yy) > 1.3
                fixo[(xx, yy)] = 0x5A626C if poca else misturar(0x24272C, 0x34383E, (yy - chao) / 6)
        self.frente = [(y * w + x, nome[y * w + x] or c) for (x, y), c in fixo.items() if 0 <= x < w and 0 <= y < ph]
        return fixo

    # --- o balão

    def pos_flutuando(self, t):
        """Centro e inclinação do balão amarrado, balançando na corda."""
        ax, ay = self.ancora
        a = 0.12 * math.sin(t * 0.6) + 0.05 * math.sin(t * 1.7 + 1.0)
        L = self.corda + 1.05 * self.R
        return ax + math.sin(a) * L, ay - math.cos(a) * L + math.sin(t * 1.1) * 1.2, a

    def escalas(self):
        g, t = self.gago, self.t
        sx, sy = g["s"] * g["larga"], g["s"] * g["achata"]
        p = t - g["tremor"]
        if p < 1.5:
            k = 0.16 * math.sin(p * 26) * math.exp(-p * 3.5)
            sx, sy = sx * (1 + k), sy * (1 - k)
        return sx, sy

    def local(self, x, y):
        """Ponto da tela -> (u, v) no corpo do balão."""
        g = self.gago
        sx, sy = self.escalas()
        dx, dy = x - g["x"], y - g["y"]
        c, s = math.cos(g["ang"]), math.sin(g["ang"])
        return (dx * c + dy * s) / (self.R * sx), (-dx * s + dy * c) / (self.R * sy)

    def mundo(self, u, v):
        g = self.gago
        sx, sy = self.escalas()
        lx, ly = u * self.R * sx, v * self.R * sy
        c, s = math.cos(g["ang"]), math.sin(g["ang"])
        return g["x"] + lx * c - ly * s, g["y"] + lx * s + ly * c

    def falar(self, txt, quem="gago"):
        self.falas[quem] = (txt, self.t)

    # --- roteiro

    def roteiro(self):
        g = self.gago
        yield from self.esperar(random.uniform(2.0, 3.5))
        while True:
            yield from self.esperar(random.uniform(2.5, 5.0))
            for _ in range(random.choice((1, 2, 2, 3))):
                g["cara"], g["braco_alvo"] = "rindo", 1.0
                self.falar(random.choice(self.PROVOCA))
                yield from self.esperar(2.8)
            g["cara"], g["braco_alvo"] = "acordado", 0.0
            if self.can["x"] < self.can_alvo:
                yield from self.trazer_canhao()
            self.falar(random.choice(self.CLAWD_FALA), "clawd")
            yield from self.esperar(1.4)
            tiros = random.choice((["estoura"], ["quica", "estoura"], ["erra", "estoura"], ["erra", "quica", "estoura"]))
            for tipo in tiros:
                yield from self.disparar(tipo)
                if tipo != "estoura":
                    yield from self.esperar(0.6)
                    g["cara"], g["braco_alvo"] = "rindo", 1.0
                    self.falar(random.choice(self.QUICOU if tipo == "quica" else self.ERROU))
                    yield from self.esperar(2.4)
                    g["cara"], g["braco_alvo"] = "acordado", 0.0
            while g["estado"] != "murcho":
                yield
            yield from self.esperar(2.0)
            acao, efeito = random.choice(self.VOLTA)
            self.caixa = [f"{self.NOME} {acao}", "", self.t]
            yield from self.esperar(2.2)
            g["cara"] = "acordado"
            l1 = f"{self.NOME} {acao}"
            self.caixa = [l1, f"{self.NOME} {efeito}", self.t - len(l1) / 30]
            self.mudar(g, "enchendo")
            yield from self.esperar(3.2)
            self.caixa = None
            self.mudar(g, "subindo")
            while g["estado"] != "flutuando":
                yield

    def mudar(self, g, estado):
        g["estado"], g["desde"] = estado, self.t
        g["de"] = (g["x"], g["y"], g["s"], g["larga"], g["achata"])

    def disparar(self, tipo):
        R = self.R

        def alvo(t_imp):
            x, y, _ = self.pos_flutuando(t_imp)
            if tipo == "erra":
                return x - R * 0.2, y - 2.4 * R
            return x - R * 0.35, y + R * 0.15

        yield from self.atirar(alvo, tipo)
        self.gago["cara"] = "assustado"
        while self.bala:
            yield

    # --- atualização

    def atualizar(self, dt):
        t, w, ph = self.t, self.w, self.ph
        self.recuar()
        self.atualizar_bala(dt)
        self.atualizar_gago(dt)
        g = self.gago
        g["bracos"] += (g["braco_alvo"] - g["bracos"]) * min(1.0, dt * 6)
        for d in self.chuva:
            v = ph * 0.9 * d[2]
            d[1] += v * dt
            d[0] -= v * 0.25 * dt
            if d[1] >= self.chao:
                if random.random() < 0.12:
                    self.parts.append([d[0], self.chao - 0.5, random.uniform(-8, 8), random.uniform(-14, -6),
                                       0xA8B4C0, t, 0.25, "respingo"])
                d[0], d[1] = random.uniform(0, w * 1.3), random.uniform(-6, 0)
        if t >= self.prox_gota:
            self.gotas.append([self.balde_x + 0.5, float(self.faixa_y), 0.0])
            self.prox_gota = t + random.uniform(0.5, 1.1)
        vivas = []
        for gt in self.gotas:
            gt[2] += self.g * 0.5 * dt
            gt[1] += gt[2] * dt
            if gt[1] < self.chao - 3:
                vivas.append(gt)
            elif random.random() < 0.02:
                self.baldes += 1
        self.gotas = vivas
        if self.relampago is None and g["estado"] == "flutuando" and random.random() < dt / 18:
            x = random.uniform(w * 0.1, w * 0.9)
            pts = [(x, 0.0)]
            while pts[-1][1] < ph * 0.35:
                pts.append((pts[-1][0] + random.uniform(-5, 5), pts[-1][1] + random.uniform(2, 5)))
            self.relampago = (t, pts)
        elif self.relampago and t - self.relampago[0] > 0.3:
            self.relampago = None

    def colidir(self, b):
        t = self.t
        g = self.gago
        if b["tipo"] in ("quica", "estoura") and g["estado"] == "flutuando":
            u, v = self.local(b["x"], b["y"])
            if gago_em(u, v) is not None:
                if b["tipo"] == "quica":
                    b["vx"], b["vy"], b["tipo"] = -abs(b["vx"]) * 0.45, -abs(b["vy"]) * 0.2 - 25, "volta"
                    g["tremor"] = t
                    self.onomato.append(("BOING!", b["x"] - 4, b["y"] - 8, t, 0xFFFFFF))
                else:
                    self.estourar(u, v)
                    b["vx"], b["vy"], b["tipo"] = b["vx"] * 0.3, b["vy"] * 0.3, "passou"

    def estourar(self, u, v):
        g, t = self.gago, self.t
        self.placar += 1
        g["buraco"] = (max(-0.7, min(0.7, u)), max(-0.45, min(0.6, v)))
        g["h"], g["amarrado"], g["cara"], g["braco_alvo"] = -0.6, False, "assustado", 1.0
        self.mudar(g, "estourando")
        self.falar(random.choice(self.ESTOUROU))
        self.faixa = (f"ARSENAL {self.placar} X 0 UNITED", t)
        self.festa_ate = t + 3.5
        self.falar(random.choice(self.CLAWD_FESTA), "clawd")

    def atualizar_gago(self, dt):
        g, t, R = self.gago, self.t, self.R
        e, p = g["estado"], t - g["desde"]
        if e == "flutuando":
            g["x"], g["y"], g["ang"] = self.pos_flutuando(t)
        elif e == "estourando":
            g["h"] += (math.sin(t * 5.3) * 3 + random.uniform(-6, 6)) * dt
            sp = R * 6 * (1 - 0.4 * min(1.0, p / 2.6))
            vx, vy = math.cos(g["h"]) * sp, math.sin(g["h"]) * sp
            if (g["x"] < self.w * 0.3 and vx < 0) or (g["x"] > self.w - R and vx > 0):
                g["h"] = math.pi - g["h"]
            if (g["y"] < R * 1.2 and vy < 0) or (g["y"] > self.chao - 1.6 * R and vy > 0):
                g["h"] = -g["h"]
            g["x"] += vx * dt
            g["y"] += vy * dt
            g["ang"] += 8 * dt
            g["s"] = 1 - 0.45 * min(1.0, p / 2.6)
            hx, hy = self.mundo(*g["buraco"])
            if random.random() < 0.8:
                self.parts.append([hx, hy, -vx * 0.6 + random.uniform(-10, 10), -vy * 0.6 + random.uniform(-10, 10),
                                   0xE8ECF0, t, 0.5, "fumaca"])
            if int(t * 8) % 3 == 0 and not any(o[0] == "PFFFRRRT!" and t - o[3] < 0.5 for o in self.onomato):
                self.onomato.append(("PFFFRRRT!", g["x"], g["y"] - 1.6 * R * g["s"], t, 0xFFFFFF))
            if p > 2.6:
                g["vy"] = 0.0
                g["cara"], g["braco_alvo"] = "murcho", 0.0
                self.mudar(g, "caindo")
        elif e == "caindo":
            g["vy"] = min(g["vy"] + self.ph * 0.6 * dt, self.ph * 0.35)
            g["y"] += g["vy"] * dt
            g["x"] += math.sin(t * 4) * R * 1.5 * dt
            g["ang"] = (g["ang"] + math.pi) % (2 * math.pi) - math.pi
            g["ang"] -= g["ang"] * min(1.0, dt * 3)
            if g["y"] + 1.18 * R * g["s"] >= self.chao:
                g["ang"] = 0.0
                self.mudar(g, "murcho")
        elif e == "murcho":
            q = suave(p / 0.25)
            g["achata"], g["larga"] = 1 - 0.62 * q, 1 + 0.35 * q
            g["y"] = self.chao - 1.18 * R * g["s"] * g["achata"]
        elif e == "enchendo":
            q = suave(p / 3.0)
            _, _, s0, l0, a0 = g["de"]
            g["s"], g["larga"], g["achata"] = s0 + (1 - s0) * q, l0 + (1 - l0) * q, a0 + (1 - a0) * q
            g["y"] = self.chao - 1.18 * R * g["s"] * g["achata"]
        elif e == "subindo":
            q = suave(p / 3.0)
            x0, y0 = g["de"][:2]
            tx, ty, ta = self.pos_flutuando(t)
            g["x"], g["y"], g["ang"] = x0 + (tx - x0) * q, y0 + (ty - y0) * q, ta * q
            if p >= 3.0:
                g["amarrado"] = True
                g["curativos"] = (g["curativos"] + [g["buraco"]])[-5:]
                self.falar("O Gago tá de volta!")
                self.mudar(g, "flutuando")

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        self.atualizar(dt)
        w, h, ph = self.w, self.h, self.ph
        px = self.px
        off = int(t * 2.5) % (2 * w)
        for y in range(self.chao):
            px[y * w:(y + 1) * w] = self.ceu[y][off:off + w]
        px[self.chao * w:] = [0] * (w * (ph - self.chao))
        self.desenhar_relampago(px)
        for i, c in self.frente:
            px[i] = c
        for x, y, _ in self.gotas:
            if 0 <= int(y) < ph:
                px[int(y) * w + int(x)] = 0x9AC0E8
        self.desenhar_corda(px)
        self.desenhar_gago(px)
        self.desenhar_canhao(px)
        self.desenhar_clawd(px)
        self.desenhar_bala(px)
        self.desenhar_parts(px, dt)
        self.desenhar_chuva(px)
        self.desenhar_letreiros(px)
        pixels_para_celulas(px, w, h, ch, co)
        for quem, (txt, t0) in list(self.falas.items()):
            if t - t0 > 3.0:
                del self.falas[quem]
                continue
            if quem == "gago":
                x, y = self.mundo(0, -1.65)
            else:
                x, y = self.clawd_x + 9 * self.sc, self.clawd_y
            balao(ch, co, w, h, int(x), int(y) // 2 - 1, txt, int((t - t0) * 30))
        self.desenhar_caixa(ch, co)
        self.desenhar_plantao(ch, co)

    def desenhar_relampago(self, px):
        if not self.relampago:
            return
        w, t0, pts = self.w, *self.relampago
        p = self.t - t0
        if p < 0.08 or 0.15 < p < 0.21:
            for i in range(self.chao * w):
                px[i] = misturar(px[i], 0xD8E0F0, 0.35)
            for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
                for k in range(6):
                    x, y = int(x0 + (x1 - x0) * k / 6), int(y0 + (y1 - y0) * k / 6)
                    if 0 <= x < w and 0 <= y < self.chao:
                        px[y * w + x] = 0xF4F6FF

    def desenhar_corda(self, px):
        w, ph, g = self.w, self.ph, self.gago
        ax, ay = self.ancora
        if g["amarrado"]:
            x1, y1 = self.mundo(0, 1.05)
            cx, cy = (ax + x1) / 2, (ay + y1) / 2 + 2
        else:  # a corda arrebentada fica pendurada no telhado
            L = self.corda * 0.7
            x1, y1 = ax + math.sin(self.t * 2) * 2, ay - L
            cx, cy = ax + math.sin(self.t * 2 - 0.6), ay - L * 0.5
        n = int(abs(y1 - ay) + abs(x1 - ax)) + 2
        for k in range(n + 1):
            q = k / n
            x = (1 - q) ** 2 * ax + 2 * (1 - q) * q * cx + q * q * x1
            y = (1 - q) ** 2 * ay + 2 * (1 - q) * q * cy + q * q * y1
            if 0 <= int(x) < w and 0 <= int(y) < ph:
                px[int(y) * w + int(x)] = 0xD8D0BC

    def desenhar_gago(self, px):
        w, ph, g, R = self.w, self.ph, self.gago, self.R
        sx, sy = self.escalas()
        ang = g["ang"]
        chave = (g["cara"], round(g["bracos"], 1), round(sx, 2), round(sy, 2), round(ang, 2 if g["estado"] == "flutuando" else 1), tuple(g["curativos"]))
        pix = self.cache.get(chave)
        if pix is None:
            if len(self.cache) > 96:
                self.cache.clear()
            ca, sa = math.cos(ang), math.sin(ang)
            Rx, Ry = R * sx, R * sy
            if abs(ang) < 0.02:
                xs, ys = range(int(-1.25 * Rx) - 1, int(1.25 * Rx) + 2), range(int(-1.66 * Ry) - 1, int(1.22 * Ry) + 2)
            else:
                r = int(1.75 * R * max(sx, sy)) + 1
                xs = ys = range(-r, r + 1)
            pix = []
            for dy in ys:
                for dx in xs:
                    c = gago_em(((dx + 0.5) * ca + (dy + 0.5) * sa) / Rx, (-(dx + 0.5) * sa + (dy + 0.5) * ca) / Ry,
                                 g["cara"], g["bracos"], g["curativos"])
                    if c is not None:
                        pix.append((dx, dy, c))
            self.cache[chave] = pix
        x0, y0 = int(g["x"]), int(g["y"])
        for dx, dy, c in pix:
            x, y = x0 + dx, y0 + dy
            if 0 <= x < w and 0 <= y < ph:
                px[y * w + x] = c
        if g["s"] * min(sx, sy) > 0.75 and abs(ang) < 0.3:
            for txt in ("UNITED", "MUFC"):
                if 6 * len(txt) - 1 <= 1.55 * R * sx:
                    x, y = self.mundo(0, 0.18)
                    letreiro(px, w, ph, txt, x, y, 1, 0xFFFFFF)
                    break

    def desenhar_chuva(self, px):
        w, ph = self.w, self.ph
        for x, y, _ in self.chuva:
            for k in range(3):
                xx, yy = int(x + k * 0.25), int(y - k)
                if 0 <= xx < w and 0 <= yy < ph:
                    px[yy * w + xx] = misturar(px[yy * w + xx], 0xC8D2DC, 0.45 - 0.12 * k)

    def manchetes(self):
        n = self.placar
        manchetes = ["United completa mais um ano sem Premier League", "United segue brigando pra não cair",
                     "Contratações milionárias do United seguem sem surtir efeito",
                     "United demite o técnico mais uma vez",
                     f"Goteira em Old Trafford: balde trocado {self.baldes} vezes hoje",
                     "Gago é anunciado como novo balão oficial do United",
                     "Torcedor que só cortaria o cabelo quando o United ganhasse 5 seguidas desiste e vai ao barbeiro",
                     "Arsenal lidera; United segue flutuando no meio da tabela"]
        if n:
            manchetes.insert(1, f"Gago murcha pela {n}ª vez" + (" e ganha mais um curativo" if n > 1 else ""))
        return manchetes


