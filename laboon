class Pokemon(Cena):
    """Batalha de Pokémon no estilo FireRed com os sprites oficiais do GBA, na resolução do GBA."""
    combinavel = False
    duracao = (80, 110)
    perfil = "LaboonMini"
    min_px = (240, 160)
    CEU = (0xF8F8E8, 0xE0ECC8)
    PLAT = (0x90B880, 0xB0D498, 0xC4E4AC)
    PAINEL, PAINEL_BORDA, PAINEL_SOMBRA = 0xF8F8D8, 0x404040, 0xC8C8A8
    TEXTO, TEXTO_SOMBRA = 0x404040, 0xD8D0B0
    CAIXA, CAIXA_BORDA, CAIXA_BORDA2 = 0x283848, 0xE0E8F0, 0x506070
    MENU, MENU_BORDA, MENU_BORDA2, MENU_TEXTO, MENU_SOMBRA = 0xF8F8F8, 0x6868A0, 0xC8C8E8, 0x484848, 0xD0D0C8
    BARRA_FUNDO = 0x506058
    HP_CORES = ((0x70F8A8, 0x58D080), (0xF8E038, 0xC8A808), (0xF85838, 0xA84020))

    @classmethod
    def disponivel(cls):
        return len(pokedex()) >= 151

    def iniciar(self):
        w, h = self.w, self.h
        self.k = max(1, min(w // 240, (2 * h) // 160))
        self.vw, self.vh = max(240, w // self.k), max(160, (2 * h) // self.k)
        self.ox, self.oy = (self.vw - 240) // 2, (self.vh - 160) // 2
        self.px = [0] * (self.vw * self.vh)
        fundo_ = []
        c0, c1 = self.CEU
        for y in range(self.vh):
            gy = y - self.oy
            if gy >= 112:
                c = self.CAIXA
            else:
                c = misturar(c0, c1, clamp(gy / 112))
                if gy % 4 == 1:
                    c = misturar(c, 0xFFFFFF, 0.45)
            fundo_.extend([c] * self.vw)
        self.fundo = fundo_
        self.plat = {"i": self.plataforma(176, 61, 58, 12), "j": self.plataforma(74, 116, 70, 16)}
        self.t = self.dt = 0.0
        self.estado_inicial()
        self.gen = self.roteiro()

    def plataforma(self, cx, cy, rx, ry):
        out = []
        for dy in range(-ry - 1, ry + 2):
            for dx in range(-rx - 1, rx + 2):
                e = (dx / rx) ** 2 + (dy / ry) ** 2
                if e <= 1:
                    c = self.PLAT[0] if e > 0.82 else self.PLAT[1] if e > 0.45 else self.PLAT[2]
                    out.append((cx + dx, cy + dy, c))
        return out

    def estado_inicial(self):
        self.lut = None
        self.vis = {"j": False, "i": False}
        self.off = {"j": [0, 0], "i": [0, 0]}
        self.pisca = {"j": False, "i": False}
        self.afunda = {"j": 0, "i": 0}
        self.escala_spr = {"j": 1.0, "i": 1.0}
        self.branco = {"j": 0.0, "i": 0.0}
        self.tinta = {"j": None, "i": None}
        self.plat_off = [0, 0]
        self.painel_off = {"i": 0, "j": 0}
        self.info = {"i": False, "j": False}
        self.hpv = {"j": 0.0, "i": 0.0}
        self.expv = random.uniform(0, 0.7)
        self.menu = None
        self.texto = ["", ""]
        self.seta = False
        self.fx = []
        self.flash = 0.0
        self.escuro = 0.0
        self.cor_fade = 0x000000
        self.cortina = 0.0
        self.balanco = False
        self.bola = None
        self.tremor = 0

    # --- dados da batalha

    def lutador(self, num, nivel, costas):
        if num == 0:
            shiny = random.random() < 0.15
            spr = sprite_rola_gba(shiny)
            golpes = [("HARDEN", 0, 30, "status"), ("SPLASH", 0, 40, "status"), ("TACKLE", 35, 35, "investida"),
                      ("BODY SLAM", 85, 15, "investida")]
            return self.montar_lutador(0, "ROLA", ["NORMAL"], nivel, shiny, spr, golpes, "♂")
        d = pokedex()[num]
        shiny = random.random() < (0.04 if costas else 0.08)
        chave = ("bs" if shiny else "b") if costas else ("fs" if shiny else "f")
        tipos = d["tipos"]
        golpes = []
        forte = nivel >= 25
        for t in tipos[:2]:
            pool = GOLPES.get(t, GOLPES["NORMAL"])
            pool = pool if forte else pool[:max(1, (len(pool) + 1) // 2)]
            golpes.append(random.choice(pool))
        if len(golpes) < 2:
            golpes.append(random.choice(GOLPES[tipos[0]] if tipos[0] in GOLPES else GOLPES["NORMAL"]))
        golpes.append(random.choice(GOLPES["NORMAL"][:5] if not forte else GOLPES["NORMAL"]))
        opcoes = [s for t in tipos for s in STATUS_POR_TIPO.get(t, [])] or STATUS_COMUNS
        if random.random() < 0.4:
            opcoes = STATUS_COMUNS
        st = random.choice(opcoes)
        golpes.append((st, 0, STATUS_GOLPES[st][1], "status"))
        vistos, unicos = set(), []
        for g in golpes:
            if g[0] not in vistos:
                vistos.add(g[0])
                unicos.append(g)
        while len(unicos) < 4:
            g = random.choice(GOLPES["NORMAL"])
            if g[0] not in vistos:
                vistos.add(g[0])
                unicos.append(g)
        unicos = unicos[:4]
        random.shuffle(unicos)
        genero = "" if num in SEM_GENERO else "♂" if num in SO_MACHO else "♀" if num in SO_FEMEA else random.choice("♂♂♀")
        return self.montar_lutador(num, d["nome"], tipos, nivel, shiny, grade_sprite(d[chave]), unicos, genero)

    def montar_lutador(self, num, nome, tipos, nivel, shiny, spr, unicos, genero):
        mx = nivel * 2 + 10 + random.randint(0, nivel // 2 + 3)
        linhas_ = [y for y, l in enumerate(spr) if any(l)]
        cols = [x for x in range(len(spr[0])) if any(l[x] for l in spr)]
        caixa = (min(cols), min(linhas_), max(cols), max(linhas_)) if linhas_ else (0, 0, 63, 63)
        return {"num": num, "nome": nome, "tipos": tipos, "nivel": nivel, "hp": mx, "max": mx, "shiny": shiny,
                "spr": spr, "caixa": caixa, "golpes": unicos, "pp": [g[2] for g in unicos], "genero": genero,
                "status": None, "sono": 0, "conf": 0, "semente": False}

    def tipo_golpe(self, g):
        if g[3] == "status":
            return TIPO_STATUS.get(g[0], "NORMAL")
        for t, lista in GOLPES.items():
            if any(x[0] == g[0] for x in lista):
                return t
        return "NORMAL"

    def nome_b(self, lado):
        return ("Wild " if lado == "i" else "") + self.lut[lado]["nome"]

    def pos(self, lado):
        P = self.lut[lado]
        fundo_spr = P["caixa"][3]
        if lado == "i":
            x, y = 144, 64 - fundo_spr - FLUTUAM.get(P["num"], 0)
        else:
            x, y = 40, 48 + min(16, 63 - fundo_spr)
        ox = self.plat_off[0 if lado == "i" else 1]
        return x + ox + self.off[lado][0], y + self.off[lado][1]

    def centro(self, lado):
        x, y = self.pos(lado)
        x0, y0, x1, y1 = self.lut[lado]["caixa"]
        return x + (x0 + x1) / 2, y + (y0 + y1) / 2

    # --- roteiro (geradores: cada yield é um quadro)

    def roteiro(self):
        while True:
            yield from self.batalha()

    def dizer(self, txt, pausa=1.1):
        linhas = quebrar_gba(txt, 208)
        for k in range(0, len(linhas), 2):
            par = linhas[k:k + 2]
            total = sum(len(l) for l in par)
            ini = self.t
            while True:
                n = int((self.t - ini) * 38)
                resto, vis = n, []
                for l in par:
                    vis.append(l[:max(0, resto)])
                    resto -= len(l)
                self.texto = (vis + ["", ""])[:2]
                if n >= total:
                    break
                yield
            self.seta = True
            yield from self.esperar(pausa)
            self.seta = False
        self.texto = ["", ""]

    def batalha(self):
        self.estado_inicial()
        nj = random.randint(5, 55)
        ni = max(2, min(70, nj + random.randint(-6, 4)))
        jn = random.randint(1, 151)
        inn = random.choice([n for n in range(1, 152) if n != jn]) if random.random() > 0.05 and not OVOS else 0
        self.lut = {"j": self.lutador(jn, nj, True), "i": self.lutador(inn, ni, False)}
        self.hpv = {k: float(v["hp"]) for k, v in self.lut.items()}
        J, I = self.lut["j"], self.lut["i"]
        for _ in range(2):
            self.flash = 1.0
            yield from self.esperar(0.08)
            self.flash = 0.0
            yield from self.esperar(0.08)
        ini = self.t
        while self.t - ini < 0.6:
            self.cortina = (self.t - ini) / 0.6
            yield
        self.cortina = 1.0
        yield from self.esperar(0.25)
        self.cortina = 0.0
        self.vis["i"] = True
        ini = self.t
        while self.t - ini < 1.1:
            p = 1 - suave((self.t - ini) / 1.1)
            self.plat_off = [int(-p * 240), int(p * 240)]
            yield
        self.plat_off = [0, 0]
        yield from self.deslizar_painel("i")
        if I["shiny"]:
            yield from self.brilho_shiny("i")
        yield from self.dizer(f"Wild {I['nome']} appeared!")
        yield from self.dizer(f"Go! {J['nome']}!", pausa=0.2)
        yield from self.lancar_bola()
        yield from self.deslizar_painel("j")
        if J["shiny"]:
            yield from self.brilho_shiny("j")
        while True:
            g = yield from self.escolher()
            ordem = [("j", "i", g), ("i", "j", random.choice(I["golpes"]))]
            if random.random() < 0.3:
                ordem.reverse()
            acabou = False
            for a, d, golpe in ordem:
                yield from self.turno(a, d, golpe)
                if J["hp"] <= 0 or I["hp"] <= 0:
                    acabou = True
                    break
            if not acabou:
                for lado in ("j", "i"):
                    yield from self.fim_de_turno(lado)
                    if J["hp"] <= 0 or I["hp"] <= 0:
                        acabou = True
                        break
            if acabou:
                break
        if I["hp"] <= 0:
            yield from self.desmaiar("i")
            yield from self.dizer(f"Wild {I['nome']} fainted!")
            ganho = random.randint(max(10, ni * 5), max(30, ni * 12))
            yield from self.dizer(f"{J['nome']} gained {ganho} EXP. Points!", pausa=0.2)
            alvo = self.expv + random.uniform(0.25, 0.8)
            while self.expv < min(alvo, 1.0):
                self.expv = min(alvo, 1.0, self.expv + self.dt * 0.6)
                yield
            if alvo >= 1:
                J["nivel"] += 1
                self.expv = 0.0
                yield from self.dizer(f"{J['nome']} grew to LV. {J['nivel']}!")
            yield from self.esperar(0.6)
            self.cor_fade = 0x000000
        else:
            yield from self.desmaiar("j")
            yield from self.dizer(f"{J['nome']} fainted!")
            yield from self.dizer("RED is out of usable POKéMON!")
            yield from self.dizer("RED whited out!")
            self.cor_fade = 0xFFFFFF
        ini = self.t
        while self.t - ini < 0.8:
            self.escuro = (self.t - ini) / 0.8
            yield
        yield from self.esperar(0.5)

    def deslizar_painel(self, lado):
        self.info[lado] = True
        ini = self.t
        while self.t - ini < 0.35:
            p = 1 - suave((self.t - ini) / 0.35)
            self.painel_off[lado] = int(p * 130) * (-1 if lado == "i" else 1)
            yield
        self.painel_off[lado] = 0

    def brilho_shiny(self, lado):
        ini = self.t
        while self.t - ini < 1.3:
            x, y = self.pos(lado)
            self.fx = [("estrela", x + random.uniform(8, 56), y + random.uniform(8, 60), random.uniform(2, 4),
                        random.choice((0xFFFFFF, 0xFFF4A0, 0xA8E8FF))) for _ in range(5)]
            yield from self.esperar(0.07)
        self.fx = []

    def lancar_bola(self):
        x0, y0, x1, y1 = -8.0, 60.0, 72.0, 92.0
        ini = self.t
        while self.t - ini < 0.7:
            p = (self.t - ini) / 0.7
            self.bola = (x0 + (x1 - x0) * p, y0 + (y1 - y0) * p - math.sin(p * math.pi) * 34)
            yield
        self.bola = None
        self.vis["j"] = True
        ini = self.t
        while self.t - ini < 0.4:
            p = (self.t - ini) / 0.4
            self.escala_spr["j"] = 0.15 + 0.85 * p
            self.branco["j"] = 1.0
            self.fx = [("anel", x1, y1, 3 + p * 28, misturar(0xFFFFFF, 0xF8F8B0, p)), ("anel", x1, y1, 1 + p * 18, 0xFFFFFF)]
            yield
        self.escala_spr["j"] = 1.0
        self.fx = []
        ini = self.t
        while self.t - ini < 0.35:
            self.branco["j"] = 1 - (self.t - ini) / 0.35
            yield
        self.branco["j"] = 0.0

    def escolher(self):
        J = self.lut["j"]
        self.texto = ["What will", f"{J['nome']} do?"]
        self.menu = ("cmd", 0)
        self.balanco = True
        yield from self.esperar(random.uniform(0.9, 1.5))
        if random.random() < 0.3:
            self.menu = ("cmd", random.choice((1, 2, 3)))
            yield from self.esperar(0.4)
            self.menu = ("cmd", 0)
            yield from self.esperar(0.35)
        pesos = [1 if g[3] == "status" else 3 for g in J["golpes"]]
        idx = random.choices(range(len(J["golpes"])), weights=pesos)[0]
        self.texto = ["", ""]
        self.menu = ("golpes", 0)
        yield from self.esperar(0.55)
        for k in ([1] if idx in (1, 3) else []) + ([idx] if idx in (2, 3) else []):
            self.menu = ("golpes", k)
            yield from self.esperar(0.3)
        yield from self.esperar(0.45)
        self.menu = None
        self.balanco = False
        J["pp"][idx] = max(0, J["pp"][idx] - 1)
        return J["golpes"][idx]

    def turno(self, a, d, golpe):
        A, D = self.lut[a], self.lut[d]
        if A["status"] == "sono":
            A["sono"] -= 1
            if A["sono"] <= 0:
                A["status"] = None
                yield from self.dizer(f"{self.nome_b(a)} woke up!")
            else:
                yield from self.dizer(f"{self.nome_b(a)} is fast asleep.")
                return
        if A["status"] == "par" and random.random() < 0.25:
            yield from self.dizer(f"{self.nome_b(a)} is paralyzed! It can't move!")
            return
        if A["conf"] > 0:
            A["conf"] -= 1
            if A["conf"] == 0:
                yield from self.dizer(f"{self.nome_b(a)} snapped out of confusion!")
            else:
                yield from self.dizer(f"{self.nome_b(a)} is confused!", pausa=0.6)
                if random.random() < 0.5:
                    yield from self.dizer("It hurt itself in its confusion!", pausa=0.3)
                    yield from self.dano(a, max(1, A["max"] // 10))
                    return
        nome, poder, _pp, estilo = golpe
        yield from self.dizer(f"{self.nome_b(a)} used {nome}!", pausa=0.3)
        if estilo == "status":
            efeito = STATUS_GOLPES[nome][0]
            alvo = a if efeito.endswith("+") else d
            if efeito == "nada":
                for dy in (-6, 0, -6, 0):
                    self.off[a][1] = dy
                    yield from self.esperar(0.12)
                yield from self.dizer("But nothing happened!")
                return
            yield from self.anim_status(a, d, nome, efeito)
            if efeito in FRASES_STATUS:
                for _ in range(3):
                    self.tinta[alvo] = (0xF87050 if efeito.endswith("+") else 0x4870F0, 0.5)
                    yield from self.esperar(0.1)
                    self.tinta[alvo] = None
                    yield from self.esperar(0.08)
                yield from self.dizer(FRASES_STATUS[efeito].format(a=self.nome_b(alvo)))
            elif efeito == "conf":
                if D["conf"]:
                    yield from self.dizer(f"{self.nome_b(d)} is already confused!")
                else:
                    D["conf"] = random.randint(2, 5)
                    yield from self.dizer(f"{self.nome_b(d)} became confused!")
            elif efeito == "semente":
                if "GRASS" in D["tipos"] or D["semente"]:
                    yield from self.dizer(f"{self.nome_b(d)} evaded the attack!")
                else:
                    D["semente"] = a
                    yield from self.dizer(f"{self.nome_b(d)} was seeded!")
            else:
                if D["status"]:
                    yield from self.dizer("But it failed!")
                elif efeito == "par":
                    D["status"] = "par"
                    yield from self.dizer(f"{self.nome_b(d)} is paralyzed! It may be unable to move!")
                elif efeito == "sono":
                    D["status"], D["sono"] = "sono", random.randint(1, 3)
                    yield from self.dizer(f"{self.nome_b(d)} fell asleep!")
                else:
                    D["status"] = "veneno"
                    yield from self.dizer(f"{self.nome_b(d)} was poisoned!")
            return
        if random.random() < 0.06:
            yield from self.dizer(f"{self.nome_b(a)}'s attack missed!")
            return
        tipo = self.tipo_golpe(golpe)
        mult = 1.0
        for t in D["tipos"]:
            mult *= TIPOS_MULT.get(tipo, {}).get(t, 1.0)
        if mult == 0:
            yield from self.dizer(f"It doesn't affect {self.nome_b(d)}...")
            return
        yield from self.anim(a, d, estilo)
        crit = random.random() < 0.0625
        stab = 1.5 if tipo in A["tipos"] else 1.0
        base = (2 * A["nivel"] / 5 + 2) * poder / 50 + 2
        dano = max(1, int(base * stab * mult * random.uniform(0.85, 1.0) * (2 if crit else 1)))
        yield from self.dano(d, dano, piscar=True)
        if crit:
            yield from self.dizer("A critical hit!")
        if mult > 1:
            yield from self.dizer("It's super effective!")
        elif mult < 1:
            yield from self.dizer("It's not very effective...")
        if estilo == "dreno" and A["hp"] > 0:
            cura = max(1, dano // 2)
            yield from self.curar(a, cura)
            yield from self.dizer(f"{self.nome_b(d)} had its energy drained!")

    def fim_de_turno(self, lado):
        P = self.lut[lado]
        if P["hp"] <= 0:
            return
        if P["status"] == "veneno":
            yield from self.anim_status(lado, lado, "", "veneno")
            yield from self.dizer(f"{self.nome_b(lado)} is hurt by poison!", pausa=0.4)
            yield from self.dano(lado, max(1, P["max"] // 8))
        if P["semente"] and P["hp"] > 0:
            outro = P["semente"]
            yield from self.dizer(f"{self.nome_b(lado)}'s health is sapped by LEECH SEED!", pausa=0.4)
            q = max(1, P["max"] // 8)
            yield from self.dano(lado, q)
            if self.lut[outro]["hp"] > 0:
                yield from self.curar(outro, q)

    def dano(self, lado, q, piscar=False):
        if piscar:
            for _ in range(4):
                self.pisca[lado] = True
                yield from self.esperar(0.06)
                self.pisca[lado] = False
                yield from self.esperar(0.06)
        P = self.lut[lado]
        novo = max(0, P["hp"] - q)
        P["hp"] = novo
        while self.hpv[lado] > novo:
            self.hpv[lado] = max(novo, self.hpv[lado] - self.dt * P["max"] * 0.5)
            yield

    def curar(self, lado, q):
        P = self.lut[lado]
        novo = min(P["max"], P["hp"] + q)
        P["hp"] = novo
        while self.hpv[lado] < novo:
            self.hpv[lado] = min(novo, self.hpv[lado] + self.dt * P["max"] * 0.5)
            yield

    def desmaiar(self, lado):
        ini = self.t
        while self.t - ini < 0.5:
            self.afunda[lado] = int(64 * (self.t - ini) / 0.5)
            yield
        self.vis[lado] = False
        self.info[lado] = False
        self.afunda[lado] = 0

    # --- animações dos golpes

    def projeteis(self, a, d, cores, raio, n=3, arco=8, dur=0.3, rastro=True):
        ax, ay = self.centro(a)
        dx, dy = self.centro(d)
        for _ in range(n):
            ini = self.t
            while self.t - ini < dur:
                p = (self.t - ini) / dur
                x = ax + (dx - ax) * p
                y = ay + (dy - ay) * p - math.sin(p * math.pi) * arco
                self.fx = []
                if rastro:
                    for k in range(1, 3):
                        self.fx.append(("disco", x - (dx - ax) * 0.05 * k, y - (dy - ay) * 0.05 * k, raio * (1 - k * 0.3), cores[-1]))
                self.fx.append(("disco", x, y, raio, cores[0]))
                if len(cores) > 1:
                    self.fx.append(("disco", x - raio * 0.3, y - raio * 0.3, raio * 0.45, cores[1]))
                yield

    def jato(self, a, d, cor, claro, dur=0.7, arco=12, r=2.4):
        ax, ay = self.centro(a)
        dx, dy = self.centro(d)
        ini = self.t
        while self.t - ini < dur:
            p = (self.t - ini) / dur
            self.fx = []
            for k in range(18):
                q = p * 1.7 - k * 0.05
                if 0 <= q <= 1:
                    x = ax + (dx - ax) * q
                    y = ay + (dy - ay) * q - math.sin(q * math.pi) * arco
                    self.fx.append(("disco", x, y, r, cor))
                    self.fx.append(("disco", x - 0.6, y - 0.6, r * 0.4, claro))
            yield

    def feixe(self, a, d, cor, claro, dur=0.6, esp=2):
        ax, ay = self.centro(a)
        dx, dy = self.centro(d)
        ini = self.t
        while self.t - ini < dur:
            p = min(1.0, (self.t - ini) / (dur * 0.5))
            x1, y1 = ax + (dx - ax) * p, ay + (dy - ay) * p
            self.fx = [("linha", ax, ay + o, x1, y1 + o, cor, 1) for o in range(-esp, esp + 1)]
            self.fx.append(("linha", ax, ay, x1, y1, claro, 1))
            if p >= 1:
                self.fx.append(("estrela", dx, dy, random.uniform(4, 8), claro))
            yield

    def sobre_alvo(self, d, gerar, dur=0.6, passo=0.05):
        """Partículas aleatórias em volta do alvo (gerar(x, y) devolve a lista de efeitos)."""
        dx, dy = self.centro(d)
        ini = self.t
        while self.t - ini < dur:
            self.fx = gerar(dx, dy, (self.t - ini) / dur)
            yield from self.esperar(passo)

    def impacto(self, x, y, cor=0xFFFFFF):
        ini = self.t
        while self.t - ini < 0.2:
            p = (self.t - ini) / 0.2
            self.fx = [("estrela", x, y, 4 + p * 8, cor), ("estrela", x, y, 2 + p * 4, 0xF8F090)]
            yield

    def investida(self, a, passo=0.05):
        sent = 1 if a == "j" else -1
        for k in (5, 12, 18, 8, 0):
            self.off[a][0] = k * sent
            self.off[a][1] = -k // 4 * sent
            yield from self.esperar(passo)
        self.off[a] = [0, 0]

    def anim(self, a, d, estilo):
        dx, dy = self.centro(d)
        ax, ay = self.centro(a)
        R = random.uniform
        if estilo in ("investida", "rapido"):
            yield from self.investida(a, 0.03 if estilo == "rapido" else 0.05)
            yield from self.impacto(dx, dy)
        elif estilo == "arranhao":
            riscos = []
            for k in range(3):
                riscos.append(("linha", dx - 12 + k * 8, dy - 14, dx - 2 + k * 8, dy + 12, 0xFFFFFF, 1))
                self.fx = list(riscos)
