def maumau_em(u, v, cara="normal", bracos=(0.15, 0.15), chapeu=None, chifres=False, brilho=False, vermelho=0.0):
    """Cor do Maumau no ponto (u, v), em unidades de meia cabeça (cintura em (0, 0), v pra baixo); None = fora.
    bracos = (esquerdo, direito) em radianos a partir de caído (pi/2 = T-pose, pi = pra cima).
    cara: normal, rindo, bravo, triste, assustado ou mastigando; vermelho (0..1) é a raiva subindo pro rosto."""
    if v < -2.35 or v > 1.8 or abs(u) > 1.8:
        return None
    if chapeu == "pirata":  # tricórnio preto com a caveirinha branca
        if (u / 0.8) ** 2 + ((v + 1.86) / 0.14) ** 2 <= 1:
            return 0xD9B030 if v > -1.83 else 0x1A1A1A
        if abs(u) <= 0.5 - 0.25 * max(0.0, -2.05 - v) / 0.25 and -2.3 <= v <= -1.86:
            if (u / 0.11) ** 2 + ((v + 2.06) / 0.09) ** 2 <= 1:
                return 0x0A0A0A if abs(u) > 0.03 and abs(u) < 0.07 and v < -2.06 else 0xF4F4F4
            return 0x222222 if v > -1.98 else 0x1A1A1A
    if chifres:
        for s in (-1, 1):
            k = (-1.72 - v) / 0.5  # 0 na base, 1 na ponta
            if 0 <= k <= 1 and abs(u * s - 0.3 - 0.16 * k * k) <= 0.11 * (1 - k):
                return 0xE03024 if u * s < 0.3 + 0.16 * k * k else 0x9A1812
    # braços: manga listrada, depois pele, e a mão
    for s, a in ((-1, bracos[0]), (1, bracos[1])):
        sx, sy = 0.56 * s, -0.66
        dx, dy = math.sin(a) * s, math.cos(a)
        q = (u - sx) * dx + (v - sy) * dy
        if -0.05 <= q <= 1.18:
            d2 = (u - sx - q * dx) ** 2 + (v - sy - q * dy) ** 2
            if q > 1.0:
                if (u - sx - 1.06 * dx) ** 2 + (v - sy - 1.06 * dy) ** 2 <= 0.026:
                    return escala(PELE_MAU, 0.92)
            elif d2 <= (0.2 if q < 0.34 else 0.15) ** 2:
                if q < 0.34:
                    return CAM_PRETO if int((q + 1) * 9) % 2 else CAM_BRANCO
                return escala(PELE_MAU, 0.95 - 0.1 * (s > 0))
    hx, hy = u / 0.48, (v + 1.42) / 0.56
    if (abs(u) - 0.47) ** 2 / 0.006 + ((v + 1.4) / 0.13) ** 2 <= 1:
        return escala(PELE_MAU, 0.86)  # orelhas
    if hx * hx + hy * hy <= 1:
        pele = misturar(PELE_MAU, 0xE8483A, vermelho)
        if hy < -0.5 + 0.08 * math.sin(hx * 17):
            return CABELO_MAU
        ex, ey = abs(hx) - 0.38, hy + 0.02
        sob = -0.25 - ex * (0.7 if cara == "bravo" or brilho else -0.6 if cara == "triste" else 0.0)
        if abs(hy - sob) <= 0.065 and 0.14 <= abs(hx) <= 0.62:
            return CABELO_MAU  # sobrancelhas
        if brilho:
            if ex * ex + ey * ey <= 0.03:
                return 0xFFF0A0 if ex * ex + ey * ey <= 0.008 else 0xFF2A10
        elif cara == "assustado":
            d = ex * ex + ey * ey
            if d <= 0.024:
                return 0x1A1210 if d <= 0.007 else 0xFFFFFF
        elif cara in ("rindo", "mastigando"):
            if abs(ex) <= 0.13 and -0.06 <= ey <= 0.0 + 0.5 * abs(ex):
                return 0x2A1A12
        elif ex * ex / 0.014 + ey * ey / 0.026 <= 1:
            return 0x1A1210
        if cara == "triste" and abs(ex - 0.04) < 0.05 and 0.08 < ey < 0.36:
            return 0x7AC8FF  # lágrima
        if hx * hx / 0.02 + (hy - 0.16) ** 2 / 0.016 <= 1:
            return escala(pele, 0.8)  # nariz
        mx, my = hx / 0.34, (hy - 0.52) / 0.16
        if cara == "rindo" and mx * mx + my * my <= 1 and my >= -0.5:
            return 0xFFFFFF if my < 0.1 else 0x7A2020
        if cara == "bravo" and abs(mx) <= 0.9 and abs(my) <= 0.45:
            return 0xFFFFFF if int((mx + 1) * 5) % 2 or abs(my) < 0.15 else 0x5A2020
        if cara == "assustado" and mx * mx / 0.25 + my * my / 0.9 <= 1:
            return 0x3A1010
        if cara == "triste" and abs(mx) <= 0.7 and abs(my + 0.4 * (1 - mx * mx)) <= 0.22:
            return 0x5A2020
        if cara == "mastigando" and abs(mx) <= 0.5 and abs(my) <= 0.25:
            return 0x5A2020
        if cara == "normal" and abs(mx) <= 0.6 and abs(my - 0.2 * (1 - mx * mx) + 0.1) <= 0.16:
            return 0x5A2020
        if -0.2 < hy - 0.33 < 0.1 and abs(hx) < 0.5:
            return escala(BARBA_MAU, 0.85)  # bigode
        if hy > 0.24 or (abs(hx) > 0.74 and hy > -0.1):
            return escala(BARBA_MAU, 0.9 + 0.2 * math.sin(u * 37 + v * 23) * 0.5)
        return escala(pele, 0.9 + 0.12 * clamp(0.5 - hx * 0.4 - hy * 0.4))
    if (u / 0.42) ** 2 + ((v + 0.92) / 0.24) ** 2 <= 1:
        return escala(BARBA_MAU, 0.95 + 0.1 * math.sin(u * 41 + v * 29))  # barba cai por cima da gola
    if v < -0.85 or v > 1.8:
        return None
    if v <= 0.72:  # camisa listrada do Galo
        larg = 0.6 - (0.12 * ((-0.62 - v) / 0.23) ** 2 if v < -0.62 else 0)
        if abs(u) <= larg:
            if (u / 0.22) ** 2 + ((v + 0.84) / 0.1) ** 2 <= 1:
                return 0x0A0A0A  # gola
            ex, ey = (u + 0.3) / 0.13, (v + 0.38) / 0.16
            if abs(ex) <= 1 and -1 <= ey <= 1 - 0.6 * abs(ex) ** 2:
                return CAM_BRANCO if abs(ex) > 0.62 or ey < -0.7 or ey > 0.55 - 0.6 * abs(ex) ** 2 else CAM_PRETO
            if abs(u + 0.3) <= 0.05 and -0.66 <= v <= -0.58:
                return 0xF2C230  # a estrela em cima do escudo
            return escala(CAM_BRANCO if int((u + 3) / 0.2) % 2 else CAM_PRETO, 0.85 + 0.2 * clamp(0.5 - u * 0.6))
        return None
    if v <= 1.04:
        return 0x1C1C1C if abs(u) <= 0.58 and not (v > 0.9 and abs(u) < 0.05) else None  # calção
    for s in (-1, 1):
        if abs(u - 0.28 * s) <= 0.17:
            if v <= 1.44:
                return escala(PELE_MAU, 0.94)
            if v <= 1.6:
                return CAM_BRANCO  # meião
        if 1.6 < v <= 1.78 and -0.2 <= (u - 0.28 * s) * s <= 0.26:
            return 0x202020  # chuteira
    return None


def pintar_forma(px, w, ph, cache, chave, fn, x, y, R, ang=0.0, caixa=(-1.8, 1.8, -2.35, 1.8)):
    """Pinta fn(u, v) -> cor|None no buffer, escalado por R, girado por ang e centrado em (x, y). Usa cache."""
    pix = cache.get(chave)
    if pix is None:
        if len(cache) > 160:
            cache.clear()
        ca, sa = math.cos(ang), math.sin(ang)
        u0, u1, v0, v1 = caixa
        if abs(ang) < 0.02:
            xs, ys = range(int(u0 * R) - 1, int(u1 * R) + 2), range(int(v0 * R) - 1, int(v1 * R) + 2)
        else:
            r = int(R * max(abs(u0), abs(u1), abs(v0), abs(v1)) * 1.42) + 1
            xs = ys = range(-r, r + 1)
        pix = []
        for dy in ys:
            for dx in xs:
                c = fn(((dx + 0.5) * ca + (dy + 0.5) * sa) / R, (-(dx + 0.5) * sa + (dy + 0.5) * ca) / R)
                if c is not None:
                    pix.append((dx, dy, c))
        cache[chave] = pix
    x0, y0 = int(x), int(y)
    for dx, dy, c in pix:
        xx, yy = x0 + dx, y0 + dy
        if 0 <= xx < w and 0 <= yy < ph:
            px[yy * w + xx] = c


BAU = [".bbbbbbbbbb.",
       "bBBBBBBBBBBb",
       "gggggggggggg",
       "bBBBBByBBBBb",
       "bBBBBBBBBBBb",
       "gggggggggggg",
       "bBBBBBBBBBBb"]
BAU_ABERTO = [".bbbbbbbbbb.", "bBBBBBBBBBBb", "gggggggggggg", "............", "oooooooooooo"] + BAU[3:]
CORES_BAU = {"b": 0x4A2810, "B": 0x8A5428, "g": 0xE0B030, "y": 0x1A1A1A, "o": 0xFFE680}


def navio_em(x, y, faixa=(CAM_PRETO, CAM_BRANCO), vela=0xEFE6D0, galo=True, furos=()):
    """Navio pirata visto de lado, proa pra esquerda; (x, y) em unidades do navio, origem na linha d'água."""
    if abs(x) <= 0.9 and -50 <= y <= -6:
        return 0x5A3418  # mastro
    if abs(y + 45) <= 0.7 and abs(x) <= 16:
        return 0x5A3418  # verga
    if -44 <= y <= -21:
        q = (y + 44) / 23
        b = 2.6 * math.sin(math.pi * q)  # a vela estufa pro lado da proa
        if -15 - b <= x <= 15 - b:
            if galo:
                gx, gy = int(x + b + 10), int(y + 42)
                if 0 <= gy < len(GALO_ATL) and 0 <= gx < len(GALO_ATL[0]):
                    c = CORES_GALO_ATL.get(GALO_ATL[gy][gx])
                    if c:
                        return c
            return escala(vela, 0.82 + 0.22 * math.sin(math.pi * clamp((x + b + 15) / 30)) - 0.08 * q)
    if -35 <= x <= -25 and abs(y + 6 + (x + 25) * 0.6) <= 0.6:
        return 0x5A3418  # gurupés
    if 16 <= x <= 30 and -12 <= y < -6:
        if y < -11:
            return 0x3E2410
        return 0xF0C060 if (x - 17) % 5 < 2 and -10 <= y <= -8 else 0x7A4A24  # castelo de popa
    if -8 <= y < -6 and -33 <= x <= 30:
        return 0x3E2410 if int(x) % 4 == 0 else None  # balaústre
    if -6 <= y <= 7:
        q = (y + 6) / 13
        if -34 + 12 * q ** 1.5 <= x <= 30 - 6 * q * q:
            for fx, fy in furos:
                d = (x - fx) ** 2 + (y - fy) ** 2
                if d <= 5 + 1.5 * math.sin(math.atan2(y - fy, x - fx) * 5):
                    return 0x0E0806 if d <= 3 else 0x2A1608
            if -4.5 <= y <= -1.5:
                return faixa[int((x + 40) / 2) % 2]
            if abs(y - 1.5) <= 1.0 and int(x + 40) % 8 in (3, 4) and -24 <= x <= 22:
                return 0x2A1A10  # escotilhas
            return 0x4E2C14 if int(y + 7) % 3 == 0 else escala(0x6A3E1E, 1.0 - 0.25 * q)
    return None


class BarbaRuiva(ComCanhao, Cena):
    """O Maumau, o Barba Ruiva, pirata alvinegro com um galinho no ombro, atrás do baú escrito TAÇA. Lá dentro
    sempre tem uma medalha de prata. Depois vem o Raja (ou o Botafogo com 10), e no fim o Clawd, da praia, com o
    canhão do Arsenal: o galinho vira frango assado e o navio vai pro fundo."""
    combinavel = False
    peso = 0.8
    duracao = (55, 75)
    NOME = "BARBA RUIVA"
    CHEGA = ["Barba Ruiva no comando!", "Içar as velas, cambada!", "Esse ano a taça é nossa!", "GALOOO!",
             "Ninguém segura o Barba Ruiva!"]
    ACHOU = ["Um baú escrito TAÇA!", "Achei o tesouro!", "Finalmente, a taça!", "É hoje!"]
    PRATA = ["PRATA DE NOVO?!", "Medalha de prata... de novo.", "NÃO ACREDITO!", "Isso é sacanagem!"]
    RAJA = ["O Raja de novo não!", "Lá vem o Raja...", "2013 de novo não!"]
    BOTA = ["COM DEZ?! COM DEZ?!", "Devolve minha medalha!", "Eles tão com um a menos!"]
    ERROU = ["Errou!", "Passou longe, gringo!", "Mira de cruzeirense!"]
    FRANGO_FALA = ["MEU GALO!", "Virou frango!", "NÃÃÃO, MEU GALO!"]
    AFUNDA = ["Glub glub...", "Foi pênalti!", "Chama o VAR!", "Socorro!"]
    CLAWD_FALA = ["Up the Arsenal!", "Galo no mar? Vira frango.", "Fica paradinho aí...",
                  "Esse é pelo primo do Tottenham."]
    CLAWD_FESTA = ["Gooooner!", "Frango assado no ponto!", "Afundou bonito!"]
    VOLTA = [("fez mais uma dívida!", "comprou outro navio!"), ("passou o chapéu na torcida!", "zarpou de novo!"),
             ("parcelou um navio em 48x!", "voltou pro mar!"), ("prometeu que esse ano vai!", "içou as velas!")]

    def iniciar(self):
        w, h = self.w, self.h
        ph = self.ph = 2 * h
        self.k = max(0.6, min(w / 174, ph / 98))
        self.c = self.k
        self.sc = max(1, round(self.k))
        self.g = ph * 1.0
        self.mar = int(ph * 0.5)            # o horizonte
        self.raia = int(ph * 0.76)          # a linha d'água do navio
        self.chao = ph - max(5, int(ph * 0.09))  # a areia da ilha
        self.praia = int(max(w * 0.3, 32 * self.c + 18 * self.sc))
        self.Rm = 6.2 * self.k
        self.sg = max(1, round(self.k))
        self.cache = {}
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * ph)
        self.t = self.dt = 0.0
        self.can_alvo = 13 * self.c + 18 * self.sc + 2
        self.can = dict(x=-30 * self.c, ang=-0.25, giro=0.0, recuo=0.0)
        self.passo = False
        self.bala = None
        self.disparo = -10.0
        self.parts = []
        self.falas = {}
        self.caixa = None
        self.onomato = []
        self.faixa = None
        self.festa_ate = -10.0
        self.placar = 0
        self.nav = dict(x=w + 60 * self.k, incl=0.0, afunda=0.0, vy=0.0, furos=[], estado="ok", tremor=-10.0)
        self.mau = dict(cara="rindo", bracos=[0.2, 0.2], alvo=[0.2, 0.2], vermelho=0.0, alvo_verm=0.0)
        self.galinho = "vivo"
        self.canta = -10.0
        self.frango = None       # dict(x, y, vy, pousado)
        self.bau = None          # dict(x, y, estado)
        self.medalha = None      # dict(x, y)
        self.chapeu = None       # (x, y) do chapéu boiando
        self.rival = None        # o navio do Raja ou a canoa do Botafogo
        self.balas_raja = []     # (x0, y0, lx, ly, t0)
        self.gen = self.roteiro()

    # --- cenário

    def montar_fundo(self):
        w, ph, mar, chao = self.w, self.ph, self.mar, self.chao
        px = [0] * (w * ph)
        sol_x, sol_r = w * 0.64, ph * 0.13
        for y in range(mar):
            f = y / max(1, mar - 1)
            base = misturar(0x2A1F4A, 0x8A3A5A, f * 1.4) if f < 0.7 else misturar(0x8A3A5A, 0xF09A48, (f - 0.7) / 0.3)
            for x in range(w):
                c = base
                n = math.sin(x * 0.07 + y * 0.5) + math.sin(x * 0.023 - y * 0.9)
                if 0.25 < f < 0.8 and n > 1.4:
                    c = misturar(c, 0xF4A0A0, 0.35)  # nuvens compridas do fim de tarde
                d = math.hypot(x - sol_x, (y - mar) * 1.0)
                if d < sol_r and not (y > mar - sol_r * 0.5 and int(y) % 3 == 0):
                    c = misturar(0xFFE07A, 0xFF9A40, d / sol_r)
                elif d < sol_r * 1.7:
                    c = misturar(c, 0xFFB060, 0.35 * (1 - (d - sol_r) / (sol_r * 0.7)))
                px[y * w + x] = c
        for y in range(mar, ph):
            f = (y - mar) / max(1, ph - mar)
            base = misturar(0x2A4A7A, 0x0E2440, f)
            for x in range(w):
                px[y * w + x] = base
        # a ilhota da praia, com o coqueiro
        for x in range(self.praia + 8):
            topo = chao + max(0.0, (x - self.praia + 8) * 0.7)
            for y in range(int(topo), ph):
                px[y * w + x] = misturar(0xE8C88A, 0xC09A5A, (y - topo) / 6) if y > topo + 0.5 else 0xF4DCA0
        tx = max(3, int(self.praia * 0.1))
        alto = int(ph * 0.34)
        topo_c = (tx, chao)
        for k in range(alto):
            x = int(tx + 3 * math.sin(k / alto * 1.6))
            y = chao - k
            for xx in (x, x + 1):
                if 0 <= xx < w:
                    px[y * w + xx] = 0x7A5230 if k % 3 else 0x5A3A20
            topo_c = (x, y)
        cx, cy = topo_c
        for a in (-2.8, -2.2, -1.7, -1.2, -0.6, -0.1):
            for r in range(int(ph * 0.16)):
                x = int(cx + math.cos(a) * r)
                y = int(cy + math.sin(a) * r * 0.6 + (r / (ph * 0.16)) ** 2 * ph * 0.08)
                for dy in (0, 1):
                    if 0 <= x < w and 0 <= y + dy < ph:
                        px[(y + dy) * w + x] = 0x2E7A3A if dy else 0x48A050
        return px

    def solo(self, x):
        return self.chao if x < self.praia else self.raia + 2

    def desenhar_mar(self, px):
        w, ph, mar, t = self.w, self.ph, self.mar, self.t
        sol_x = w * 0.64
        for y in range(mar, ph):
            f = (y - mar) / max(1, ph - mar)
            for x in range(self.praia if y >= self.chao - 1 else 0, w):
                ond = math.sin(x * (0.35 - 0.2 * f) + t * (1.5 + f) + y * 1.7) + math.sin(x * 0.11 - t * 0.7 + y)
                if ond > 1.55 - 0.3 * f:
                    i = y * w + x
                    perto = abs(x - sol_x) < w * 0.06 * (0.5 + f * 1.5)
                    px[i] = misturar(px[i], 0xFFC870 if perto else 0x8AB8E0, 0.6 if perto else 0.35)

    # --- o navio

    def pos_nav(self, t=None):
        t = self.t if t is None else t
        n = self.nav
        y = self.raia + math.sin(t * 1.3) * 0.8 * self.k + n["afunda"]
        ang = 0.035 * math.sin(t * 0.9) + n["incl"]
        p = self.t - n["tremor"]
        if p < 0.6:
            ang += 0.05 * math.sin(p * 30) * (1 - p / 0.6)
        return n["x"], y, ang

    def no_navio(self, lx, ly, t=None):
        """Ponto do navio (unidades do navio) -> tela."""
        x, y, a = self.pos_nav(t)
        k = self.k
        return x + (lx * math.cos(a) - ly * math.sin(a)) * k, y + (lx * math.sin(a) + ly * math.cos(a)) * k

    def do_navio(self, x, y):
        nx, ny, a = self.pos_nav()
        dx, dy = (x - nx) / self.k, (y - ny) / self.k
        return dx * math.cos(a) + dy * math.sin(a), -dx * math.sin(a) + dy * math.cos(a)

    def pos_mau(self, t=None):
        """Cintura do Maumau na tela (ele fica no convés, perto da proa)."""
        return self.no_navio(-25, -6 - 1.78 * self.Rm / self.k, t)

    def pos_galinho(self, t=None):
        _, _, a = self.pos_nav(t)
        mx, my = self.pos_mau(t)
        R = self.Rm
        return mx + 0.62 * R * math.cos(a) + 0.9 * R * math.sin(a), my + 0.62 * R * math.sin(a) - 0.9 * R * math.cos(a)

    def falar(self, txt, quem="mau"):
        self.falas[quem] = (txt, self.t)

    def cara(self, cara, bracos=None, vermelho=None):
        m = self.mau
        m["cara"] = cara
        if bracos is not None:
            m["alvo"] = list(bracos)
        if vermelho is not None:
            m["alvo_verm"] = vermelho

    # --- roteiro

    def roteiro(self):
        yield from self.esperar(0.5)
        while True:
            yield from self.chegar()
            yield from self.tesouro()
            yield from (self.raja() if random.random() < 0.5 else self.botafogo())
            yield from self.canhonaco()
            yield from self.voltar()

    def chegar(self):
        n, w, k = self.nav, self.w, self.k
        n.update(x=w + 60 * k, incl=0.0, afunda=0.0, vy=0.0, furos=[], estado="ok")
        self.galinho, self.frango, self.medalha, self.bau = "vivo", None, None, None
        self.cara("rindo", (2.7, 0.3), 0.0)
        x0, alvo, ini = n["x"], w * 0.64, self.t
        falou = cantou = False
        while self.t - ini < 5.0:
            p = self.t - ini
            n["x"] = x0 + (alvo - x0) * suave(p / 5.0)
            if p > 1.2 and not falou:
                self.falar(random.choice(self.CHEGA))
                falou = True
            if p > 3.6 and not cantou:
                self.canta = self.t
                self.falar("Cocoricó!", "galinho")
                cantou = True
            yield
        self.chapeu = None
        self.cara("normal", (0.2, 0.2))
        yield from self.esperar(1.0)

    def tesouro(self):
        n, k = self.nav, self.k
        self.bau = dict(x=n["x"] - 56 * k, y=float(self.raia), estado="boiando")
        yield from self.esperar(1.2)
        self.cara("rindo", (2.6, 2.6))
        self.falar(random.choice(self.ACHOU))
        x0, ini = n["x"], self.t
        while self.t - ini < 2.5:  # encosta no baú
            n["x"] = x0 - 12 * k * suave((self.t - ini) / 2.5)
            yield
        b = self.bau
        b["estado"], x0, y0, ini = "subindo", b["x"], b["y"], self.t
        while self.t - ini < 1.0:
            q = suave(self.t - ini)
            dx, dy = self.no_navio(-13, -6)
            b["x"], b["y"] = x0 + (dx - x0) * q, y0 + (dy - y0) * q - math.sin(q * math.pi) * 10 * k
            yield
        b["estado"] = "convés"
        self.cara("normal", (0.6, 0.6))
        yield from self.esperar(1.2)
        b["estado"] = "aberto"
        ini = self.t
        while self.t - ini < 1.6:  # o brilho dourado lá de dentro
            bx, by = self.no_navio(-13, -6 - 4 * self.sg / k)
            if random.random() < 0.7:
                self.parts.append([bx + random.uniform(-5, 5) * self.sg, by, random.uniform(-4, 4),
                                   random.uniform(-26, -12), random.choice((0xFFE680, 0xFFF4C0, 0xF2C230)),
                                   self.t, random.uniform(0.4, 0.8), "faisca"])
            yield
        self.medalha = dict(sobe=self.t)
        self.cara("assustado", (0.3, 0.3))
        yield from self.esperar(1.4)
        self.cara("bravo", (0.5, 0.5), 1.0)
        self.falar(random.choice(self.PRATA))
        yield from self.esperar(3.2)

    def raja(self):
        w, k = self.w, self.k
        r = self.rival = dict(tipo="raja", x=w + 40 * k)
        self.cara("assustado", (2.8, 2.8))
        self.falar(random.choice(self.RAJA))
        x0, alvo, ini = r["x"], w - 22 * k, self.t
        while self.t - ini < 3.0:
            r["x"] = x0 + (alvo - x0) * suave((self.t - ini) / 3.0)
            yield
        for i in range(3):
            ox, oy = r["x"] - 14 * k * 0.6, self.mar + (self.raia - self.mar) * 0.35
            self.balas_raja.append((ox, oy, random.uniform(-22, 18), random.uniform(-4, 3), self.t))
            self.onomato.append(("BUM!", ox, oy - 8, self.t, 0x50E070))
            yield from self.esperar(1.3)
        self.faixa = ("RAJA 3 X 1 GALO", self.t)
        self.cara("triste", (0.1, 0.1), 0.0)
        yield from self.esperar(1.5)
        x0, ini = r["x"], self.t
        while self.t - ini < 3.0:
            r["x"] = x0 + 45 * k * suave((self.t - ini) / 3.0)
            yield
        self.rival = None

    def botafogo(self):
        w, k = self.w, self.k
        r = self.rival = dict(tipo="bota", x=w + 20 * k, vai=-1)
        mx, _ = self.no_navio(-13, -6)
        ini, x0 = self.t, r["x"]
        while r["x"] > mx:  # a canoa vem remando com dez
            r["x"] -= w * 0.22 * self.dt
            yield
        self.falar("Com 10 mesmo!", "canoa")
        self.medalha = None
        r["medalha"], r["vai"] = True, 1
        self.cara("bravo", (2.8, 0.4), 1.0)
        self.falar(random.choice(self.BOTA))
        self.faixa = ("BOTAFOGO 3 X 1 GALO", self.t)
        while r["x"] < w + 30 * k:
            r["x"] += w * 0.22 * self.dt
            yield
        self.rival = None
        self.cara("triste", (0.1, 0.1), 0.0)
        yield from self.esperar(1.5)

    def canhonaco(self):
        if self.can["x"] < self.can_alvo:
            yield from self.trazer_canhao()
        self.falar(random.choice(self.CLAWD_FALA), "clawd")
        yield from self.esperar(1.5)
        if random.random() < 0.5:
            yield from self.atirar(lambda tt: (self.pos_galinho(tt)[0], self.pos_galinho(tt)[1] - 14 * self.k), "erra")
            while self.bala:
                yield
            self.cara("rindo", (2.7, 0.3), 0.0)
            self.falar(random.choice(self.ERROU))
            yield from self.esperar(2.4)
        yield from self.atirar(self.pos_galinho, "galinho")
        while self.bala:
            yield
        yield from self.esperar(2.6)
        self.falar(random.choice(self.CLAWD_FALA[:3]), "clawd")
        yield from self.esperar(1.2)
        yield from self.atirar(lambda tt: self.no_navio(-4, -1, tt), "casco")
        while self.bala:
            yield
        while self.nav["estado"] != "afundado":
            yield

    def voltar(self):
        yield from self.esperar(1.5)
        acao, efeito = random.choice(self.VOLTA)
        l1 = f"{self.NOME} {acao}"
        self.caixa = [l1, "", self.t]
        yield from self.esperar(2.2)
        self.caixa = [l1, f"{self.NOME} {efeito}", self.t - len(l1) / 30]
        yield from self.esperar(2.6)
        self.caixa = None

    # --- atualização

    def colidir(self, b):
        t, k = self.t, self.k
        if b["tipo"] == "galinho" and self.galinho == "vivo":
            gx, gy = self.pos_galinho()
            if math.hypot(b["x"] - gx, b["y"] - gy) < 4 * self.sg + 1.5:
                self.galinho = "depenado"
                self.frango = dict(x=gx, y=gy, vy=-30.0, pousado=False)
                for _ in range(40):
                    self.parts.append([gx, gy, random.uniform(-30, 30), random.uniform(-40, 5),
                                       random.choice((0x1E1E1E, 0xF0F0F0, 0xF0F0F0, 0xD8261C)), t,
                                       random.uniform(1.5, 3.0), "pena"])
                self.onomato.append(("PUF!", gx, gy - 6, t, 0xFFFFFF))
                self.falar("CÓÓÓ!", "galinho")
                self.cara("triste", (2.8, 2.8))
                self.falar(random.choice(self.FRANGO_FALA))
                self.festa_ate = t + 2.0
                b["tipo"] = "passou"
        elif b["tipo"] == "casco":
            lx, ly = self.do_navio(b["x"], b["y"])
            if -32 <= lx <= 28 and -7 <= ly <= 6:
                n = self.nav
                n["furos"] = n["furos"] + [(lx, ly)]
                n["estado"], n["tremor"], n["desde"] = "afundando", t, t
                self.onomato.append(("CRASH!", b["x"], b["y"] - 8, t, 0xFFFFFF))
                for _ in range(24):
                    self.parts.append([b["x"], b["y"], random.uniform(-30, 30), random.uniform(-40, -5),
                                       random.choice((0x6A3E1E, 0x4E2C14, 0x8A5428)), t, random.uniform(0.6, 1.2),
                                       "respingo"])
                self.placar += 1
                self.faixa = (f"ARSENAL {self.placar} X 0 GALO", t)
                self.festa_ate = t + 3.5
                self.falar(random.choice(self.CLAWD_FESTA), "clawd")
                self.cara("assustado", (math.pi / 2, math.pi / 2))
                self.falar(random.choice(self.AFUNDA))
                self.bala = None

    def atualizar(self, dt):
        t, k = self.t, self.k
        self.recuar()
        self.atualizar_bala(dt)
        m = self.mau
        for i in (0, 1):
            m["bracos"][i] += (m["alvo"][i] - m["bracos"][i]) * min(1.0, dt * 6)
        m["vermelho"] += (m["alvo_verm"] - m["vermelho"]) * min(1.0, dt * 1.5)
        if m["vermelho"] > 0.7 and random.random() < 0.5:  # sai fumaça das orelhas
            mx, my = self.pos_mau()
            for s in (-1, 1):
                self.parts.append([mx + s * 0.6 * self.Rm, my - 1.45 * self.Rm, s * random.uniform(4, 10),
                                   random.uniform(-14, -6), 0xE8E8E8, t, random.uniform(0.6, 1.0), "fumaca"])
        n = self.nav
        if n["estado"] == "afundando":
            p = t - n["desde"]
            n["incl"] = -0.32 * suave(p / 3.0)
            n["vy"] += 2.2 * k * dt
            n["afunda"] += n["vy"] * dt
            if random.random() < 0.8:
                x, _ = self.no_navio(random.uniform(-30, 25), 0)
                self.parts.append([x, self.raia + 3.0, 0.0, random.uniform(-14, -6), 0xBFE6FF, t, 0.5, "bolha"])
            if self.chapeu is None and p > 1.6:
                self.chapeu = list(self.pos_mau())
            if n["afunda"] > 75 * k:
                n["estado"] = "afundado"
        if self.chapeu:
            self.chapeu[1] += (self.raia - 0.9 * self.Rm + math.sin(t * 1.3) * k - self.chapeu[1]) * min(1.0, dt * 2)
        f = self.frango
        if f and not f["pousado"]:
            f["vy"] += self.g * 0.6 * dt
            f["y"] += f["vy"] * dt
            dx, dy = self.no_navio(-13, -6)
            if n["estado"] == "ok" and f["vy"] > 0 and f["y"] >= dy:
                f["pousado"] = True
            elif f["y"] >= self.raia + 1:
                f["y"], f["pousado"], f["boia"] = self.raia + 1.0, True, True
        elif f and f.get("boia"):
            f["y"] += (self.raia + 1.0 + math.sin(t * 1.6) * k - f["y"]) * min(1.0, dt * 3)
        elif f and n["estado"] == "afundando":
            f["boia"] = True  # o frango sai do navio e fica boiando
        vivas = []
        for b in self.balas_raja:
            x0, y0, lx, ly, t0 = b
            p = (t - t0) / 0.9
            if p >= 1:
                n["furos"] = n["furos"] + [(lx, ly)]
                n["tremor"] = t
                n["incl"] += 0.03
                hx, hy = self.no_navio(lx, ly)
                self.onomato.append(("POW!", hx, hy - 6, t, 0xFFFFFF))
                continue
            vivas.append(b)
        self.balas_raja = vivas

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        self.atualizar(dt)
        w, h, ph, k = self.w, self.h, self.ph, self.k
        px = self.px
        px[:] = self.fundo
        self.desenhar_mar(px)
        self.desenhar_rival(px, longe=True)
        antes = px[:]
        self.desenhar_navio(px)
        self.afogar(px, antes)
        self.desenhar_rival(px, longe=False)
        self.desenhar_bau(px)
        self.desenhar_flutuantes(px)
        self.desenhar_canhao(px)
        self.desenhar_clawd(px)
        self.desenhar_bala(px)
        for x0, y0, lx, ly, t0 in self.balas_raja:
            p = (t - t0) / 0.9
            x1, y1 = self.no_navio(lx, ly)
            x, y = x0 + (x1 - x0) * p, y0 + (y1 - y0) * p - math.sin(p * math.pi) * 12 * k
            for dx in (0, 1):
                for dy in (0, 1):
                    if 0 <= int(x) + dx < w and 0 <= int(y) + dy < ph:
                        px[(int(y) + dy) * w + int(x) + dx] = 0x1C1C20
        self.desenhar_parts(px, dt)
        self.desenhar_letreiros(px)
        pixels_para_celulas(px, w, h, ch, co)
        for quem, (txt, t0) in list(self.falas.items()):
            if t - t0 > 3.0:
                del self.falas[quem]
                continue
            if quem == "mau":
                x, y = self.pos_mau()
                y -= 2.4 * self.Rm
            elif quem == "galinho":
                x, y = self.pos_galinho()
                x, y = x + 6, y - 5
            elif quem == "canoa":
                if not self.rival:
                    continue
                x, y = self.rival["x"], self.raia + 6 * k - 4
            else:
                x, y = self.clawd_x + 9 * self.sc, self.clawd_y
            balao(ch, co, w, h, int(x), int(y) // 2 - 1, txt, int((t - t0) * 30))
        self.desenhar_caixa(ch, co)
        self.desenhar_plantao(ch, co)

    def desenhar_navio(self, px):
        w, ph, n, k = self.w, self.ph, self.nav, self.k
        if n["afunda"] > 80 * k:
            return
        x, y, a = self.pos_nav()
        furos = tuple(n["furos"])
        pintar_forma(px, w, ph, self.cache, ("navio", round(a, 2), furos),
                     lambda u, v: navio_em(u, v, furos=furos), x, y, k, a, (-36, 31, -51, 8))
        # a bandeira alvinegra no topo do mastro, tremulando
        for lx in range(1, 11):
            for ly in range(6):
                fx, fy = self.no_navio(lx * 1.0, -56 + ly + math.sin(self.t * 6 - lx * 0.7) * 0.8 * lx / 10)
                if 0 <= int(fx) < w and 0 <= int(fy) < ph:
                    px[int(fy) * w + int(fx)] = CAM_PRETO if (lx // 2) % 2 else CAM_BRANCO
        mx, my = self.pos_mau()
        m = self.mau
        br = (round(m["bracos"][0], 1), round(m["bracos"][1], 1))
        chapeu = None if self.chapeu else "pirata"
        verm = round(m["vermelho"], 1)
        pintar_forma(px, w, ph, self.cache, ("mau", m["cara"], br, chapeu, verm, round(a, 2)),
                     lambda u, v: maumau_em(u, v, m["cara"], br, chapeu, vermelho=verm), mx, my, self.Rm, a)
        if self.galinho == "vivo":
            gx, gy = self.pos_galinho()
            arte = GALINHO_CANTA if self.t - self.canta < 1.0 else GALINHO
            s = self.sg
            for (xx, yy), c in arte_pixels(arte, int(gx - 4 * s), int(gy - 6 * s), s, CORES_GALO_ATL).items():
                if 0 <= xx < w and 0 <= yy < ph:
                    px[yy * w + xx] = c

    def afogar(self, px, antes):
        """O que ficou abaixo da linha d'água aparece esverdeado, por baixo do mar."""
        w, ph, t = self.w, self.ph, self.t
        x0, _, _ = self.pos_nav()
        k = self.k
        for y in range(self.raia + 1, ph):
            for x in range(max(0, int(x0 - 50 * k)), min(w, int(x0 + 45 * k))):
                if y < self.raia + 1 + math.sin(x * 0.4 + t * 2):
                    continue
                i = y * w + x
                if px[i] != antes[i]:
                    px[i] = misturar(px[i], antes[i], 0.65 + 0.3 * clamp((y - self.raia) / (14 * k)))

    def desenhar_bau(self, px):
        b, w, ph = self.bau, self.w, self.ph
        if not b or self.nav["estado"] != "ok" and b["estado"] != "boiando":
            return
        s = self.sg
        if b["estado"] in ("convés", "aberto"):
            b["x"], b["y"] = self.no_navio(-13, -6)
        bob = math.sin(self.t * 1.6) * self.k if b["estado"] == "boiando" else 0
        arte = BAU_ABERTO if b["estado"] == "aberto" else BAU
        x0, y0 = int(b["x"] - 6 * s), int(b["y"] + bob - len(arte) * s + (2 * s if b["estado"] == "boiando" else 0))
        for (xx, yy), c in arte_pixels(arte, x0, y0, s, CORES_BAU).items():
            if 0 <= xx < w and 0 <= yy < ph:
                px[yy * w + xx] = c
        if b["estado"] == "boiando":
            letreiro(px, w, ph, "TACA", b["x"], y0 - 5, 1, 0xF2C230, 0x3A2410)
        m = self.medalha
        if m and "sobe" in m:
            q = suave((self.t - m["sobe"]) / 1.0)
            mx = b["x"]
            my = y0 - q * 3 * self.k + math.sin(self.t * 2) * self.k * q
            m["x"], m["y"] = mx, my
            larg = abs(math.cos(self.t * 3))  # girando
            for (xx, yy), c in arte_pixels(MEDALHA, 0, 0, s, CORES_MEDALHA).items():
                x = int(mx + (xx - 3.5 * s) * max(0.2, larg))
                y = int(my - 10 * s + yy)
                if 0 <= x < w and 0 <= y < ph:
                    px[y * w + x] = c

    def desenhar_flutuantes(self, px):
        w, ph, s, k = self.w, self.ph, self.sg, self.k
        f = self.frango
        if f:
            if f["pousado"] and not f.get("boia") and self.nav["estado"] == "ok":
                f["x"], f["y"] = self.no_navio(-13, -6)
            if f["pousado"] or f.get("boia"):
                for (xx, yy), c in arte_pixels(FRANGO, int(f["x"] - 7 * s), int(f["y"] - 9 * s), s, CORES_FRANGO).items():
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = c
                if random.random() < 0.15:
                    self.parts.append([f["x"] + random.uniform(-4, 4) * s, f["y"] - 9 * s, 0.0, -6.0, 0xD8D8D8,
                                       self.t, 1.0, "fumaca"])
            else:  # caindo, depenadinho
                for dx in range(-2 * s, 2 * s + 1):
                    for dy in range(-2 * s, 2 * s + 1):
                        if dx * dx + dy * dy <= 4 * s * s and 0 <= int(f["x"]) + dx < w and 0 <= int(f["y"]) + dy < ph:
                            px[(int(f["y"]) + dy) * w + int(f["x"]) + dx] = 0xF4B8A0
        if self.chapeu:
            cx, cy = self.chapeu
            pintar_forma(px, w, ph, self.cache, "chapeu",
                         lambda u, v: maumau_em(u, v, chapeu="pirata") if v < -1.76 else None,
                         cx, cy + 1.6 * self.Rm, self.Rm, 0.0, (-0.9, 0.9, -2.35, -1.7))

    def desenhar_rival(self, px, longe):
        r = self.rival
        if not r:
            return
        w, ph, k, t = self.w, self.ph, self.k, self.t
        if r["tipo"] == "raja" and longe:
            kr = k * 0.6
            y = self.mar + (self.raia - self.mar) * 0.35 + math.sin(t * 1.1) * 0.6
            pintar_forma(px, w, ph, self.cache, ("raja",),
                         lambda u, v: navio_em(u, v, (0x1E8A3C, 0xF0F0F0), 0x1E8A3C, galo=False), r["x"], y, kr, 0.0,
                         (-36, 31, -51, 8))
            letreiro(px, w, ph, "RAJA", r["x"], y - 32 * kr, 1, 0xFFFFFF)
            for ly in range(int(4 * kr) + 1):  # a bandeira vermelha com a estrela verde
                for lx in range(int(7 * kr) + 1):
                    xx, yy = int(r["x"] + lx), int(y - 56 * kr + ly + math.sin(t * 6 - lx * 0.7) * 0.6)
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = 0x1E8A3C if (lx - 3) ** 2 + (ly - 2) ** 2 <= 1 else 0xC8281C
        elif r["tipo"] == "bota" and not longe:
            y = int(self.raia + 9 * k)
            x0 = int(r["x"] - 21 * k)
            L = int(42 * k)
            for xx in range(L):
                curva = int(((xx - L / 2) / (L / 2)) ** 4 * 2)
                for yy in range(curva, int(3 * k) + 1):
                    x, yp = x0 + xx, y + yy - 2
                    if 0 <= x < w and 0 <= yp < ph:
                        px[yp * w + x] = 0xF0F0F0 if yy == curva else 0x1A1A1A
            for i in range(10):  # os dez remadores
                rx = int(x0 + L * (i + 1) / 12)
                for yy in range(5):
                    for dx in (0, 1):
                        if 0 <= rx + dx < w and 0 <= y - 3 - yy < ph:
                            px[(y - 3 - yy) * w + rx + dx] = PELE_MAU if yy >= 3 else (CAM_PRETO if i % 2 else CAM_BRANCO)
                fase = math.sin(t * 9 + i * 0.3)
                for kk in range(int(4 * k)):
                    ox, oy = int(rx - r["vai"] * fase * kk * 0.6), int(y - 3 + kk)
                    if 0 <= ox < w and 0 <= oy < ph:
                        px[oy * w + ox] = 0x8A6A3A
            mx = x0 + (L if r["vai"] < 0 else 0)
            for yy in range(int(9 * k)):
                if 0 <= mx < w and 0 <= y - 3 - yy < ph:
                    px[(y - 3 - yy) * w + mx] = 0xD0D0D0
            for ly in range(int(5 * k)):  # a estrela solitária
                for lx in range(int(7 * k)):
                    xx, yy = mx + lx * (1 if r["vai"] < 0 else -1), int(y - 3 - 9 * k + ly + math.sin(t * 6 - lx) * 0.5)
                    estrela = abs(lx - 3.5 * k) + abs(ly - 2.5 * k) * 1.6 < 1.8 * k
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = 0xFFFFFF if estrela else 0x111111
            if r.get("medalha"):
                for (xx, yy), c in arte_pixels(MEDALHA, int(r["x"] - 3 * self.sg), int(y - 16 * k), self.sg,
                                               CORES_MEDALHA).items():
                    if 0 <= xx < w and 0 <= yy < ph:
                        px[yy * w + xx] = c

    def manchetes(self):
        n = self.placar
        m = ["Galo chega a mais uma final; torcida já separa a medalha de prata",
             "Raja Casablanca manda lembranças",
             "Botafogo confirma: com 10 dá pra ganhar do Galo",
