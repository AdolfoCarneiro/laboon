        self.escrever_px(x + 10, 78, j["nome"], self.TEXTO, self.TEXTO_SOMBRA)
        if j["genero"]:
            self.escrever_px(x + 11 + largura_gba(j["nome"]), 78, j["genero"], 0x3890F8 if j["genero"] == "♂" else 0xF86060, self.TEXTO_SOMBRA)
        self.nivel(x + 98, 78, j["nivel"])
