            "owwwooooo.........",
            ".owwwwwwwoooo.....",
            "..owwwwwwwwwwoo...",
            "..oowwwwwwwwwwwo..",
            "...owwowwowwwwwo..",
            "...owwowwowwwwo...",
            "....oo.oo.oooRo...")
    BAIXO = ("........oRo..",
             "......oowwo..",
             "....oowwwwwo.",
             "..oowwwwwwwo.",
             ".owwwwwwwwo..",
             "owwowwowwo...",
             "owwowwowo....",
             ".oo.oo.o.....")
    QUADROS = (CIMA, MEIO, BAIXO, MEIO)

    def asa(self, px, q, ax, ay, borda, miolo, atras=False):
        for j, linha in enumerate(q):
            if "R" in linha:
                rx, ry = linha.index("R"), j
        for j, linha in enumerate(q):
            for i, c in enumerate(linha):
                if c == ".":
                    continue
                pos = (ax + i - rx, ay + j - ry - (2 if atras else 0))
                px[pos] = miolo if c == "w" else borda

    def __init__(self, w, h):
        self.w, self.h = w, h
        self.corpo, self.pw, self.ph = rola_pixels(0.42, deitada=True)
        self.raiz = []
        for f in (0.5, 0.62):
            rx = int(self.pw * f)
            self.raiz.append((rx, min(y for (x, y) in self.corpo if x == rx) + 1))
        self.t = 0.0
        self.dur = random.uniform(3.2, 4.5)
        self.y0 = random.uniform(0.25, 0.65) * 2 * h
        self.estrelas = []

    def desenhar(self, ch, co, w, h, dt):
        self.t += dt
        p = self.t / self.dur
        if p > 1.15:
            return False
        x0 = int(-self.pw - 10 + p * (w + self.pw + 40))
        y0 = int(self.y0 + math.sin(self.t * 5) * 6 - self.ph / 2)
        px = {}
        meio = y0 + self.ph // 2
        for x in range(0, x0 + 8):
            onda = 1 if ((x // 5) + int(self.t * 10)) % 2 else 0
            for k, c in enumerate(self.ARCO):
                for e in (0, 1):
                    px[(x, meio - 6 + k * 2 + e + onda)] = c
        q = self.QUADROS[int(self.t * 9) % 4]
        self.asa(px, q, x0 + self.raiz[0][0], y0 + self.raiz[0][1], 0x8890A8, 0xC8CEE0, atras=True)
        for (x, y), c in self.corpo.items():
            px[(x + x0, y + y0)] = c
        self.asa(px, q, x0 + self.raiz[1][0], y0 + self.raiz[1][1], 0xA8B0C8, 0xFFFFFF)
        blit(ch, co, w, h, px)
        if random.random() < 0.6:
            self.estrelas.append([random.uniform(0, max(1, x0)), random.uniform(meio / 2 - 6, meio / 2 + 6), self.t])
        vivas = []
        for s in self.estrelas:
            if self.t - s[2] < 0.6:
                vivas.append(s)
                escrever(ch, co, w, h, int(s[0]), int(s[1]), random.choice("✦*+·"), random.choice((0xFFFFFF, 0xFFF4A0)))
        self.estrelas = vivas
        return True


