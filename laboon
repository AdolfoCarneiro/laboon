class GaloDoido(ComCanhao, Cena):
    """O Maumau montado num galo alvinegro gigante, vindo tirar satisfação com o Arsenal (\"quem atirou no meu
    primo?\"). O Clawd responde com o canhão: o galo pula a primeira, mas a segunda depena, e a terceira assa.
    O Maumau come o frango, cai um ovo do céu e... o OVO está evoluindo!"""
    combinavel = False
    peso = 0.8
    duracao = (55, 75)
    NOME = "MAUMAU"
    GRITO = ["AVANTE, GALO!", "Quem atirou no meu primo?!", "Hoje o Arsenal vai ver!", "GALOOO!",
             "Segura esse galo doido!"]
    PULOU = ["Errou! Mira de cruzeirense!", "Pulou! Galo é ligeiro!", "Passou por baixo!"]
    CAIU = ["MEU GALO!", "Depenaram o galo!", "Isso foi falta!"]
    ASSOU = ["Virou frango assado...", "NÃÃÃO!", "Era um galo tão bonito..."]
    COMENDO = ["Pelo menos tá bem temperado.", "Hmm... tá bom, viu?", "Já que tá aqui..."]
    CLAWD_FALA = ["Up the Arsenal!", "Vem, galinho, vem...", "Aqui não, galo!", "Fica paradinho aí..."]
    CLAWD_FESTA = ["Gooooner!", "Frango assado no ponto!", "Cocoricó é o caramba!"]

    def iniciar(self):
        w, h = self.w, self.h
        ph = self.ph = 2 * h
        self.k = max(0.6, min(w / 174, ph / 98))
        self.c = self.k
        self.sc = max(1, round(self.k))
        self.gs = max(2, round(2.1 * self.k))   # escala do galo gigante
        self.g = ph * 1.0
        self.chao = ph - max(5, int(ph * 0.07))
        self.Rm = 6.4 * self.k
        self.cache = {}
        self.fundo = self.montar_fundo()
        self.px = [0] * (w * ph)
        self.t = self.dt = 0.0
        self.can_alvo = 13 * self.c + 18 * self.sc + 2
        self.can = dict(x=-30 * self.c, ang=-0.25, giro=0.0, recuo=0.0)
        self.passo = False
        self.bala = None
        self.disparo = -10.0
        self.parts = []
        self.falas = {}
        self.caixa = None
        self.onomato = []
        self.faixa = None
        self.festa_ate = -10.0
        self.placar = 0
        self.base = w * 0.56
        self.galo = dict(x=w + 4.0, estado="correndo", pulo=-10.0, canta=-10.0, comido=0.0, evolui=None)
        self.mau = dict(estado="montado", x=0.0, y=0.0, vx=0.0, vy=0.0, cara="rindo", bracos=(2.8, 0.3))
        self.gen = self.roteiro()

    # --- cenário

    def montar_fundo(self):
        w, ph, chao = self.w, self.ph, self.chao
        px = [0] * (w * ph)
        for y in range(chao):
            base = misturar(0x4A90D8, 0xBFE0F4, y / chao)
            for x in range(w):
                n = math.sin(x * 0.05 + y * 0.4) + math.sin(x * 0.13 - y * 0.2)
                px[y * w + x] = misturar(base, 0xFFFFFF, 0.7) if y < chao * 0.45 and n > 1.55 else base
        # a Serra do Curral lá atrás, em duas camadas
        for camada, (alt, cor, f) in enumerate(((0.36, 0x5A7A8A, 0.021), (0.24, 0x3E6A4A, 0.034))):
            for x in range(w):
                topo = chao - ph * alt * (0.6 + 0.25 * math.sin(x * f + camada * 2) + 0.15 * math.sin(x * f * 3.3))
                for y in range(max(0, int(topo)), chao):
                    px[y * w + x] = cor
        for y in range(chao, ph):
            for x in range(w):
                px[y * w + x] = 0x3E8A3A if (x // 6 + (y - chao) // 2) % 2 else 0x4A9A44
        # a placa da estrada
        pl = int(w * 0.36)
        txt = "LONDRES"
        larg = 6 * len(txt) + 3
        topo = int(chao - ph * 0.3)
        for y in range(topo, chao):
            px[y * w + pl] = 0x7A7A80
        for y in range(topo - 4, topo + 5):
            for x in range(pl - larg // 2, pl + larg // 2 + 1):
                if 0 <= x < w:
                    px[y * w + x] = 0x1E6A3A if topo - 3 <= y <= topo + 3 and abs(x - pl) < larg // 2 else 0xF0F0F0
        letreiro(px, w, ph, txt, pl + 1, topo + 0.5, 1, 0xFFFFFF)
        return px

    # --- o galo e o Maumau

    def arte_galo(self):
        g = self.galo
        if g["estado"] in ("correndo", "fugindo", "avanca"):
            return GALO_CORRE[int(self.t * 8) % 2]
        if self.t - g["canta"] < 1.2:
            return GALO_ATL_CANTA
        return GALO_ATL

    def topo_galo(self):
        g, gs = self.galo, self.gs
        y = self.chao - len(GALO_ATL) * gs
        p = self.t - g["pulo"]
        if p < 0.9:
            y -= math.sin(p / 0.9 * math.pi) * 22 * self.k
        elif g["estado"] in ("correndo", "avanca"):
            y -= abs(math.sin(self.t * 8)) * 1.5 * self.k
        return y

    def pos_montado(self):
        """Cintura do Maumau sentado no lombo do galo."""
        g, gs = self.galo, self.gs
        return g["x"] + 9.5 * gs, self.topo_galo() + 8 * gs

    def falar(self, txt, quem="mau"):
        self.falas[quem] = (txt, self.t)

    # --- roteiro

    def roteiro(self):
        yield from self.entrada()
        while True:
            yield from self.ataque()
            yield from self.assar()
            yield from self.comer()
            yield from self.evolucao()

    def correr_ate(self, alvo, vel, estado="correndo"):
        g = self.galo
        g["estado"], g["dir"] = estado, 1 if alvo > g["x"] else -1
        while abs(g["x"] - alvo) > 0.5:
            g["x"] += max(-vel * self.dt, min(vel * self.dt, alvo - g["x"]))
            if random.random() < 0.5:
                self.parts.append([g["x"] + random.uniform(8, 12) * self.gs, self.chao - 1.0, random.uniform(5, 20),
                                   random.uniform(-10, -3), 0xC8B890, self.t, 0.6, "fumaca"])
            yield
        g["estado"], g["dir"] = "parado", -1

    def entrada(self):
        m = self.mau
        m.update(estado="montado", cara="rindo", bracos=(2.8, 0.3))
        yield from self.esperar(0.5)
        self.falar(random.choice(self.GRITO))
        yield from self.correr_ate(self.base, self.w * 0.25)
        self.galo["canta"] = self.t
        self.falar("CÓCÓRICÓÓÓ!", "galo")
        yield from self.esperar(1.6)

    def ataque(self):
        g, m = self.galo, self.mau
        if self.can["x"] < self.can_alvo:
            yield from self.trazer_canhao()
        self.falar(random.choice(self.CLAWD_FALA), "clawd")
        m["cara"], m["bracos"] = "bravo", (2.8, 2.8)
        self.falar(random.choice(self.GRITO))
        yield from self.esperar(1.2)
        gs = self.gs
        if random.random() < 0.6:
            yield from self.atirar(lambda tt: (g["x"] + 5 * gs, self.chao - 0.5), "pula", 1.0)
            g["pulo"] = self.t + 0.55
            while self.bala:
                yield
            m["cara"], m["bracos"] = "rindo", (2.8, 0.3)
            self.falar(random.choice(self.PULOU))
            yield from self.esperar(2.4)
        yield from self.atirar(lambda tt: (g["x"] + 6 * gs, self.topo_galo() + 8 * gs), "acerta")
        while self.bala:
            yield
        yield from self.esperar(2.0)

    def depenar(self, x, y):
        g, m, t = self.galo, self.mau, self.t
        g["estado"] = "depenado"
        for _ in range(60):
            self.parts.append([x + random.uniform(-6, 6) * self.gs, y + random.uniform(-4, 4) * self.gs,
                               random.uniform(-40, 40), random.uniform(-50, 0),
                               random.choice((0x1E1E1E, 0x1E1E1E, 0xF0F0F0, 0xD8261C)), t, random.uniform(2.0, 3.5),
                               "pena"])
        self.onomato.append(("POF!", x, y - 10, t, 0xFFFFFF))
        mx, my = self.pos_montado()
        m.update(estado="voando", x=mx, y=my, vx=min(self.w * 0.08, (self.w - 8 * self.k - mx) / 1.4), vy=-self.ph * 0.5, cara="assustado",
                 bracos=(math.pi / 2, math.pi / 2))
        self.falar(random.choice(self.CAIU))
        self.falar("CÓ CÓ CÓ!", "galo")
        self.placar += 1
        self.faixa = (f"ARSENAL {self.placar} X 0 GALO", t)
        self.festa_ate = t + 3.0
        self.falar(random.choice(self.CLAWD_FESTA), "clawd")

    def assar(self):
        g = self.galo
        yield from self.esperar(1.2)
        yield from self.correr_ate(self.w + 4, self.w * 0.45, "fugindo")
        yield from self.esperar(1.0)
        self.falar("Volta aqui, frango!", "clawd")
        yield from self.correr_ate(self.base, self.w * 0.3, "fugindo")
        g["estado"] = "fugindo"
        yield from self.atirar(lambda tt: (g["x"] + 6 * self.gs, self.topo_galo() + 9 * self.gs), "assa", 0.9)
        while self.bala:
            yield
        m = self.mau
        m["cara"], m["bracos"] = "triste", (0.1, 0.1)
        self.falar(random.choice(self.ASSOU))
        yield from self.esperar(3.0)

    def comer(self):
        g, m = self.galo, self.mau
        m["cara"], m["bracos"] = "normal", (0.3, 0.3)
        alvo = g["x"] + len(FRANGO[0]) * self.gs + 3 * self.k
        while abs(m["x"] - alvo) > 0.5:  # vai até o frango
            m["x"] += max(-12 * self.k * self.dt, min(12 * self.k * self.dt, alvo - m["x"]))
            yield
        self.falar(random.choice(self.COMENDO))
        m["cara"], m["bracos"] = "mastigando", (2.4, 0.3)
        ini = self.t
        while self.t - ini < 4.0:
            g["comido"] = suave((self.t - ini) / 4.0)
            m["cara"] = "mastigando" if int(self.t * 6) % 2 else "normal"
            if int(self.t * 1.4) != int((self.t - self.dt) * 1.4):
                self.onomato.append(("NHAC!", m["x"] - 4 * self.k, m["y"] - 2.6 * self.Rm, self.t, 0xFFFFFF))
            yield
        g["estado"] = None
        m["cara"], m["bracos"] = "rindo", (0.2, 0.2)
        l1 = f"{self.NOME} comeu o FRANGO ASSADO!"
        self.caixa = [l1, "", self.t]
        yield from self.esperar(2.0)
        self.caixa = [l1, f"{self.NOME} recuperou 20 HP!", self.t - len(l1) / 30]
        yield from self.esperar(2.4)
        self.caixa = None

    def evolucao(self):
        g, m = self.galo, self.mau
        g.update(estado="ovo", x=self.base, comido=0.0, oy=-30.0, ovy=0.0)
        while g["oy"] < 0:  # o ovo cai do céu
            g["ovy"] += self.g * self.dt
            g["oy"] = min(0.0, g["oy"] + g["ovy"] * self.dt * 0.3)
            yield
        self.onomato.append(("TOC!", g["x"] + 10 * self.gs, self.chao - 12 * self.k, self.t, 0xFFFFFF))
        m["cara"], m["bracos"] = "assustado", (0.3, 0.3)
        yield from self.esperar(1.0)
        self.caixa = ["Ué? O OVO está evoluindo!", "", self.t]
        g["evolui"] = self.t
        yield from self.esperar(4.0)
        g["evolui"] = None
        g["estado"] = "parado"
        self.flash = self.t
        self.caixa = ["Parabéns! O OVO evoluiu", "para GALO DOIDO!", self.t]
        m["cara"], m["bracos"] = "rindo", (2.8, 2.8)
        yield from self.esperar(2.6)
        self.caixa = None
        # o Maumau sobe de volta no galo
        mx, my = self.pos_montado()
        x0, y0, ini = m["x"], m["y"], self.t
        m["estado"] = "pulando"
        while self.t - ini < 0.8:
            q = (self.t - ini) / 0.8
            m["x"], m["y"] = x0 + (mx - x0) * q, y0 + (my - y0) * q - math.sin(q * math.pi) * 14 * self.k
            yield
        m["estado"], m["bracos"] = "montado", (2.8, 0.3)
        g["canta"] = self.t
        self.falar("CÓCÓRICÓÓÓ!", "galo")
        yield from self.esperar(1.6)

    flash = -10.0

    # --- atualização

    def galo_em(self, x, y):
        g, gs = self.galo, self.gs
        if g["estado"] in (None, "ovo", "assado"):
            return False
        ax, ay = int((x - g["x"]) / gs), int((y - self.topo_galo()) / gs)
        arte = self.arte_galo()
        return 0 <= ay < len(arte) and 0 <= ax < len(arte[0]) and arte[ay][ax] != "."

    def colidir(self, b):
        if b["tipo"] in ("acerta", "assa") and self.galo_em(b["x"], b["y"]):
            if b["tipo"] == "acerta":
                self.depenar(b["x"], b["y"])
            else:
                g = self.galo
                g["estado"] = "assado"
                self.onomato.append(("BUM!", b["x"], b["y"] - 10, self.t, 0xFFE040))
                for _ in range(40):
                    self.parts.append([b["x"] + random.uniform(-8, 8) * self.gs, b["y"], random.uniform(-25, 25),
                                       random.uniform(-40, -5), random.choice((0xFFF2A0, 0xFFB040, 0xFF6020)),
                                       self.t, random.uniform(0.4, 0.9), "faisca"])
                self.festa_ate = self.t + 3.0
                self.falar(random.choice(self.CLAWD_FESTA), "clawd")
            self.bala = None

    def atualizar(self, dt):
        self.recuar()
        self.atualizar_bala(dt)
        m = self.mau
        if m["estado"] == "montado":
            m["x"], m["y"] = self.pos_montado()
        elif m["estado"] == "voando":
            m["vy"] += self.g * 0.8 * dt
            m["x"] += m["vx"] * dt
            m["y"] += m["vy"] * dt
            pe = self.chao - 1.78 * self.Rm
            if m["y"] >= pe and m["vy"] > 0:
                m["y"], m["estado"] = pe, "chao"
                self.onomato.append(("TUM!", m["x"], pe - 2 * self.Rm, self.t, 0xFFFFFF))
                m["cara"], m["bracos"] = "triste", (0.1, 0.1)

    # --- desenho

    def draw(self, t, dt, ch, co):
        self.t, self.dt = t, dt
        next(self.gen)
        self.atualizar(dt)
        w, h, ph = self.w, self.h, self.ph
        px = self.px
        px[:] = self.fundo
        self.desenhar_galo(px)
        self.desenhar_canhao(px)
        self.desenhar_clawd(px)
        self.desenhar_bala(px)
        self.desenhar_parts(px, dt)
        p = t - self.flash
        if p < 0.3:
            for i in range(len(px)):
                px[i] = misturar(px[i], 0xFFFFFF, 0.8 * (1 - p / 0.3))
        self.desenhar_letreiros(px)
        pixels_para_celulas(px, w, h, ch, co)
        for quem, (txt, t0) in list(self.falas.items()):
            if t - t0 > 3.0:
                del self.falas[quem]
                continue
            if quem == "mau":
                x, y = self.mau["x"], self.mau["y"] - 2.4 * self.Rm
            elif quem == "galo":
                x, y = self.galo["x"] + 2 * self.gs, self.topo_galo() - 1
            else:
                x, y = self.clawd_x + 9 * self.sc, self.clawd_y
            balao(ch, co, w, h, int(x), int(y) // 2 - 1, txt, int((t - t0) * 30))
        self.desenhar_caixa(ch, co)
        self.desenhar_plantao(ch, co)

    def desenhar_mau(self, px):
        m = self.mau
        br = (round(m["bracos"][0], 1), round(m["bracos"][1], 1))
        ang = m["vx"] * 0.004 * (self.t * 8 % 6.28) if m["estado"] == "voando" else 0.0
        pintar_forma(px, self.w, self.ph, self.cache, ("gd", m["cara"], br, round(ang, 1)),
                     lambda u, v: maumau_em(u, v, m["cara"], br), m["x"], m["y"], self.Rm, round(ang, 1))

    def pintar_arte(self, px, arte, x0, y0, s, cores, ate=None):
        w, ph = self.w, self.ph
        for (xx, yy), c in arte_pixels(arte, int(x0), int(y0), s, cores).items():
            if 0 <= xx < w and 0 <= yy < ph and (ate is None or xx < ate):
                px[yy * w + xx] = c

    def desenhar_galo(self, px):
        g, gs, m = self.galo, self.gs, self.mau
        e = g["estado"]
        montado = m["estado"] in ("montado", "pulando")
        if montado:
            self.desenhar_mau(px)  # as pernas ficam escondidas atrás do galo
        if e in ("correndo", "parado", "avanca"):
            self.pintar_arte(px, self.arte_galo(), g["x"], self.topo_galo(), gs, CORES_GALO_ATL)
        elif e in ("depenado", "fugindo"):
            arte = GALO_CORRE[int(self.t * 12) % 2] if e == "fugindo" else GALO_ATL
            if g.get("dir", -1) > 0:  # fugindo pra direita, de costas pro canhão
                arte = [l[::-1] for l in arte]
            self.pintar_arte(px, arte, g["x"], self.topo_galo(), gs, CORES_DEPENADO)
        elif e == "assado":
            fs = max(1, gs - 1) + 1
            x0 = g["x"]
            y0 = self.chao - len(FRANGO) * fs
            larg = len(FRANGO[0]) * fs
            self.pintar_arte(px, FRANGO, x0, y0, fs, CORES_FRANGO, ate=int(x0 + larg * (1 - 0.85 * g["comido"])))
            if random.random() < 0.3 and g["comido"] < 0.8:
                self.parts.append([x0 + random.uniform(0.2, 0.6) * larg, y0, 0.0, -8.0, 0xE0E0E0, self.t, 1.2, "fumaca"])
        elif e == "ovo":
            s = gs
            y0 = self.chao - len(OVO) * s + g.get("oy", 0)
            x0 = g["x"] + 7 * gs
            if g["evolui"] is not None:  # pisca branco, alternando entre o ovo e o galo, cada vez mais rápido
                p = self.t - g["evolui"]
                per = max(0.06, 0.5 - p * 0.12)
                branco = {c: 0xFFFFFF for c in "NnLWKYRwk"}
                if int(p / per) % 2:
                    self.pintar_arte(px, GALO_ATL, g["x"], self.chao - len(GALO_ATL) * gs, gs, branco)
                else:
                    self.pintar_arte(px, OVO, x0, y0, s, branco)
            else:
                balanco = int(math.sin(self.t * 12) * 1.2) if self.t % 2 < 0.6 else 0
                self.pintar_arte(px, OVO, x0 + balanco, y0, s, CORES_OVO)
        if not montado:
            self.desenhar_mau(px)

    def manchetes(self):
        n = self.placar
        m = ["Galo parte pra cima do Arsenal montado no próprio mascote",
             "Ornitólogos confirmam: galo doido não é espécie protegida",
             "Maumau diz que o frango estava ótimo",
             "Galo segue sem título em Londres",
             "Ovo alvinegro cai do céu; especialistas dizem que é normal",
             "Placa na estrada indica: Londres, 9 mil km. Galo vai a pé"]
        if n:
            m.insert(1, f"Galo é depenado pela {n}ª vez")
        return m


