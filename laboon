# ------------------------------------------------ easter egg: o logo do fastfetch (mesmo desenho do gerar-logo.py)

ROLA_CORES = {"glande": (0xFFC4D4, 0xF08CAA, 0xC45A80), "corpo": (0xFFE2CC, 0xF2B898, 0xC8886C),
              "bola": (0xF6C4B4, 0xDA9A8A, 0xA86C62), "fenda": (0x80324A, 0x80324A, 0x80324A)}
ROLA_SHINY = {"glande": (0xE0D0FF, 0xB098F0, 0x7860C0), "corpo": (0xD8F4FF, 0xA0D4F0, 0x6898C0),
              "bola": (0xD0ECF8, 0x98C4E0, 0x6890B0), "fenda": (0x40306A, 0x40306A, 0x40306A)}
_LUZ_ROLA = (-0.55 / 0.993, -0.6 / 0.993, 0.58 / 0.993)


def rola_regiao(x, y):
    """Parte do desenho no ponto (x, y) do espaço 76x92 do logo: (parte, nx, ny) ou None."""
    cx = 38
    dx, dy = (x - cx) / 15.5, (y - 20) / 16
    if dx * dx + dy * dy <= 1 and y <= 29:
        if abs(x - cx) < 1.1 and 5 <= y <= 11:
            return ("fenda", 0.0, 0.0)
        return ("glande", dx * 0.9, dy * 0.9)
    for bx in (cx - 13, cx + 13):
        ddx, ddy = (x - bx) / 15.5, (y - 74) / 15.5
        if ddx * ddx + ddy * ddy <= 1:
            return ("bola", ddx, ddy)
    if cx - 12 <= x <= cx + 12 and 24 <= y <= 70:
        return ("corpo", (x - cx) / 12.5, 0.0)
    return None


def rola_luz(nx, ny):
    nz = math.sqrt(max(0.0, 1 - nx * nx - ny * ny))
    return max(0.0, nx * _LUZ_ROLA[0] + ny * _LUZ_ROLA[1] + nz * _LUZ_ROLA[2])


def rola_pixels(esc, deitada=False, cores=ROLA_CORES, carinha=False, contorno=0x4A2228):
    """Desenho em pixels com sombreado e contorno; deitada = apontando pra direita. Devolve (dict, largura, altura)."""
    W, H = 76, 92
    pw, ph = (int(H * esc) + 2, int(W * esc) + 2) if deitada else (int(W * esc) + 2, int(H * esc) + 2)
    grade = {}
    for py in range(ph):
        for px in range(pw):
            if deitada:
                x, y = (py - 0.5) / esc, (pw - 1.5 - px) / esc
            else:
                x, y = (px - 0.5) / esc, (py - 0.5) / esc
            r = rola_regiao(x, y)
            if r:
                grade[(px, py)] = r
    out = {}
    for (px, py), (parte, nx, ny) in grade.items():
        tons = cores[parte]
        b = rola_luz(nx, ny)
        c = tons[0] if b > 0.78 else tons[1] if b > 0.42 else tons[2]
        for q in ((px + 1, py), (px - 1, py), (px, py + 1), (px, py - 1)):
            g = grade.get(q)
            if g and g[0] != parte and "fenda" not in (parte, g[0]) and (parte == "glande" or g[0] == "bola"):
                c = tons[2]
                break
        out[(px, py)] = c
    for (px, py) in list(grade):
        for q in ((px + 1, py), (px - 1, py), (px, py + 1), (px, py - 1)):
            if q not in grade:
                out[q] = contorno
    if carinha and not deitada:
        r_olho = max(1.0, esc * 2.4)
        for ex in (31.5, 44.5):
            cx_, cy_ = 0.5 + ex * esc, 0.5 + 17 * esc
            for py in range(int(cy_ - r_olho) - 1, int(cy_ + r_olho) + 2):
                for px in range(int(cx_ - r_olho) - 1, int(cx_ + r_olho) + 2):
                    if (px + 0.5 - cx_) ** 2 + (py + 0.5 - cy_) ** 2 <= r_olho * r_olho:
                        out[(px, py)] = 0x202020
            out[(int(cx_ - r_olho * 0.4), int(cy_ - r_olho * 0.4))] = 0xFFFFFF
        for k in range(-3, 4):
            px = int(0.5 + (38 + k * 1.6) * esc)
            py = int(0.5 + (22.5 + (9 - k * k) * 0.3) * esc)
            out[(px, py)] = 0x7A2A3A
    return out, pw, ph


def sprite_rola_gba(shiny=False):
    """Sprite 64x64 (grade de cores) do Pokémon secreto."""
    esc = 58 / 92
    px, pw, ph = rola_pixels(esc, cores=ROLA_SHINY if shiny else ROLA_CORES, carinha=True)
    ox, oy = (64 - pw) // 2, 63 - ph
    grade = [[0] * 64 for _ in range(64)]
    for (x, y), c in px.items():
        if 0 <= x + ox < 64 and 0 <= y + oy < 64:
            grade[y + oy][x + ox] = c
    return grade


