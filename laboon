def largura_gba(txt):
    return sum(3 if c == " " else len(FONTE_GBA.get(c, FONTE_GBA["?"])[0]) + 1 for c in txt)


def quebrar_gba(txt, maximo):
    linhas, atual = [], ""
    for p in txt.split():
        teste = atual + " " + p if atual else p
        if atual and largura_gba(teste) > maximo:
            linhas.append(atual)
            atual = p
        else:
            atual = teste
    if atual:
        linhas.append(atual)
    return linhas or [""]


def pixels_para_celulas_k(px, vw, k, w, h, ch, co, desloc=0):
    """Como pixels_para_celulas, mas com o buffer virtual ampliado k vezes (e deslocado pra tremer)."""
    lim = len(px)
    for y in range(h):
        ra = ((2 * y) // k) * vw
        rb = ((2 * y + 1) // k) * vw
        c0 = y * w
        for x in range(w):
            sx = (x - desloc) // k
            if sx < 0 or sx >= vw:
                ch[c0 + x] = " "
                continue
            ia, ib = ra + sx, rb + sx
            a = px[ia] if ia < lim else 0
            b = px[ib] if ib < lim else 0
            i = c0 + x
            if a == b:
                if a:
                    ch[i], co[i] = "█", a
                else:
                    ch[i] = " "
            elif not b:
                ch[i], co[i] = "▀", a
            elif not a:
                ch[i], co[i] = "▄", b
            else:
                ch[i], co[i] = "▀", a | (b << 24) | BG


