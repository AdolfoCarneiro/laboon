class Rasterizador:
    """Desenha a grade de células (ch, co) numa imagem 1920x1080 do jeito que o Konsole mostra."""

    def __init__(self, largura=1920, altura=1080):
        from PIL import Image, ImageDraw, ImageFont
        self.Image, self.ImageDraw, self.ImageFont = Image, ImageDraw, ImageFont
        self.L, self.A = largura, altura
        self.fontes, self.mascaras, self.arquivos = {}, {}, {}

    def fonte(self, arq, px):
        if (arq, px) not in self.fontes:
            self.fontes[(arq, px)] = self.ImageFont.truetype(arq, px)
        return self.fontes[(arq, px)]

    def tem_glifo(self, f, c):
        m, vazio = f.getmask(c), f.getmask("\uffff")
        return m.size != vazio.size or bytes(m) != bytes(vazio)

    def arquivo_para(self, c, px):
        if c not in self.arquivos:
            escolhido = FONTE_VIDEO
            if not self.tem_glifo(self.fonte(FONTE_VIDEO, px), c):
                try:
                    r = subprocess.run(["fc-list", f":charset={ord(c):x}", "file"], capture_output=True, text=True, timeout=5)
                    arqs = sorted({l.split(":")[0] for l in r.stdout.splitlines() if l.strip()},
                                  key=lambda a: ("Mono" not in a, not a.endswith((".ttf", ".otf")), a))
                except Exception:
                    arqs = []
                for arq in arqs:
                    try:
                        if self.tem_glifo(self.fonte(arq, px), c):
                            escolhido = arq
                            break
                    except Exception:
                        continue
            self.arquivos[c] = escolhido
        return self.arquivos[c]

    def mascara(self, c, cw, chh, px):
        chave = (c, cw, chh, px)
        if chave not in self.mascaras:
            f = self.fonte(self.arquivo_para(c, px), px)
            im = self.Image.new("L", (cw, chh), 0)
            asc, desc = f.getmetrics()
            self.ImageDraw.Draw(im).text(((cw - f.getlength(c)) / 2, (chh - asc - desc) / 2), c, font=f, fill=255)
            self.mascaras[chave] = im
        return self.mascaras[chave]

    def quadro(self, ch, co, w, h, perfil):
        return self.imagem(ch, co, w, h, perfil).tobytes()

    def parede(self, fps=30):
        """Papel de parede atual (o da ilha; sem ele, o antigo do KDE), cortado pra preencher 1920x1080."""
        caminho = os.path.realpath(os.path.expanduser("~/.local/state/denden/current/background"))
        if not os.path.isfile(caminho):
            try:
                r = subprocess.run(["kreadconfig6", "--file", "kscreenlockerrc", "--group", "Greeter", "--group", "Wallpaper",
                                    "--group", "org.kde.image", "--group", "General", "--key", "Image"],
                                   capture_output=True, text=True, timeout=5)
                caminho = r.stdout.strip().removeprefix("file://")
            except Exception:
                return None
        if caminho.lower().endswith((".mp4", ".webm", ".mkv", ".mov")):
            try:
                return ParedeVideo(caminho, self.L, self.A, fps, self.Image)
            except Exception:
                return None
        try:
            im = self.Image.open(caminho).convert("RGB")
        except Exception:
            return None
        esc = max(self.L / im.width, self.A / im.height)
        im = im.resize((int(im.width * esc + 0.5), int(im.height * esc + 0.5)), self.Image.LANCZOS)
        x0, y0 = (im.width - self.L) // 2, (im.height - self.A) // 2
        return ParedeImagem(im.crop((x0, y0, x0 + self.L, y0 + self.A)))

    def imagem(self, ch, co, w, h, perfil):
        from array import array
        _c, _l, cw, chh, px = PERFIS_VIDEO[perfil]
        camada = array("I", bytes(4 * w * 2 * h))
        texto = []
        for y in range(h):
            base, cima = y * w, 2 * y * w
            baixo = cima + w
            for x in range(w):
                c = ch[base + x]
                if c == " ":
                    continue
                k = co[base + x]
                fg = k & 0xFFFFFF
                bg = (k >> 24) & 0xFFFFFF if k & BG else 0
                if c == "█":
                    camada[cima + x] = camada[baixo + x] = fg
                elif c == "▀":
                    camada[cima + x], camada[baixo + x] = fg, bg
                elif c == "▄":
                    camada[cima + x], camada[baixo + x] = bg, fg
                else:
                    if bg:
                        camada[cima + x] = camada[baixo + x] = bg
                    texto.append((x, y, c, fg))
        img = self.Image.frombytes("RGBX", (w, 2 * h), camada.tobytes(), "raw", "BGRX").convert("RGB")
        img = img.resize((w * cw, h * chh), self.Image.NEAREST)
        tela = self.Image.new("RGB", (self.L, self.A))
        tela.paste(img, (0, 0))
        for x, y, c, fg in texto:
            tela.paste(((fg >> 16) & 255, (fg >> 8) & 255, fg & 255), (x * cw, y * chh), self.mascara(c, cw, chh, px))
        return tela


class ParedeImagem:
    """Papel de parede parado: todo quadro é a mesma imagem."""

    def __init__(self, im):
        self.im = im

    def quadros(self, inicio=0):
        while True:
            yield self.im


class ParedeVideo:
    """Papel de parede em vídeo: quadros em loop, 1920x1080 cortado, a partir de qualquer posição do loop."""

    def __init__(self, caminho, L, A, fps, Image):
        dur = float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", caminho],
                                   capture_output=True, text=True, timeout=10).stdout.strip())
        self.caminho, self.L, self.A, self.fps, self.Image = caminho, L, A, fps, Image
        self.n = max(1, round(dur * fps))
        self.procs = []

    def quadros(self, inicio=0):
        p = subprocess.Popen(["ffmpeg", "-v", "error", "-stream_loop", "-1", "-i", self.caminho, "-an",
                              "-vf", f"fps={self.fps},scale={self.L}:{self.A}:force_original_aspect_ratio=increase,"
                                     f"crop={self.L}:{self.A}", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.procs.append(p)
        tam = self.L * self.A * 3
        for _ in range(inicio % self.n):
            p.stdout.read(tam)
        while True:
            bruto = p.stdout.read(tam)
            if len(bruto) < tam:
                return
            yield self.Image.frombytes("RGB", (self.L, self.A), bruto)

    def fechar(self):
        for p in self.procs:
            p.kill()


def gerar_video(saida, minutos=25.0, fps=30):
    """Roda o mesmo rodízio de cenas sem terminal e grava um vídeo 1920x1080 (começa e termina no preto, pra emendar)."""
    ras = Rasterizador()
    parcial = saida + ".parcial.mp4"
    ff = subprocess.Popen(["ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", "1920x1080",
                           "-r", str(fps), "-i", "-", "-an", "-c:v", "libx264", "-preset", "medium", "-crf", "26",
                           "-tune", "animation", "-threads", "2", "-rc-lookahead", "10",
                           "-pix_fmt", "yuv420p", "-movflags", "+faststart", parcial],
                          stdin=subprocess.PIPE)

    def perfil_de(cena):
        return getattr(cena, "perfil", None) or "normal"

    dt, total = 1 / fps, int(minutos * 60 * fps)
    fim_escuro = total + 1
    atual, pendente, encerrando = sortear_cena(), None, False
    perfil = perfil_de(atual)
    w, h = PERFIS_VIDEO[perfil][:2]
    atual.resize(w, h)
    prox = None
    A_ch, A_co, B_ch, B_co = [" "] * (w * h), [0] * (w * h), [" "] * (w * h), [0] * (w * h)
    mask, cor_borda = mascara(w, h), 0xB0FFB0
    t_atual = t_prox = 0.0
    troca = random.uniform(*atual.duracao)
    extras = Extras()
    parede = ras.parede(fps)
    funde = int(3 * fps)
    abertura = int(60 * fps)
    if parede is not None:
        # o vídeo final em loop: abertura + rodízio + fim. O fim acaba no último quadro do loop do papel de parede,
        # então o recomeço (quadro 0) emenda sem pulo.
        quadros = parede.quadros(0)
        for _ in range(abertura):
            ff.stdin.write(next(quadros).tobytes())
        n_loop = getattr(parede, "n", 1)
        fim = parede.quadros(-funde % n_loop) if n_loop > 1 else quadros
    inicio = time.monotonic()
    for f in range(total):
        t_atual += dt
        atual.draw(t_atual, dt, A_ch, A_co)
        if prox:
            t_prox += dt
            prox.draw(t_prox, dt, B_ch, B_co)
            p = t_prox / TRANSICAO * 1.15 - 0.05
            borda = p - 0.07
            for i in range(w * h):
                m = mask[i]
                if m < borda:
                    A_ch[i], A_co[i] = B_ch[i], B_co[i]
                elif m < p:
                    A_ch[i], A_co[i] = random.choice(GLITCH), cor_borda
            if t_prox >= TRANSICAO:
                atual, t_atual, prox = prox, t_prox, None
                troca = t_atual + random.uniform(*atual.duracao)
                if pendente is not None and isinstance(atual, Preto):
                    perfil = perfil_de(pendente)
                    w, h = PERFIS_VIDEO[perfil][:2]
                    A_ch, A_co, B_ch, B_co = [" "] * (w * h), [0] * (w * h), [" "] * (w * h), [0] * (w * h)
                    atual.resize(w, h)
                    pendente.resize(w, h)
                    prox, pendente, t_prox = pendente, None, 0.0
                    mask = mascara(w, h)
        elif f >= fim_escuro and not encerrando:
            encerrando = True
            prox, t_prox = Preto(), 0.0
            prox.resize(w, h)
            mask = mascara(w, h)
        elif t_atual >= troca and not encerrando:
            nova = sortear_cena(atual)
            if perfil_de(nova) != perfil:
                pendente, prox = nova, Preto()
            else:
                prox = nova
            prox.resize(w, h)
            t_prox = 0.0
            mask = mascara(w, h)
            cor_borda = random.choice((0xB0FFB0, 0x80FFD0, 0xFFFFFF))
        extras.quadro(atual, t_atual, dt, A_ch, A_co, w, h)
        img = ras.imagem(A_ch, A_co, w, h, perfil)
        if parede is not None and f < funde:
            img = ras.Image.blend(next(quadros), img, f / funde)
        elif parede is not None and f >= total - funde:
            img = ras.Image.blend(img, next(fim), (f - (total - funde)) / funde)
        ff.stdin.write(img.tobytes())
        if f % (fps * 60) == 0:
            gasto = time.monotonic() - inicio
            print(f"{f // fps // 60:3d}/{minutos:.0f} min de vídeo, {gasto / 60:.1f} min gastos", flush=True)
    ff.stdin.close()
    ff.wait()
    if hasattr(parede, "fechar"):
        parede.fechar()
    if ff.returncode != 0:
        raise SystemExit("ffmpeg falhou")
    os.replace(parcial, saida)
    print("pronto:", saida, os.path.getsize(saida) // (1024 * 1024), "MB")


def main():
    fd = sys.stdin.fileno()
    antigo = termios.tcgetattr(fd)
    saida = sys.stdout
    term = terminal_atual()
    perfil_inicial = term.inicial
    perfil_atual = perfil_inicial

    def perfil_de(cena):
        return getattr(cena, "perfil", None) or perfil_inicial

    def trocar_perfil(nome):
        """Troca o perfil (fonte) e espera o terminal mudar de tamanho. Devolve o tamanho novo."""
        nonlocal perfil_atual
        if perfil_inicial and nome and nome != perfil_atual and term.trocar(nome):
            perfil_atual = nome
        return os.get_terminal_size()

    def cabe(cena, tam_):
        mn = getattr(cena, "min_px", None)
        return not mn or (tam_.columns >= mn[0] and 2 * tam_.lines >= mn[1])

    try:
        tty.setcbreak(fd)
        saida.write("\x1b]0;laboon\x07\x1b[?1049h\x1b[?25l\x1b[2J")
        saida.flush()
        tam = None
        forcar = sys.argv[sys.argv.index("--cena") + 1] if "--cena" in sys.argv else None
        forcar_prox = sys.argv[sys.argv.index("--proxima") + 1] if "--proxima" in sys.argv else None
        dur_teste = float(os.environ["SS_DURACAO"]) if os.environ.get("SS_DURACAO") else None
        atual = globals()[forcar]("verde") if forcar else sortear_cena()
        if perfil_de(atual) != perfil_atual:
            if not cabe(atual, trocar_perfil(perfil_de(atual))) and not forcar:
                trocar_perfil(perfil_inicial)
                atual = Matrix("verde")
        prox = pendente = None
        extras = Extras()
        t_atual = t_prox = 0.0
        troca = dur_teste or random.uniform(*atual.duracao)
        ultimo = time.monotonic()
        checar_lock = ultimo + 2
        while True:
            agora = time.monotonic()
            dt = min(0.1, agora - ultimo)
            ultimo = agora
            novo_tam = os.get_terminal_size()
            if novo_tam != tam:
                tam = novo_tam
                w, h = tam.columns, tam.lines
                A_ch, A_co = [" "] * (w * h), [0] * (w * h)
                B_ch, B_co = [" "] * (w * h), [0] * (w * h)
                atual.resize(w, h)
                if prox:
                    prox.resize(w, h)
                    mask = mascara(w, h)
                saida.write("\x1b[2J")
            t_atual += dt
            atual.draw(t_atual, dt, A_ch, A_co)
            if prox:
                t_prox += dt
                prox.draw(t_prox, dt, B_ch, B_co)
                p = t_prox / TRANSICAO * 1.15 - 0.05
                borda = p - 0.07
                for i in range(w * h):
                    m = mask[i]
                    if m < borda:
                        A_ch[i], A_co[i] = B_ch[i], B_co[i]
                    elif m < p:
                        A_ch[i], A_co[i] = random.choice(GLITCH), cor_borda
                if t_prox >= TRANSICAO:
                    atual, t_atual, prox = prox, t_prox, None
                    troca = t_atual + (dur_teste or random.uniform(*atual.duracao))
                    if pendente is not None and isinstance(atual, Preto):
                        # tela já está preta: troca a fonte e entra na cena nova com o dissolve normal
                        tam_novo = trocar_perfil(perfil_de(pendente))
                        if not cabe(pendente, tam_novo):
                            trocar_perfil(perfil_inicial)
                            pendente = sortear_cena(pendente)
                            while perfil_de(pendente) != perfil_inicial:
                                pendente = sortear_cena(pendente)
                        prox, pendente = pendente, None
                        tam = None
                        t_prox = 0.0
                        cor_borda = random.choice((0xB0FFB0, 0x80FFD0, 0xFFFFFF))
                        continue
            elif t_atual >= troca and not forcar:
                nova = globals()[forcar_prox]("verde") if forcar_prox else sortear_cena(atual)
                forcar_prox = None
                if perfil_de(nova) != perfil_atual:
                    pendente, prox = nova, Preto()
                else:
                    prox = nova
                prox.resize(w, h)
                t_prox = 0.0
                mask = mascara(w, h)
                cor_borda = random.choice((0xB0FFB0, 0x80FFD0, 0xFFFFFF))
            extras.quadro(atual, t_atual, dt, A_ch, A_co, w, h)
            saida.write(render(A_ch, A_co, w, h))
            saida.flush()
            if agora >= checar_lock:
                checar_lock = agora + 2
                if tela_bloqueada():
                    if os.environ.get("SS_DEBUG"):
                        print("saiu: tela bloqueada", file=sys.stderr)
                    return
            espera = max(0.0, 1 / FPS - (time.monotonic() - agora))
            if select.select([fd], [], [], espera)[0]:
                if os.environ.get("SS_DEBUG"):
                    print("saiu: stdin", repr(os.read(fd, 64)), file=sys.stderr)
                return
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, antigo)
        saida.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        saida.flush()
        if perfil_inicial and perfil_atual != perfil_inicial:
            term.trocar(perfil_inicial, esperar=False)


if __name__ == "__main__":
    if "--video" in sys.argv:
        arg = sys.argv[sys.argv.index("--video") + 1]
        mins = float(sys.argv[sys.argv.index("--minutos") + 1]) if "--minutos" in sys.argv else 25.0
        gerar_video(os.path.abspath(os.path.expanduser(arg)), mins)
    elif "--bench" in sys.argv:
        bench()
    else:
        main()
