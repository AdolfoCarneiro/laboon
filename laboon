def mascara(w, h):
    """Ordem em que as células passam pra próxima cena (0..1)."""
    tipo = random.choice(("pontos", "centro", "lado", "chuva", "diagonal"))
    cx, cy = w / 2, h / 2
    rmax = math.hypot(cx, cy * ASPECTO)
    atraso = [random.random() for _ in range(w)]
    lado = random.choice((False, True))
    out = []
    for y in range(h):
        for x in range(w):
            j = random.random() * 0.12
            if tipo == "pontos":
                v = random.random()
            elif tipo == "centro":
                v = math.hypot(x - cx, (y - cy) * ASPECTO) / rmax * 0.88 + j
            elif tipo == "lado":
                v = (x / w if lado else 1 - x / w) * 0.88 + j
            elif tipo == "chuva":
                v = (y / h) * 0.6 + atraso[x] * 0.3 + j * 0.5
            else:
                v = ((x / w + y / h) / 2) * 0.88 + j
            out.append(v)
    return out


def render(ch, co, w, h):
    out = ["\x1b[?2026h"]
    ultima = -1
    com_fundo = False
    for y in range(h):
        out.append("\x1b[%d;1H" % (y + 1))
        base = y * w
        for i in range(base, base + w):
            c = ch[i]
            if c == " ":
                if com_fundo:
                    out.append("\x1b[49m")
                    com_fundo = False
                    ultima &= 0xFFFFFF
                out.append(" ")
                continue
            k = co[i]
            if k != ultima:
                # manda só a parte que mudou (frente ou fundo): bem menos bytes nas cenas cheias de cor
                mesma_frente = ultima >= 0 and (ultima & 0xFFFFFF) == (k & 0xFFFFFF)
                if k & BG:
                    bg = (k >> 24) & 0xFFFFFF
                    if com_fundo and ((ultima >> 24) & 0xFFFFFF) == bg:
                        out.append("\x1b[38;2;%d;%d;%dm" % ((k >> 16) & 255, (k >> 8) & 255, k & 255))
                    elif mesma_frente:
                        out.append("\x1b[48;2;%d;%d;%dm" % (bg >> 16, (bg >> 8) & 255, bg & 255))
                    else:
                        out.append("\x1b[38;2;%d;%d;%d;48;2;%d;%d;%dm" % ((k >> 16) & 255, (k >> 8) & 255, k & 255,
                                                                        bg >> 16, (bg >> 8) & 255, bg & 255))
                    com_fundo = True
                elif mesma_frente:
                    out.append("\x1b[49m")
                    com_fundo = False
                else:
                    out.append("\x1b[%s38;2;%d;%d;%dm" % ("49;" if com_fundo else "", k >> 16, (k >> 8) & 255, k & 255))
                    com_fundo = False
                ultima = k
            out.append(c)
    if com_fundo:
        out.append("\x1b[49m")
    out.append("\x1b[?2026l")
    return "".join(out)


def perfil_konsole(nome=None):
    """Lê (nome=None) ou troca o perfil da sessão do Konsole onde o screensaver está rodando."""
    svc, sess = os.environ.get("KONSOLE_DBUS_SERVICE"), os.environ.get("KONSOLE_DBUS_SESSION")
    if not svc or not sess:
        return None
    metodo = ["org.kde.konsole.Session.profile"] if nome is None else ["org.kde.konsole.Session.setProfile", nome]
    try:
        r = subprocess.run(["gdbus", "call", "--session", "--dest", svc, "--object-path", sess, "--method"] + metodo,
                           capture_output=True, text=True, timeout=2)
    except Exception:
        return None
    if nome is None:
        achado = r.stdout.strip().split("'")
        return achado[1] if len(achado) > 1 and achado[1] else None
    # o Konsole aplica a troca mas responde "AccessDenied" (API sensível desligada); quem confirma é o tamanho
    return True


def perfil_padrao_konsole():
    try:
        with open(os.path.expanduser("~/.config/konsolerc")) as f:
            for linha in f:
                if linha.startswith("DefaultProfile="):
                    return linha.split("=", 1)[1].strip().removesuffix(".profile") or None
    except OSError:
        pass
    return None


# ------------------------------------------------ fonte do terminal (cena de Pokémon)
# A cena de Pokémon roda na resolução do GBA: precisa de uma grade de pelo menos 240x80 células
# (240x160 "pixels" em meio-bloco). Cada terminal tem (ou não) um jeito de diminuir a fonte com o programa
# rodando. Quem não tem só mostra a cena se o terminal já for grande o bastante (senão ela é pulada).

MIN_COLUNAS, MIN_LINHAS = 240, 80


def esperar_tamanho(antes, limite=1.5):
    """Espera o terminal mudar de tamanho (depois de trocar a fonte). Devolve o tamanho novo."""
    fim_ = time.monotonic() + limite
    while time.monotonic() < fim_ and os.get_terminal_size() == antes:
        time.sleep(0.05)
    time.sleep(0.1)
    return os.get_terminal_size()


class Terminal:
    """Terminal que não sabe trocar a fonte (foot, ghostty, wezterm…): inicial=None desliga a troca."""
    nome = "outro"
    inicial = None

    def trocar(self, perfil, esperar=True):
        return False


class TermKonsole(Terminal):
    """Konsole: troca o perfil da sessão via D-Bus (o LaboonMini tem fonte 8)."""
    nome = "konsole"

    def __init__(self):
        self.inicial = os.environ.get("LABOON_PERFIL") or perfil_konsole() or perfil_padrao_konsole()

    def trocar(self, perfil, esperar=True):
        antes = os.get_terminal_size()
        if not perfil_konsole(perfil):
            return False
        if esperar:
            esperar_tamanho(antes)
        return True


class TermFonte(Terminal):
    """Terminais que mudam o tamanho da fonte por comando (kitty, Alacritty). O perfil "normal" é o tamanho
    original (LABOON_FONTE, que o laboon-iniciar passa); qualquer outro perfil é "fonte pequena"."""
    inicial = "normal"
    PADRAO = 11.0   # se ninguém disse qual é o tamanho original
    MENOR = 4.0

    def __init__(self):
        try:
            self.original = float(os.environ.get("LABOON_FONTE") or self.PADRAO)
        except ValueError:
            self.original = self.PADRAO
        self.atual = self.original

    def comando(self, pt):
        raise NotImplementedError

    def aplicar(self, pt):
        try:
            r = subprocess.run(self.comando(pt), stdin=subprocess.DEVNULL, capture_output=True, timeout=2)
        except Exception:
            return False
        if r.returncode != 0:
            return False
        self.atual = pt
        return True

    def trocar(self, perfil, esperar=True):
        antes = os.get_terminal_size()
        if perfil == self.inicial:
            if not self.aplicar(self.original):
                return False
            if esperar:
                esperar_tamanho(antes)
            return True
        # fonte pequena: estima o tamanho que dá 240x80 células, mede e vai descendo até caber
        tam, pt, mudou = antes, self.atual, False
        for _ in range(6):
            fator = min(tam.columns / MIN_COLUNAS, tam.lines / MIN_LINHAS)
            if fator >= 1:
                break
            novo = math.floor(pt * fator * 2) / 2   # de meio em meio ponto
            if novo >= pt:
                novo = pt - 0.5
            if novo < self.MENOR or not self.aplicar(novo):
                break
            mudou = True
            antigo, tam, pt = tam, esperar_tamanho(tam), novo
            if tam == antigo:   # o terminal ignorou: não adianta insistir
                break
        return mudou or (tam.columns >= MIN_COLUNAS and tam.lines >= MIN_LINHAS)


class TermKitty(TermFonte):
    """kitty: `kitty @ set-font-size` (precisa de allow_remote_control; o laboon-iniciar já liga)."""
    nome = "kitty"

    def comando(self, pt):
        alvo = os.environ.get("KITTY_LISTEN_ON")
        return ["kitty", "@"] + (["--to", alvo] if alvo else []) + ["set-font-size", "--", "%.1f" % pt]

    def aplicar(self, pt):
        ok = super().aplicar(pt)
        if not os.environ.get("KITTY_LISTEN_ON"):
            # sem socket o `kitty @` conversa pelo próprio tty: joga fora qualquer resposta que sobrar na entrada
            try:
                termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
            except Exception:
                pass
        return ok


class TermAlacritty(TermFonte):
    """Alacritty >= 0.13: `alacritty msg config font.size=N` pelo socket de IPC."""
    nome = "alacritty"
    PADRAO = 11.25

    def comando(self, pt):
        return ["alacritty", "msg", "--socket", os.environ["ALACRITTY_SOCKET"], "config", "font.size=%.1f" % pt]


def terminal_atual():
    """Descobre em qual terminal o screensaver está rodando pelas variáveis que cada um põe no ambiente."""
    if os.environ.get("KONSOLE_DBUS_SESSION") and os.environ.get("KONSOLE_DBUS_SERVICE"):
        return TermKonsole()
    if os.environ.get("KITTY_LISTEN_ON") or os.environ.get("KITTY_WINDOW_ID"):
        return TermKitty()
    if os.environ.get("ALACRITTY_SOCKET"):
        return TermAlacritty()
    return Terminal()


# programas de tela de bloqueio (Hyprland, Sway…): se algum estiver rodando, a tela está bloqueada
TRAVAS = {"hyprlock", "swaylock", "gtklock", "waylock"}


def trava_rodando():
    try:
        pids = os.listdir("/proc")
    except OSError:
        return False
    for pid in pids:
        if pid.isdigit():
            try:
                with open("/proc/%s/comm" % pid) as f:
                    if f.read().strip() in TRAVAS:
                        return True
            except OSError:
                pass
    return False


def tela_bloqueada():
    if trava_rodando():
        return True
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return False   # no Hyprland não tem org.freedesktop.ScreenSaver; o hyprlock já foi conferido acima
    try:
        r = subprocess.run(["busctl", "--user", "call", "org.freedesktop.ScreenSaver", "/ScreenSaver",
                            "org.freedesktop.ScreenSaver", "GetActive"], capture_output=True, text=True, timeout=1)
        return "true" in r.stdout
    except Exception:
        return False


