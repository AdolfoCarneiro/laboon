[Unit]
Description=Gera o vídeo do screensaver pra tela de bloqueio

[Service]
Type=oneshot
TimeoutStartSec=3h
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
# o libx264 em 1080p segura frames em memória; sem teto passava de 1 GB
MemoryHigh=600M
ExecStart=%h/.local/bin/laboon --video %h/.local/share/laboon/bloqueio.mp4 --minutos 25
