[Unit]
Description=Screensaver ASCII num terminal em tela cheia quando o PC fica ocioso
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/swayidle -w timeout 150 %h/.local/bin/laboon-iniciar resume %h/.local/bin/laboon-parar
Restart=on-failure

[Install]
WantedBy=graphical-session.target
